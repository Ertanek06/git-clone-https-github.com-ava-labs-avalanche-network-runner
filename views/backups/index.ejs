<% layout('layout') -%>
<%
 const en=locale==='en';
 const fmtDate=value=>value?new Date(Number(value)).toLocaleString(en?'en-GB':'tr-TR'):'—';
 const fmtSize=value=>{const n=Number(value||0);if(n>=1073741824)return `${(n/1073741824).toFixed(2)} GB`;if(n>=1048576)return `${(n/1048576).toFixed(2)} MB`;return `${Math.max(0,n/1024).toFixed(1)} KB`};
 const scopeLabels=en?{profiles:'Company profiles',products:'Products',customers:'Customers and contacts',quotes:'Proformas and line items',templates:'Proforma templates'}:{profiles:'Firma profilleri',products:'Ürünler',customers:'Müşteriler ve yetkililer',quotes:'Proformalar ve satırlar',templates:'Proforma şablonları'};
 const L=en?{eyebrow:'DATA BACKUP',title:'Company Data Export and Restore',desc:'Download selected company business records and safely merge the verified JSON later. Automatic physical server backup, including uploaded files, is maintained separately.',count:'Downloaded backups',size:'Total downloaded',restore:'Restore operations',latest:'Latest backup',export:'Create and download backup',exportHelp:'JSON is the verified business-data restore format. Excel is intended for reporting; the automatic full-system backup also protects uploaded files.',sections:'Data sections',json:'Download JSON backup',xlsx:'Download Excel report',restoreTitle:'Restore and merge JSON backup',restoreHelp:'The file is verified first. Selected sections are merged in one database transaction; if the operation fails, no partial data is committed.',file:'ARTEVA JSON backup file',restoreBtn:'Verify and restore',history:'Operation history',empty:'No backup operation yet.',created:'Date',type:'Type',status:'Status',note:'Summary',hash:'SHA-256'}:{eyebrow:'VERİ YEDEKLEME',title:'Firma İş Verisi Yedekleme ve Geri Yükleme',desc:'Seçili firma iş kayıtlarını indirin ve doğrulanmış JSON dosyasını mevcut kayıtları silmeden geri birleştirin. Yüklenen dosyaları da kapsayan otomatik fiziksel sunucu yedeği ayrı çalışır.',count:'İndirilen yedek',size:'Toplam indirilen',restore:'Geri yükleme işlemi',latest:'Son yedek',export:'Yedek oluştur ve indir',exportHelp:'JSON doğrulanmış iş verisi geri yükleme formatıdır. Excel raporlama içindir; otomatik tam sistem yedeği yüklenen dosyaları da korur.',sections:'Veri bölümleri',json:'JSON yedeğini indir',xlsx:'Excel raporunu indir',restoreTitle:'JSON yedeğini geri yükle ve birleştir',restoreHelp:'Dosya önce doğrulanır. Seçilen bölümler tek bir veritabanı işlemi içinde birleştirilir; hata olursa kısmi kayıt bırakılmaz.',file:'ARTEVA JSON yedek dosyası',restoreBtn:'Doğrula ve geri yükle',history:'İşlem geçmişi',empty:'Henüz yedekleme işlemi yok.',created:'Tarih',type:'Tür',status:'Durum',note:'Özet',hash:'SHA-256'};
%>
<header class="page-head pro-headline"><div><span class="eyebrow">💾 <%=L.eyebrow%></span><h1><%=L.title%></h1><p><%=L.desc%></p></div></header>
<section class="backup-summary-grid" aria-label="<%=L.title%>">
 <article class="card backup-summary"><span>✅</span><div><small><%=L.count%></small><b><%=summary.count%></b></div></article>
 <article class="card backup-summary"><span>🗂️</span><div><small><%=L.size%></small><b><%=fmtSize(summary.totalSize)%></b></div></article>
 <article class="card backup-summary"><span>♻️</span><div><small><%=L.restore%></small><b><%=summary.restoreCount%></b></div></article>
 <article class="card backup-summary"><span>🕒</span><div><small><%=L.latest%></small><b><%=summary.latest?fmtDate(summary.latest.created_at):(en?'None yet':'Henüz yok')%></b></div></article>
</section>
<section class="backup-action-grid backup-action-grid--data">
 <article class="card backup-action-card"><div class="card-head"><h2>⬇️ <%=L.export%></h2></div><p class="muted"><%=L.exportHelp%></p>
  <form method="post" action="/backups/export" class="stack backup-data-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><fieldset class="backup-scope-fieldset"><legend><%=L.sections%></legend><% Object.entries(backupScopes).forEach(([key,item])=>{ %><label><input type="checkbox" name="scopes" value="<%=key%>" checked><span><%=scopeLabels[key]||item.label%></span></label><% }) %></fieldset><div class="backup-format-actions"><button class="btn btn--primary" type="submit" name="format" value="json">🛡️ <%=L.json%></button><button class="btn btn--soft" type="submit" name="format" value="xlsx">📊 <%=L.xlsx%></button></div></form>
 </article>
 <article class="card backup-action-card"><div class="card-head"><h2>♻️ <%=L.restoreTitle%></h2></div><p class="muted"><%=L.restoreHelp%></p>
  <form method="post" enctype="multipart/form-data" action="/backups/restore?_csrf=<%=encodeURIComponent(csrfToken)%>" class="stack backup-data-form" data-confirm="<%=en?'Merge selected backup sections now? Existing records will not be deleted.':'Seçilen yedek bölümleri şimdi birleştirilsin mi? Mevcut kayıtlar silinmeyecektir.'%>"><label><%=L.file%><input required type="file" name="backup_file" accept=".json,application/json"></label><fieldset class="backup-scope-fieldset"><legend><%=L.sections%></legend><% Object.entries(backupScopes).forEach(([key,item])=>{ %><label><input type="checkbox" name="scopes" value="<%=key%>" checked><span><%=scopeLabels[key]||item.label%></span></label><% }) %></fieldset><button type="submit" class="btn btn--soft">♻️ <%=L.restoreBtn%></button></form>
 </article>
</section>
<section class="card backup-list-card"><div class="card-head"><h2>📚 <%=L.history%></h2><small><%=rows.length%></small></div><% if(!rows.length){ %><div class="empty"><%=L.empty%></div><% } else { %><div class="table-scroll"><table class="lined backup-table backup-data-history"><thead><tr><th><%=L.created%></th><th><%=L.type%></th><th><%=L.status%></th><th><%=L.note%></th><th><%=L.hash%></th><th><%=L.size%></th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%=fmtDate(row.created_at)%></td><td><b><%=row.backup_scope%></b><small class="backup-file-name"><%=row.file_name%></small></td><td><span class="tag <%=String(row.status).includes('WARNING')?'tag--warning':'tag--success'%>"><%=row.status%></span></td><td class="backup-note"><%=row.note||'—'%></td><td><small class="backup-hash" title="<%=row.sha256||''%>"><%=row.sha256?row.sha256.slice(0,20)+'…':'—'%></small></td><td><%=fmtSize(row.size_bytes)%></td></tr><% }) %></tbody></table></div><% } %></section>
