<% layout('layout') -%>
<% const contactRows=(row.contacts&&row.contacts.length?row.contacts:[{}, {}, {}]); %>
<header class="page-head"><div><h1><%=title%></h1></div><a class="btn" href="/customers">← Listeye Dön</a></header>
<% if(typeof error!=='undefined'&&error){ %><div class="form-error"><%=error%><% if(typeof duplicate!=='undefined'){ %> <a href="/customers/<%=duplicate.id%>/edit">Mevcut kaydı aç</a><% } %></div><% } %>
<form class="customer-form card entity-form entity-form--compact pro-entity-v58" method="post" action="/customers/save?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data">
<input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="id" value="<%=row.id||''%>">
<div class="form-section form-section--compact"><h2>🏢 Firma Bilgileri</h2><div class="form-grid">
<label>Firma unvanı<input required name="company_name" value="<%=row.company_name||''%>"></label><label>Müşteri kısa adı<input name="short_name" value="<%=row.short_name||''%>"></label><label>Yetkili kişi<input name="contact_name" value="<%=row.contact_name||''%>"></label><label>Görevi<input name="contact_title" value="<%=row.contact_title||''%>"></label><label>Telefon<input name="phone" value="<%=row.phone||''%>"></label><label>Cep telefonu<input name="mobile" value="<%=row.mobile||''%>"></label><label>E-posta<input type="email" name="email" value="<%=row.email||''%>"></label><label>Web sitesi<input name="website" value="<%=row.website||''%>"></label>
</div></div>
<div class="form-section form-section--compact" data-address-scope><h2>📍 Adres ve Vergi</h2><div class="form-grid">
<label>Vergi dairesi<input name="tax_office" value="<%=row.tax_office||''%>"></label><label>Vergi no / TC<input name="tax_no" value="<%=row.tax_no||''%>"></label><label>Ülke<input data-tr-country name="country" value="<%=row.country||'Türkiye'%>"></label><label>Şehir<input data-tr-city name="city" value="<%=row.city||''%>"></label><label>İlçe<input data-tr-district name="district" value="<%=row.district||''%>"></label><label>Posta kodu<input name="postal_code" value="<%=row.postal_code||''%>"></label><label class="wide">Fatura Adresi<textarea data-auto-grow name="billing_address"><%=row.billing_address||[row.address1,row.address2].filter(Boolean).join(' ')%></textarea></label><label class="wide">Teslimat Adresi<textarea data-auto-grow name="delivery_address"><%=row.delivery_address||''%></textarea></label>
</div></div>
<div class="form-section form-section--compact"><h2>💼 Ticari Bilgiler</h2><div class="form-grid">
<label>Sektör<input name="sector" value="<%=row.sector||''%>"></label><label>Para birimi<select name="currency"><% ['TRY','EUR','USD'].forEach(x=>{ %><option <%=row.currency===x?'selected':''%>><%=x%></option><% }) %></select></label><label>Varsayılan ödeme yöntemi<input name="payment_method" value="<%=row.payment_method||''%>"></label><label>Durum<select name="status"><option>ACTIVE</option><option <%=row.status==='PASSIVE'?'selected':''%>>PASSIVE</option></select></label>
<label class="asset-upload customer-logo-upload">Logo<input type="file" accept="image/*" name="logo" data-preview-file="customerLogoPreview"><span class="asset-preview"><% if(row.logo_url){ %><img id="customerLogoPreview" src="<%=row.logo_url%>" alt="Müşteri logosu"><% }else{ %><img id="customerLogoPreview" alt="Müşteri logosu" hidden><em>Yüklü görsel yok</em><% } %></span></label>
</div></div>
<details class="form-section form-section--compact collapsible-section customer-extra-contacts"><summary><span>Ek Yetkililer</span><small>Satın alma, muhasebe, teknik veya teklif yetkilisi gerekiyorsa açın.</small></summary><p class="muted">Bu alan kapalı gelir; ihtiyaç olduğunda ek kişi bilgileri tutulur ve müşteri kartında görüntülenir.</p><div class="contact-mini-grid">
<% contactRows.forEach((c,i)=>{ %><div class="contact-mini-card"><input type="hidden" name="contact_id[]" value="<%=c.id||''%>"><strong>Yetkili <%=i+1%></strong><label>Ad Soyad<input name="contact_full_name[]" value="<%=c.full_name||''%>"></label><label>Görev<input name="contact_extra_title[]" value="<%=c.title||''%>"></label><label>Rol<select name="contact_role[]"><% ['GENEL','SATIN ALMA','MUHASEBE','TEKNIK','TEKLIF'].forEach(r=>{ %><option <%=String(c.role_key||'').toLocaleUpperCase('tr-TR')===r?'selected':''%>><%=r%></option><% }) %></select></label><label>Telefon<input name="contact_extra_phone[]" value="<%=c.phone||''%>"></label><label>Cep<input name="contact_extra_mobile[]" value="<%=c.mobile||''%>"></label><label>E-posta<input type="email" name="contact_extra_email[]" value="<%=c.email||''%>"></label><label>Not<input name="contact_note[]" value="<%=c.note||''%>"></label></div><% }) %>
</div></details>
<div class="form-section form-section--compact"><h2>📝 Not</h2><div class="form-grid"><label class="wide">Müşteri notu<textarea data-auto-grow name="note"><%=row.note||''%></textarea></label></div></div><div class="form-actions"><button class="btn btn--primary">Müşteri Kartını Kaydet</button></div></form>
