<% layout('layout') -%>
<% const canCreate=can('customers','create'),canEdit=can('customers','edit'),canArchive=can('customers','archive'),canExport=can('customers','export'),canImport=canCreate&&canEdit; const customerActionCount=1+(canEdit?1:0); %>
<header class="page-head list-page-head"><div><h1>Müşteri Listesi</h1></div><% if(canCreate){ %><a class="btn btn--primary page-head__primary-action btn--alive" href="/customers/new"><span class="btn__icon btn__icon--live" aria-hidden="true">＋</span> Yeni Müşteri</a><% } %></header>
<section class="card workspace-toolbar workspace-toolbar--customers" aria-label="Müşteri listesi araçları">
 <div class="workspace-toolbar__row workspace-toolbar__row--main">
  <form class="toolbar-search-form" method="get">
   <span class="toolbar-search-pair"><label class="toolbar-input toolbar-input--search" title="Müşteri ara"><span class="toolbar-input__icon list-live-icon" aria-hidden="true">⌕</span><input name="q" value="<%=q%>" aria-label="Müşteri ara" placeholder="Ara: müşteri no/kod, ünvan, yetkili, şehir, e-posta, telefon, vergi no"></label><button class="btn btn--primary toolbar-btn toolbar-btn--search" type="submit" title="Ara">Ara</button></span>
   <a class="btn toolbar-btn btn--ghost" href="/customers" title="Arama ve filtreleri temizle"><span aria-hidden="true">×</span> Temizle</a>
   <label class="toolbar-input toolbar-input--sort" title="Sıralama"><span class="toolbar-input__icon list-live-icon" aria-hidden="true">⇅</span><select name="sort" aria-label="Müşteri sıralaması" data-list-sort-autosubmit><option value="recent" <%=sort==='recent'?'selected':''%>>Son Eklenen</option><option value="alpha" <%=sort==='alpha'?'selected':''%>>Alfabetik A–Z</option></select></label>
   <label class="toolbar-input toolbar-input--limit" title="Sayfa başına kayıt"><span class="toolbar-input__icon" aria-hidden="true">☷</span><select name="limit" aria-label="Sayfa başına kayıt" data-list-sort-autosubmit><% [10,30,50,100].forEach(x=>{ %><option value="<%=x%>" <%=x===limit?'selected':''%>><%=x%></option><% }) %></select></label>
  </form>
  <span class="toolbar-total" title="Toplam müşteri sayısı">Toplam <b><%=total%></b></span>
 </div>
 <div class="workspace-toolbar__row workspace-toolbar__row--secondary">
  <% if(canExport||canImport){ %><div class="excel-action-cluster" aria-label="Excel işlemleri"><% if(canExport){ %><a class="btn toolbar-btn btn--soft" href="/customers/export.xls">↓ Excel Dışa Aktar</a><a class="btn toolbar-btn btn--soft" href="/customers/import-template.xls">↓ Şablon İndir</a><% } %><% if(canImport){ %><details class="import-pop toolbar-import"><summary class="btn toolbar-btn btn--soft">↑ Excel İçe Aktar</summary><div class="import-pop__body"><form method="post" action="/customers/import-excel?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><small>.xlsx, XML .xls ve CSV desteklenir.</small><input required type="file" name="excel" accept=".xlsx,.xls,.csv"><button class="btn btn--primary" type="submit">Dosyayı Yükle</button></form></div></details><% } %></div><% } %><div class="toolbar-bulk-group">
   <label class="toolbar-select-all"><input type="checkbox" data-check-all data-target-form="customerBulkForm"><span>Tümünü Seç</span></label>
   <span class="toolbar-selected">Seçili: <b data-selection-count="customerBulkForm">0</b></span>
   <% if(canArchive){ %><button class="btn btn--danger toolbar-btn toolbar-btn--compact" type="submit" form="customerBulkForm" formaction="/customers/bulk-delete" data-requires-selection="customerBulkForm" data-confirm='Seçili müşteriler arşivlensin mi?'><span aria-hidden="true">🗑</span> Seçilileri Arşivle</button><% } %>
  </div>
 </div>
</section>
<form id="customerBulkForm" method="post"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><section class="card table-scroll list-table-card"><table class="lined customer-table pro-table" data-table-preferences="customers" data-mobile-cards><colgroup><col class="col-check"><col class="col-code"><col class="col-company"><col class="col-contact"><col class="col-phone"><col class="col-email"><col class="col-city"><col class="col-tax"><col class="col-quotes"><col class="col-actions actions-col--<%=customerActionCount%>"></colgroup><thead><tr><th><input type="checkbox" data-check-all data-target-form="customerBulkForm" aria-label="Tüm müşterileri seç"></th><th>Kod</th><th>Firma</th><th>Yetkili</th><th>Telefon</th><th>E-posta</th><th>Şehir</th><th>Vergi No</th><th>Proforma</th><th class="actions-col actions-col--<%=customerActionCount%>">İşlemler</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="10" class="empty">Arama ölçütlerine uygun müşteri bulunamadı.</td></tr><% } %><% rows.forEach(c=>{ %><tr class="previewable-list-row" tabindex="0" role="button" aria-label="<%=c.company_name%> müşterisini ön izle" title="Satıra tıklayarak müşteri ön izlemesini aç" data-preview-title="Müşteri Ön İzleme" data-preview-url="/customers/<%=c.id%>/preview"<% if(canEdit){ %> data-preview-edit="/customers/<%=c.id%>/edit"<% } %>><td><input type="checkbox" name="ids" value="<%=c.id%>" aria-label="<%=c.company_name%> müşterisini seç"></td><td><%=c.code%></td><td><button type="button" class="link-btn customer-name-link" data-preview-title="Müşteri Ön İzleme" data-preview-url="/customers/<%=c.id%>/preview"<% if(canEdit){ %> data-preview-edit="/customers/<%=c.id%>/edit"<% } %>><b><%=c.company_name%></b></button></td><td><%=c.contact_name||'-'%></td><td><%=c.phone||c.mobile||'-'%></td><td><%=c.email||'-'%></td><td><%=c.city||'-'%></td><td><%=c.tax_no||'-'%></td><td><button type="button" class="quote-count-badge <%=Number(c.quote_count||0)>0?'has-quotes':'is-empty'%>" data-preview-title="Müşteri ve Proformaları" data-preview-url="/customers/<%=c.id%>/preview"<% if(canEdit){ %> data-preview-edit="/customers/<%=c.id%>/edit"<% } %> title="Müşteriye ait proformaları görüntüle"><span><%=Number(c.quote_count||0)%></span><small>Proforma</small></button></td><td class="actions-cell actions-cell--<%=customerActionCount%>"><div class="table-action-list"><button class="table-action is-preview" type="button" data-label="Ön İzleme" title="Ön İzleme" data-preview-title="Müşteri Ön İzleme" data-preview-url="/customers/<%=c.id%>/preview"<% if(canEdit){ %> data-preview-edit="/customers/<%=c.id%>/edit"<% } %> aria-label="<%=c.company_name%> müşterisini ön izle"><%- include('../partials/table-action-icon',{iconName:'preview'}) %></button><% if(canEdit){ %><a class="table-action is-edit" href="/customers/<%=c.id%>/edit" data-label="Düzenle" title="Düzenle" aria-label="<%=c.company_name%> müşterisini düzenle"><%- include('../partials/table-action-icon',{iconName:'edit'}) %></a><% } %><% if(canArchive){ %><button class="table-action is-mobile-delete mobile-list-only" type="submit" name="ids" value="<%=c.id%>" formaction="/customers/bulk-delete" formmethod="post" data-no-row-preview data-label="Sil" title="Sil (arşivle)" aria-label="<%=c.company_name%> müşterisini sil" data-confirm='Bu müşteri arşivlensin mi?'><%- include('../partials/table-action-icon',{iconName:'delete'}) %></button><% } %></div></td></tr><% }) %></tbody></table></section></form>
<%- include('../partials/pager',{q,page,limit,total,sort,showAll:typeof showAll!=='undefined'&&showAll}) %>
