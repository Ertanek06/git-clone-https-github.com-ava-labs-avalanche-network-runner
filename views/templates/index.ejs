   <label><span>Banka alanı</span><select name="bank_variant" id="tplBankVariant"><option value="table">Tablo</option><option value="band">Yatay Bant</option><option value="compact">Kompakt</option><option value="cards">Hesap Kartları</option><option value="ledger">Dekont Düzeni</option><option value="inline">Satır İçi Bilgiler</option></select></label>
