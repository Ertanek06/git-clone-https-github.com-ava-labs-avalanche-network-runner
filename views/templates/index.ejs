   <% rows.forEach((tpl,i)=>{ const originLabel=tpl.template_origin==='legacy-v112'?'ESKİ CRMV1.12':(tpl.template_origin==='reference'?'PDF ORİJİNAL':'YENİ'); %><button type="button" class="template-choice-v370 <%=i===0?'is-active':''%>" data-template-studio-url="/templates/<%=tpl.id%>/preview" data-template-id="<%=tpl.id%>" data-template-name="<%=tpl.name%>" data-template-description="<%=tpl.description||''%>"><span class="template-choice-swatch" data-csp-style="--p:<%=tpl.primary_color%>;--a:<%=tpl.accent_color%>"></span><span><b><%=tpl.name%></b><small><%=tpl.description||'Kurumsal proforma şablonu'%></small><i class="template-origin-badge-v19 template-origin-badge-v19--<%=tpl.template_origin%>"><%=originLabel%></i></span><% if(tpl.is_default){ %><em>AKTİF</em><% } %></button><% }) %>
