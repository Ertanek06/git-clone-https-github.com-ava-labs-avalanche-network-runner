 <details class="template-advanced-code-v16"><summary>Gelişmiş HTML / CSS</summary><label class="checkline"><input type="checkbox" name="use_custom_html" id="tplUseCustomHtml" value="1"> Standart yapının yerine özel HTML kullan</label><div class="template-code-grid"><label><span>HTML</span><textarea name="custom_html" id="tplHtml" class="code-editor" spellcheck="false"></textarea></label><label><span>CSS</span><textarea name="custom_css" id="tplCss" class="code-editor" spellcheck="false"></textarea></label></div></details><section class="template-code-preview"><div class="card-head"><div><h2>Taslak Örnek Proforma</h2><small>İki A4 sayfa yan yana gösterilir; renk, logo, yazı ve yapısal seçimler kaydetmeden anında uygulanır.</small></div><button class="btn btn--sm" type="button" data-template-preview-zoom>Ön İzlemeyi Büyüt</button></div><iframe id="tplPreviewFrame" sandbox="allow-scripts allow-same-origin"></iframe></section><footer class="template-code-modal__actions"><button class="btn btn--soft" type="button" data-template-reset>↺ Değişiklikleri Sıfırla</button><button class="btn" type="button" data-template-modal-close>Vazgeç</button><button class="btn btn--primary" type="submit">💾 Şablonu Kaydet</button></footer></form></div></div>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">
(()=>{
 const frame=document.getElementById('templateStudioFrame'),title=document.getElementById('templateStudioTitle'),desc=document.getElementById('templateStudioDescription'),open=document.getElementById('templateStudioOpen'),edit=document.getElementById('templateStudioEdit'),exp=document.getElementById('templateStudioExport'),clone=document.getElementById('templateStudioCloneForm'),def=document.getElementById('templateStudioDefaultForm'),del=document.getElementById('templateStudioDeleteForm'),stage=document.querySelector('.template-live-stage-v370'),search=document.querySelector('[data-template-search]');
 function select(choice){document.querySelectorAll('.template-choice-v370').forEach(x=>x.classList.toggle('is-active',x===choice));const url=choice.dataset.templateStudioUrl,id=choice.dataset.templateId;frame.src=url+'?studio=1';title.textContent=choice.dataset.templateName||'Şablon Ön İzleme';desc.textContent=choice.dataset.templateDescription||'Gerçek örnek proforma ön izlemesi';open.href=url;if(edit)edit.href='/templates/'+id+'/edit';if(exp)exp.href='/templates/'+id+'/export';if(clone)clone.action='/templates/'+id+'/clone';if(def)def.action='/templates/'+id+'/default';if(del)del.action='/templates/'+id+'/delete'}
 document.addEventListener('click',e=>{const choice=e.target.closest('[data-template-studio-url]');if(choice){select(choice);return}const device=e.target.closest('[data-template-device]');if(device){document.querySelectorAll('[data-template-device]').forEach(x=>x.classList.toggle('is-active',x===device));stage.dataset.device=device.dataset.templateDevice}});
 search?.addEventListener('input',()=>{const q=search.value.toLocaleLowerCase('tr-TR').trim();document.querySelectorAll('.template-choice-v370').forEach(x=>x.hidden=q&&!String(x.textContent||'').toLocaleLowerCase('tr-TR').includes(q))});
 const file=document.querySelector('[data-template-import-file]'),form=document.querySelector('[data-template-import-form]');file?.addEventListener('change',async()=>{const f=file.files?.[0],area=form?.querySelector('textarea'),btn=form?.querySelector('button[type=submit]');if(!f||!area)return;try{area.value=await f.text();JSON.parse(area.value);btn.disabled=false}catch{area.value='';btn.disabled=true;alert('Şablon dosyası geçerli JSON değil.')}});
})();
</script>
