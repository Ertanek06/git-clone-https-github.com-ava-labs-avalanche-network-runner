  </div>
  <details class="template-logo-advanced-v21" open><summary>Gelişmiş Logo Yerleşimi</summary><p>Taslakta <b>LOGO</b> alanı daima görünür. Gerçek firma logosu varsa o kullanılır; yoksa yer tutucu logo ile konum gösterilir.</p><div class="template-logo-grid-v21"><label><span>Logo genişliği</span><input type="range" name="logo_width_mm" id="tplLogoWidth" min="18" max="64" step="1" value="34"><output id="tplLogoWidthOutput">34 mm</output></label><label><span>Logo yüksekliği</span><input type="range" name="logo_height_mm" id="tplLogoHeight" min="8" max="30" step="1" value="15"><output id="tplLogoHeightOutput">15 mm</output></label><label><span>Yatay konum kaydırma</span><input type="range" name="logo_offset_x_mm" id="tplLogoOffsetX" min="-35" max="35" step="1" value="0"><output id="tplLogoOffsetXOutput">0 mm</output></label><label><span>Dikey konum kaydırma</span><input type="range" name="logo_offset_y_mm" id="tplLogoOffsetY" min="-18" max="24" step="1" value="0"><output id="tplLogoOffsetYOutput">0 mm</output></label></div></details>
  <% const templatePaletteFields=[
    ['page_bg_color','Sayfa zemini','#ffffff'],['body_text_color','Genel yazı','#111827'],['muted_text_color','İkincil / açıklama yazısı','#64748b'],['border_color','Genel çerçeve / çizgi','#cbd5e1'],
    ['company_bg_color','Firma alanı zemini','#ffffff'],['company_text_color','Firma alanı yazısı','#111827'],['meta_bg_color','Belge / seri alanı zemini','#ffffff'],['meta_text_color','Belge / seri alanı yazısı','#111827'],
    ['title_bg_color','Proforma başlığı zemini','#ffffff'],['title_text_color','Proforma başlığı yazısı','#245ba7'],['customer_bg_color','Müşteri alanı zemini','#ffffff'],['customer_text_color','Müşteri alanı yazısı','#111827'],
    ['table_header_bg_color','Ürün tablosu başlık zemini','#245ba7'],['table_header_text_color','Ürün tablosu başlık yazısı','#ffffff'],['table_row_bg_color','Ürün satırı zemini','#ffffff'],['table_alt_bg_color','Alternatif ürün satırı zemini','#f8fafc'],['table_text_color','Ürün tablosu yazısı','#111827'],['link_color','Broşür / bağlantı rengi','#245ba7'],
    ['totals_bg_color','Fiyat / toplam alanı zemini','#ffffff'],['totals_text_color','Fiyat / toplam yazısı','#111827'],['grand_total_bg_color','Genel toplam zemini','#eff6ff'],['grand_total_text_color','Genel toplam yazısı','#17345d'],['discount_color','İndirim rengi','#f05252'],
    ['terms_bg_color','Teslimat / ödeme / garanti zemini','#ffffff'],['terms_header_bg_color','Koşullar başlık zemini','#245ba7'],['terms_header_text_color','Koşullar başlık yazısı','#ffffff'],['terms_text_color','Koşullar yazısı','#111827'],
    ['bank_bg_color','Banka alanı zemini','#ffffff'],['bank_header_bg_color','Banka başlık zemini','#245ba7'],['bank_header_text_color','Banka başlık yazısı','#ffffff'],['bank_text_color','Banka alanı yazısı','#111827'],
    ['signature_bg_color','İmza / kaşe zemini','#ffffff'],['signature_text_color','İmza / kaşe yazısı','#111827'],['footer_bg_color','Alt bilgi zemini','#ffffff'],['footer_text_color','Alt bilgi yazısı','#475569']
  ]; %>
  <details class="template-color-advanced-v25" open>
    <summary>Gelişmiş Renk Yönetimi · Tüm Alanlar Ayrı Ayrı</summary>
    <div class="template-color-advanced-v25__head">
      <div><b>Proformadaki bütün ana renk alanlarını bağımsız değiştirin.</b><p>Ana renk tek merkezden çalışmaya devam eder. Aşağıdaki alanlardan herhangi birini değiştirdiğinizde bağımsız renk modu otomatik açılır ve değişiklik canlı ön izlemede hemen görünür.</p></div>
      <label class="checkline"><input type="checkbox" name="custom_palette_enabled" id="tplCustomPaletteEnabled" value="1"> Renkleri ayrı ayrı özelleştir</label>
    </div>
    <div class="template-color-grid-v25">
      <% templatePaletteFields.forEach(([key,label,defaultColor])=>{ %>
        <label><span><%=label%></span><input type="color" name="<%=key%>" value="<%=defaultColor%>" data-template-section-color data-default-color="<%=defaultColor%>"></label>
      <% }) %>
    </div>
  </details>
  <div class="template-visibility-v16"><label class="checkline"><input type="checkbox" name="show_logo" value="1" id="tplShowLogo" checked> Firma logosu</label><label class="checkline"><input type="checkbox" name="show_images" value="1" id="tplShowImages" checked> Ürün görselleri</label><label class="checkline"><input type="checkbox" name="show_code" value="1" id="tplShowCode" checked> Ürün kodu</label><label class="checkline"><input type="checkbox" name="show_vat" value="1" id="tplShowVat" checked> KDV</label><label class="checkline"><input type="checkbox" name="show_discount" value="1" id="tplShowDiscount" checked> İndirim</label><label class="checkline"><input type="checkbox" name="show_fx" value="1" id="tplShowFx" checked> TL karşılığı</label><label class="checkline"><input type="checkbox" name="show_bank" value="1" id="tplShowBank" checked> Banka alanı</label><label class="checkline"><input type="checkbox" name="show_stamp" value="1" id="tplShowStamp" checked> Kaşe / imza</label><label class="checkline"><input type="checkbox" name="show_customer_approval" value="1" id="tplShowCustomerApproval" checked> Müşteri onayı</label><label class="checkline"><input type="checkbox" name="show_footer" value="1" id="tplShowFooter" checked> Sabit alt bilgi</label></div>
