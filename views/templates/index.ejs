   <label><span>Alt bilgi</span><select name="footer_variant" id="tplFooterVariant"><option value="line">İnce Çizgili</option><option value="band">Renkli Bant</option><option value="split">Bölünmüş Kurumsal</option><option value="minimal">Minimal</option></select></label>
   <label><span>Genel boşluk</span><select name="spacing_variant" id="tplSpacingVariant"><option value="compact">Kompakt</option><option value="balanced">Dengeli</option><option value="spacious">Ferah</option></select></label>
   <label><span>Çerçeve tipi</span><select name="border_style" id="tplBorderStyle"><option value="solid">Net Çizgi</option><option value="soft">Yumuşak Kart</option><option value="none">Çerçevesiz</option><option value="double">Çift Çizgi</option><option value="accent">Vurgu Şeritli</option><option value="dashed">Kesik Çizgili</option></select></label>
   <label><span>Logo konumu</span><select name="logo_position" id="tplLogoPosition"><option value="left">Sol</option><option value="center">Orta</option><option value="right">Sağ</option><option value="floating">Metin Yanında</option></select></label>
