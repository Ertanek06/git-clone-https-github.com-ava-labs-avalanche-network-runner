<% layout('layout') -%>
<% const isAdmin=can('settings','admin'), first=rows?.[0]||null, oldCount=(rows||[]).filter(x=>x.template_origin==='legacy-v112').length, newCount=(rows||[]).filter(x=>x.template_origin==='current').length, referenceCount=(rows||[]).filter(x=>x.template_origin==='reference').length; %>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">window.TEMPLATE_MODAL_BOOT=<%-JSON.stringify({open:!!editRow,mode:editRow?'edit':'create',action:editRow?('/templates/'+editRow.id+'/save'):'/templates/create',starterHtml:starterCustomHtml,starterCss:starterCustomCss,row:editRow||{},settings:editSettings||{}}).replace(/</g,'\u003c')%>;</script>
<header class="page-head template-page-head-v370"><div><span class="eyebrow">🎨 PROFORMA TASARIM STÜDYOSU</span><h1>Proforma Şablonları</h1><p>32 eski crmv1.12 tasarımı + 12 yeni tasarım + TEK260075 PDF orijinali aynı galeride görünür.</p></div><div class="row-actions"><a class="btn" href="/quotes">← Proformalar</a><% if(isAdmin){ %><form method="post" action="/templates/restore-builtins"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn" type="submit">↺ Eski 32 Şablonu Geri Yükle</button></form><button class="btn btn--primary" type="button" id="openTemplateCreate">＋ Şablon Oluştur</button><% } %></div></header>
