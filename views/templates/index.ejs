<div class="template-designer-v370">
 <aside class="card template-designer-list-v370">
  <div class="card-head"><div><h2>Hazır ve Kayıtlı Tasarımlar</h2><small><%=rows.length%> şablon · <%=oldCount%> eski · <%=newCount%> yeni · <%=referenceCount%> PDF orijinal</small></div></div>
