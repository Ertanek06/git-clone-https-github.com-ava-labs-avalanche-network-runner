<% layout('layout') -%>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">window.TEMPLATE_BLOCKS=<%-JSON.stringify(Array.isArray(blocks)?blocks:[]).replace(/</g,'\\u003c')%>;window.TEMPLATE_STUDIO_BOOT=<%-JSON.stringify({layout_key:row.layout_key||'classic',primary_color:row.primary_color||'#245ba7',accent_color:row.accent_color||'#d83238',use_custom_html:!!settings.use_custom_html}).replace(/</g,'\\u003c')%>;</script>
<header class="page-head"><div><h1><%=locale==='en'?'Proforma Design Studio':'Proforma Tasarım Stüdyosu'%></h1></div><div class="row-actions"><a class="btn" href="/templates"><%=t('back')%></a><button class="btn btn--primary" type="button" data-preview-url="/templates/<%=row.id%>/preview" data-preview-title="<%=row.name||'Şablon'%>">👁 <%=t('preview')%></button></div></header>
<form id="templateStudioForm" class="studio-grid studio-grid--pro" method="post" action="/templates/<%=row.id%>/save"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" id="blockOrder" name="block_order_json">
<section class="card template-studio-main"><h2><%=locale==='en'?'Template Settings':'Şablon Ayarları'%></h2><div class="form-grid">
<label><%=locale==='en'?'Name':'Ad'%><input required name="name" value="<%=row.name||''%>"></label><label><%=t('description')%><input name="description" value="<%=row.description||''%>"></label>
<label><%=locale==='en'?'Structural layout':'Yapısal tasarım'%><select name="layout_key" id="layoutKey"><% (allowedLayouts||[]).forEach(function(x){ %><option value="<%=x%>" <%=row.layout_key===x?'selected':''%>><%=({'arteva-classic':'ARTEVA Klasik / Orijinal',classic:'Kurumsal Ana Düzen',executive:'Yönetici / İki Kolon',navy:'Lacivert Blok Düzen',redline:'Kırmızı Çizgili Teklif',graphite:'Grafit Modern',export:'İhracat / FCA',visual:'Görsel Ürün Odaklı',minimal:'Minimal Teklif',technical:'Teknik Laboratuvar',compact:'Kompakt Liste'})[x]||x%></option><% }) %></select></label>
<label><%=t('primary_color')%><input type="color" name="primary_color" value="<%=row.primary_color||'#245ba7'%>"></label><label><%=t('accent_color')%><input type="color" name="accent_color" value="<%=row.accent_color||'#d83238'%>"></label><label><%=locale==='en'?'Table color':'Tablo rengi'%><input type="color" name="table_color" value="<%=settings.table_color||row.primary_color||'#245ba7'%>"></label><label><%=t('font_family')%><select name="font_family">
<% const templateFonts=[['Inter','Inter'],['Arial, Helvetica, sans-serif','Arial'],['Aptos, Arial, sans-serif','Aptos'],['Calibri, Arial, sans-serif','Calibri'],['Segoe UI, Arial, sans-serif','Segoe UI'],['Verdana, Geneva, sans-serif','Verdana'],['Tahoma, Geneva, sans-serif','Tahoma'],['Georgia, Times New Roman, serif','Georgia'],['Times New Roman, Times, serif','Times New Roman']]; const tplFont=String(row.font_family||'Inter'); templateFonts.forEach(([val,label])=>{ %><option value="<%=val%>" <%=tplFont===val||tplFont===label||tplFont.toLowerCase().startsWith(String(label).toLowerCase())?'selected':''%>><%=label%></option><% }) %>
</select></label><label><%=t('font_size')%><input type="number" min="8" max="16" name="font_size" value="<%=row.font_size||11%>"></label><label><%=locale==='en'?'Watermark':'Filigran'%><input name="watermark" value="<%=settings.watermark||''%>"></label><label class="wide"><%=locale==='en'?'Footer':'Alt bilgi'%><textarea name="footer"><%=settings.footer||''%></textarea></label><label class="wide"><%=locale==='en'?'Column widths':'Kolon genişlikleri'%><textarea name="column_widths"><%=settings.column_widths||''%></textarea></label></div>
<h3><%=locale==='en'?'Show / Hide':'Göster / Gizle'%></h3><div class="check-grid">
<% const visibilityOptions=locale==='en'?[['show_logo','Logo'],['show_images','Product images'],['show_code','Product code'],['show_vat','VAT'],['show_discount','Discount'],['show_fx','FX'],['show_bank','Bank'],['show_stamp','Stamp / Signature'],['show_customer_approval','Customer approval']]:[['show_logo','Logo'],['show_images','Ürün görselleri'],['show_code','Ürün kodu'],['show_vat','KDV'],['show_discount','İndirim'],['show_fx','Kur'],['show_bank','Banka'],['show_stamp','Kaşe / İmza'],['show_customer_approval','Müşteri onayı']]; visibilityOptions.forEach(function(opt){ %><label class="check"><input type="checkbox" name="<%=opt[0]%>" <%=settings[opt[0]]!==false?'checked':''%>> <%=opt[1]%></label><% }) %></div>
<details class="html-template-editor" <%=settings.use_custom_html?'open':''%>><summary><span><%=locale==='en'?'Manual HTML / CSS Template':'Manuel HTML / CSS Şablonu'%></span><small><%=locale==='en'?'Optional advanced editor':'İsteğe bağlı gelişmiş düzenleyici'%></small></summary><div class="html-template-editor__body"><label class="check html-mode-check"><input type="checkbox" name="use_custom_html" id="useCustomHtml" <%=settings.use_custom_html?'checked':''%>> <%=locale==='en'?'Use my custom HTML instead of the selected structural template':'Seçili yapısal şablon yerine manuel HTML kodumu kullan'%></label><div class="html-editor-grid"><label><%=locale==='en'?'HTML code':'HTML kodu'%><textarea class="code-editor" name="custom_html" id="customHtml" spellcheck="false"><%=settings.custom_html||starterCustomHtml%></textarea></label><label><%=locale==='en'?'CSS code':'CSS kodu'%><textarea class="code-editor" name="custom_css" id="customCss" spellcheck="false"><%=settings.custom_css||starterCustomCss%></textarea></label></div><div class="token-help"><b><%=locale==='en'?'Available placeholders':'Kullanılabilir alan kodları'%></b><code>{{DISPLAY_NO}}</code><code>{{COMPANY_LOGO}}</code><code>{{COMPANY_NAME}}</code><code>{{CUSTOMER_NAME}}</code><code>{{ITEMS_TABLE}}</code><code>{{TOTALS_TABLE}}</code><code>{{TERMS_BLOCK}}</code><code>{{BANK_BLOCK}}</code><code>{{SIGNATURE_BLOCK}}</code><code>{{FOOTER_BLOCK}}</code></div><p class="muted"><%=locale==='en'?'Unsafe script, iframe and form tags are removed automatically.':'Güvenlik için script, iframe ve form etiketleri otomatik temizlenir.'%></p></div></details>
<div class="form-actions"><button class="btn btn--primary"><%=locale==='en'?'Save Design':'Tasarımı Kaydet'%></button></div></section>
<aside class="studio-aside"><section class="card"><h2><%=locale==='en'?'Live miniature preview':'Canlı küçük ön izleme'%></h2><div id="studioMiniPreview" class="template-mini template-mini--studio layout-<%=row.layout_key||'classic'%>" data-csp-style="--p:<%=row.primary_color||'#245ba7'%>;--a:<%=row.accent_color||'#d83238'%>"><header><i></i><b></b></header><aside></aside><main><strong>PROFORMA</strong><small><%=locale==='en'?'Sample customer':'Örnek müşteri'%></small><span></span><span></span><table><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr></table></main><footer></footer></div><button class="btn btn--soft btn--block" type="button" data-preview-url="/templates/<%=row.id%>/preview" data-preview-title="<%=row.name||'Şablon'%>">👁 <%=locale==='en'?'Open full A4 preview':'Tam A4 ön izlemesini aç'%></button></section><section class="card"><div class="card-head"><h2><%=locale==='en'?'Live HTML preview':'Canlı HTML ön izlemesi'%></h2><button class="btn btn--sm" id="refreshHtmlPreview" type="button">↻ <%=locale==='en'?'Refresh':'Yenile'%></button></div><p class="muted"><%=locale==='en'?'The preview updates while you type.':'Kod yazdıkça ön izleme güncellenir.'%></p><iframe id="htmlLivePreview" class="html-live-preview" sandbox=""></iframe></section><section class="card"><h2><%=locale==='en'?'Block Order':'Blok Sırası'%></h2><p><%=locale==='en'?'Drag and drop to reorder.':'Sürükleyip bırakarak düzenleyin.'%></p><div id="blockList" class="block-list"></div></section></aside></form>
