<% layout('layout') -%>
<% const av=['🐭','🍎','🐯','🍕','☂️','🧪','🔬','🦊','🍉','🌲','🧿','🚀']; const avatarFor=v=>v.avatar_emoji||av[Math.abs(String(v.visitor_token||'').split('').reduce((a,c)=>a+c.charCodeAt(0),0))%av.length]; const nameFor=v=>v.contact_name||v.visitor_label||((v.city||v.country||'Ziyaretçi')+' '+String(v.visitor_token||'').slice(-4)); %>
<header class="page-head"><div><span class="eyebrow">CANLI DESTEK</span><h1>🟢 Canlı Ziyaretçiler</h1><p class="page-subtitle">Son 3 dakika aktif olan ziyaretçiler tek satırda görünür. Aynı IP/kişi tekrarlandığında bilgiler kart içinde toplanır.</p></div><div class="row-actions"><a class="btn" href="/live/chats">Sohbetler</a><a class="btn" href="/live/settings">Ayarlar</a></div></header>
<section class="live-stats-grid"><article><small>Online</small><b data-live-online><%=stats.online%></b></article><article><small>Bekleyen Sohbet</small><b data-live-waiting><%=stats.waiting%></b></article><article><small>Açık Sohbet</small><b><%=stats.open%></b></article><article><small>Bugünkü Ziyaretçi</small><b><%=stats.todayVisitors||0%></b></article></section>
<section class="card live-command-bar"><div><b>Canlı sayfa takibi</b><small>🟢 aktif · 👁 sayfa · 💬 sohbet · ➜ bulunduğu sayfa · 👤 ziyaret sayısı</small></div><div class="row-actions"><span class="tag tag--success"><%=visitors.length%> aktif ziyaretçi</span></div></section>
<section class="live-layout-grid"><div class="card live-visitors-card"><div class="card-head"><div><h2>Aktif Ziyaretçiler</h2><small>Ziyaretçi yazmasa bile Sohbet Et ile karşılamayı başlatabilirsiniz.</small></div></div><div class="live-visitor-list live-visitor-list--pro"><% if(!visitors.length){ %><p class="empty">Şu anda aktif ziyaretçi yok.</p><% } visitors.forEach(v=>{ const activeSec=Math.max(0,Math.round((Date.now()-v.last_seen_at)/1000)); const nm=nameFor(v); %><article class="live-visitor-row live-visitor-row--pro live-visitor-card-pro"><div class="visitor-emoji"><span><%=avatarFor(v)%></span><i></i></div><div class="live-visitor-main"><div class="visitor-titleline"><b><span class="online-dot"></span><%=nm%></b><em><%=activeSec<60?activeSec+' sn':Math.round(activeSec/60)+' dk'%> önce</em></div><span class="visitor-sub"><%=v.site_name||'-'%> · <%=v.device_type||'-'%> · <%=v.ip||''%></span><a class="visitor-current" href="<%=v.current_url||'#'%>" target="_blank" title="<%=v.current_title||v.current_url||''%>">➜ <%=v.current_title||v.current_url||'-'%></a><div class="live-icon-strip"><span title="Görüntülenen sayfa sayısı">👁 <%=v.event_count||0%></span><span title="Sohbet sayısı">💬 <%=v.conversation_count||0%></span><span title="Tekil ziyaret sayısı">👤 <%=v.visit_count||1%></span><span title="Ziyaret günü">📅 <%=v.visit_days||1%></span></div><% if(v.contact_phone||v.contact_email||v.contact_company){ %><small class="live-contact-line">📌 <%=v.contact_company||''%> <%=v.contact_phone?(' · '+v.contact_phone):''%> <%=v.contact_email?(' · '+v.contact_email):''%></small><% } %><details class="live-pages-details"><summary>Gezinti geçmişi ve aktif sayfa</summary><div><% (v.pages||[]).forEach(p=>{ %><a href="<%=p.page_url%>" target="_blank"><small><%=new Date(p.created_at).toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit'})%></small><b><%=p.page_title||p.page_url%></b><span><%=p.page_url%></span></a><% }) %></div></details></div><div class="live-row-actions"><button class="btn btn--sm btn--primary" data-live-start="<%=v.id%>">Sohbet Et</button><% if(v.conversation_id){ %><button class="btn btn--sm" data-live-open="<%=v.conversation_id%>">Aç</button><% } %></div></article><% }) %></div></div>
<div class="card"><div class="card-head"><h2>Son Sohbetler</h2><a href="/live/chats">Tümünü Gör</a></div><div class="mini-list"><% if(!conversations.length){ %><p class="empty">Henüz sohbet yok.</p><% } conversations.forEach(c=>{ %><button class="mini-chat-btn" type="button" data-live-open="<%=c.id%>"><b><%=c.contact_name||c.site_name||'Site'%> · <%=c.visitor_token?.slice(-6)||'-'%></b><small><%=c.last_message||c.source_title||c.source_url||'-'%></small><% if(c.contact_phone||c.contact_email){ %><small>☎ <%=c.contact_phone||'-'%> · ✉ <%=c.contact_email||'-'%></small><% } %><% const age=Date.now()-Number(c.last_seen_at||0); const state=c.status==='CLOSED'?'CLOSED':(age<3*60*1000?'ONLINE':(age<10*60*1000?'PASSIVE':'LEFT')); %><span class="tag <%=state==='ONLINE'?'tag--success':state==='PASSIVE'?'tag--passive':state==='LEFT'?'tag--left':'tag--muted'%>"><%=state==='ONLINE'?'Aktif':state==='PASSIVE'?'Pasif':state==='LEFT'?'Siteyi terk etti':'Kapalı'%></span></button><% }) %></div></div></section>
