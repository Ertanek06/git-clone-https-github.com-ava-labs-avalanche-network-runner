<% layout('layout') -%>
<header class="page-head"><div><span class="eyebrow">CANLI DESTEK</span><h1>📍 Ziyaretçi Geçmişi</h1><p class="page-subtitle">Ziyaretçilerin gezdiği sayfalar, kaynaklar ve zaman kayıtları.</p></div><a class="btn" href="/live">Canlı Akış</a></header>
<form class="card list-toolbar" method="get"><label>Arama<input name="q" value="<%=q||''%>" placeholder="Sayfa, site, ziyaretçi kodu"></label><button class="btn btn--primary">Ara</button></form>
<section class="card"><div class="table-scroll"><table class="lined"><thead><tr><th>Zaman</th><th>Site</th><th>Ziyaretçi</th><th>Cihaz</th><th>Sayfa</th><th>Kaynak</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="6" class="empty">Kayıt yok.</td></tr><% } rows.forEach(e=>{ %><tr><td><%=new Date(e.created_at).toLocaleString('tr-TR')%></td><td><%=e.site_name||'-'%></td><td><%=e.visitor_token?.slice(-8)||'-'%><small><%=e.ip||''%></small></td><td><%=e.device_type||'-'%></td><td><b><%=e.page_title||'-'%></b><small><%=e.page_url||'-'%></small></td><td><%=e.referrer||'-'%></td></tr><% }) %></tbody></table></div></section>
