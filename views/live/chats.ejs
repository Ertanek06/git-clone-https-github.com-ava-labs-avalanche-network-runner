<% layout('layout') -%>
<header class="page-head"><div><span class="eyebrow">CANLI DESTEK</span><h1>💬 İletişim Merkezi</h1><p class="page-subtitle">Gelen kutusu, sohbetlerim ve tüm konuşmalar aynı panelde izlenir.</p></div><div class="row-actions"><a class="btn js-back" href="/live">← Canlı Ziyaretçiler</a></div></header>
<section class="live-stats-grid"><article><small>Bekleyen</small><b><%=stats.waiting%></b></article><article><small>Açık</small><b><%=stats.open%></b></article><article><small>Bugünkü Ziyaretçi</small><b><%=stats.todayVisitors||0%></b></article><article><small>Aktif Site</small><b><%=stats.sites%></b></article></section>
<section class="card live-chats-board live-inbox-v58"><div class="live-inbox-tabs"><a class="<%=(!status||status==='WAITING')?'is-active':''%>" href="/live/chats?status=WAITING">Gelen Kutusu <b><%=stats.waiting%></b></a><a class="<%=status==='OPEN'?'is-active':''%>" href="/live/chats?status=OPEN">Sohbetlerim <b><%=stats.open%></b></a><a class="<%=!status?'is-active':''%>" href="/live/chats">Tümü</a></div><div class="live-chat-cards live-chat-cards--pro live-chat-cards--inbox"><% if(!rows.length){ %><p class="empty">Kayıt yok.</p><% } rows.forEach(c=>{ const typing=c.typing_at && Date.now()-Number(c.typing_at)<10000 && c.typing_text; const age=Date.now()-Number(c.last_seen_at||0); const st=c.status==='CLOSED'?'CLOSED':(age<5*60*1000?'ONLINE':(age<10*60*1000?'PASSIVE':'LEFT')); const stText=st==='ONLINE'?'Aktif':st==='PASSIVE'?'Pasif':st==='LEFT'?'Siteyi terk etti':statusLabel(c.status); %><article class="live-chat-card live-chat-card--pro <%=c.status==='WAITING'?'is-waiting':''%> state-<%=st.toLowerCase()%>" data-live-open="<%=c.id%>"><div class="avatar-dot"><%=c.avatar_emoji||'💬'%></div><div class="live-chat-body"><div class="live-chat-title"><b><%=c.contact_name||('Ziyaretçi '+(c.visitor_token||'').slice(-6))%></b><span class="tag <%=st==='ONLINE'?'tag--success':st==='PASSIVE'?'tag--passive':st==='LEFT'?'tag--left':'tag--muted'%>"><%=stText%></span><% if(c.pinned){ %><span class="tag tag--info">Başa tutturuldu</span><% } %></div><small><%=c.site_name||'-'%> · <%=c.contact_company||c.contact_phone||c.contact_email||'İletişim bilgisi yok'%></small><span class="live-chat-last"><%=c.last_message||c.source_title||c.source_url||'-'%></span><% if(typing){ %><em class="live-typing-line">Yazıyor: <%=typing%></em><% } %><details class="live-pages-details"><summary>Sohbet ve gezinti özeti</summary><div><a href="<%=c.current_url||c.source_url||'#'%>" target="_blank"><small>Şu an</small><b><%=c.current_title||c.source_title||'-'%></b><span><%=c.current_url||c.source_url||''%></span></a></div></details></div><div class="live-chat-meta"><small><%=new Date(c.last_message_at).toLocaleString('tr-TR')%></small><b title="Okunmamış mesaj"><%=c.unread||0%></b><button class="btn btn--sm" type="button" data-live-pin="<%=c.id%>" data-pinned="<%=c.pinned?1:0%>"><%=c.pinned?'Tutturma':'Başa tuttur'%></button></div></article><% }) %></div></section>