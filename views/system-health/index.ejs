<% layout('layout') %>
<section class="page-head health-head"><div><span class="eyebrow">🩺 <%=locale==='en'?'OPERATIONS':'SİSTEM KONTROLÜ'%></span><h1><%=locale==='en'?'System Health Center':'Sistem Sağlık Merkezi'%></h1><p><%=locale==='en'?'Database, storage, document tools, mail readiness and backup verification in one place.':'Veritabanı, depolama, belge araçları, e-posta hazırlığı ve yedek doğrulaması tek ekranda.'%></p></div><form method="post" action="/system-health/backup-test"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--primary" type="submit">🧪 <%=locale==='en'?'Run backup verification':'Yedek Doğrulama Testi'%></button></form></section>
<section class="health-grid">
  <article class="card health-card <%=report.dbOk?'is-ok':'is-bad'%>"><div class="health-card__icon">🗄️</div><div><small><%=locale==='en'?'Database':'Veritabanı'%></small><h2><%=report.dbOk?'SAĞLIKLI':'KONTROL GEREKLİ'%></h2><p>SQLite: <b><%=report.integrity%></b> · <%=report.dbSize%></p></div></article>
  <article class="card health-card <%=report.storage.database&&report.storage.uploads&&report.storage.backups?'is-ok':'is-bad'%>"><div class="health-card__icon">💾</div><div><small><%=locale==='en'?'Storage permissions':'Depolama izinleri'%></small><h2><%=report.storage.database&&report.storage.uploads&&report.storage.backups?'YAZILABİLİR':'İZİN HATASI'%></h2><p>DB <b><%=report.storage.database?'✓':'✕'%></b> · Upload <b><%=report.storage.uploads?'✓':'✕'%></b> · Backup <b><%=report.storage.backups?'✓':'✕'%></b></p></div></article>
  <article class="card health-card <%=report.tools.pdftotext?'is-ok':'is-warn'%>"><div class="health-card__icon">📄</div><div><small>PDF / OCR</small><h2><%=report.tools.pdftotext?'PDF HAZIR':'PDF ARACI EKSİK'%></h2><p>pdftotext <b><%=report.tools.pdftotext?'✓':'✕'%></b> · OCR <b><%=report.tools.tesseract?'✓':'✕'%></b></p></div></article>
  <article class="card health-card <%=report.mailConfigured?'is-ok':'is-warn'%>"><div class="health-card__icon">✉️</div><div><small>SMTP</small><h2><%=report.mailConfigured?'YAPILANDIRILDI':'AYAR KONTROLÜ'%></h2><p><%=report.mailConfigured?'E-posta ayarı kayıtlı.':'Entegrasyonlar ekranından SMTP ayarını kontrol edin.'%></p></div></article>
  <article class="card health-card <%=report.dataIntegrity.ok?'is-ok':'is-bad'%>"><div class="health-card__icon">🛡️</div><div><small><%=locale==='en'?'Data integrity':'Veri bütünlüğü'%></small><h2><%=report.dataIntegrity.ok?'SAĞLAM':'KONTROL GEREKLİ'%></h2><p><%=locale==='en'?'Missing files':'Eksik dosya'%> <b><%=report.dataIntegrity.missing_files%></b> · <%=locale==='en'?'Broken links':'Bozuk ilişki'%> <b><%=report.dataIntegrity.broken_relations%></b></p></div></article>
</section>
<section class="card health-detail"><div class="card-head"><div><h2>📊 <%=locale==='en'?'Technical summary':'Teknik Özet'%></h2><p><%=locale==='en'?'Current application and verification status.':'Uygulamanın güncel çalışma ve doğrulama durumu.'%></p></div></div><div class="health-table"><div><span>Sürüm</span><b><%=report.version%></b></div><div><span>Release</span><b><%=report.release%></b></div><div><span>Migration</span><b><%=report.migration%></b></div><div><span>Node.js</span><b><%=report.tools.node%></b></div><div><span><%=locale==='en'?'Disk free / total':'Disk boş / toplam'%></span><b><%=report.diskFree%> / <%=report.diskTotal%></b></div><div><span><%=locale==='en'?'Memory free / total':'Bellek boş / toplam'%></span><b><%=report.memoryFree%> / <%=report.memoryTotal%></b></div><div><span>Son veri yedeği</span><b><%=report.lastBackup?new Date(report.lastBackup.created_at).toLocaleString('tr-TR'):'Henüz yok'%></b></div><div><span>Son geri yükleme testi</span><b><%=report.lastRestoreTest?new Date(report.lastRestoreTest.created_at).toLocaleString('tr-TR'):'Henüz çalıştırılmadı'%></b></div></div></section>
<section class="card health-recovery-link"><div><h2>🛟 <%=locale==='en'?'Archive & Recovery':'Arşiv ve Kurtarma'%></h2><p><%=locale==='en'?'Restore archived customers, products, proformas, profiles and templates without permanent deletion.':'Arşivlenen müşteri, ürün, proforma, profil ve şablonları kalıcı silme olmadan geri alın.'%></p></div><a class="btn btn--soft" href="/recovery"><%=locale==='en'?'Open Recovery Center':'Kurtarma Merkezini Aç'%></a></section>
<section class="card health-detail integrity-detail-v3817"><div class="card-head"><div><h2>🧬 <%=locale==='en'?'Data Integrity Details':'Veri Bütünlüğü Ayrıntıları'%></h2><p><%=locale==='en'?'Database references are compared with stored files and parent records. No data is deleted.':'Veritabanı bağlantıları, saklanan dosyalar ve üst kayıtlarla karşılaştırılır. Hiçbir veri silinmez.'%></p></div></div><div class="health-table"><div><span><%=locale==='en'?'Referenced files':'Bağlı dosyalar'%></span><b><%=report.dataIntegrity.referenced_files%></b></div><div><span><%=locale==='en'?'Missing files':'Eksik dosyalar'%></span><b><%=report.dataIntegrity.missing_files%></b></div><div><span><%=locale==='en'?'Unreferenced tenant uploads':'Bağlantısız firma dosyaları'%></span><b><%=report.dataIntegrity.orphan_public_files%></b></div><div><span><%=locale==='en'?'Contacts without customer':'Müşterisiz yetkililer'%></span><b><%=report.dataIntegrity.relations.contacts_without_customer||0%></b></div><div><span><%=locale==='en'?'Customer link mismatch':'Müşteri bağlantı hatası'%></span><b><%=report.dataIntegrity.relations.quote_customer_mismatch||0%></b></div></div><% if(report.dataIntegrity.missing?.length){ %><details class="integrity-missing-v3817"><summary><%=locale==='en'?'Show missing file references':'Eksik dosya bağlantılarını göster'%> (<%=report.dataIntegrity.missing.length%>)</summary><ul><% report.dataIntegrity.missing.forEach(item=>{ %><li><code><%=item.stored_value%></code><small><%=item.references.map(ref=>ref.source).join(', ')%></small></li><% }) %></ul></details><% } %></section>
