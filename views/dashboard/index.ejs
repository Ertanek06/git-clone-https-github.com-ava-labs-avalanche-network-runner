<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">
(()=>{document.addEventListener('click',async event=>{const button=event.target.closest('[data-workflow-note]');if(!button)return;const note=prompt(document.body.dataset.locale==='en'?'Enter follow-up note:':'Takip notunu yazın:',button.dataset.currentNote||'');if(note===null)return;button.disabled=true;try{const response=await fetch('/dashboard/workflow/'+encodeURIComponent(button.dataset.workflowNote)+'/note',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','Accept':'application/json','X-CSRF-Token':document.querySelector('meta[name="csrf-token"]')?.content||''},body:new URLSearchParams({_csrf:document.querySelector('meta[name="csrf-token"]')?.content||'',note})});const data=await response.json();if(!response.ok)throw new Error(data.message||(document.body.dataset.locale==='en'?'The note could not be saved.':'Not kaydedilemedi.'));location.reload()}catch(error){alert(error.message||(document.body.dataset.locale==='en'?'The note could not be saved.':'Not kaydedilemedi.'))}finally{button.disabled=false}})})();
</script>
