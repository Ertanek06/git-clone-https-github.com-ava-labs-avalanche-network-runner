        <a href="/quotes/sent"><small><%=locale==='en'?'Total':'Toplam'%></small><b><%=sentStats?.total||0%></b></a>
        <a href="/quotes/sent?filter=all"><small><%=locale==='en'?'Sent':'Gönderildi'%></small><b><%=sentStats?.sent||0%></b></a>
        <a href="/quotes/sent?filter=read" data-proforma-visit-history><small><%=locale==='en'?'Visits':'Açılma'%></small><b data-proforma-visit-count><%=sentStats?.visit_count||0%></b></a>
        <a href="/quotes/sent?filter=unread"><small><%=locale==='en'?'Unread':'Okunmadı'%></small><b><%=sentStats?.unread_count||0%></b></a>
      </div>
      <button type="button" class="dashboard-proforma-visit-alert-v16" data-proforma-visit-alert data-visit-id="<%=currentProformaVisit?.id||''%>" data-visit-company="<%=currentProformaVisit?.company_name||''%>" data-visit-quote="<%=currentProformaVisit?.display_no||''%>" data-visit-date="<%=currentProformaVisit?.date||''%>" data-visit-time="<%=currentProformaVisit?.time||''%>" hidden><span aria-hidden="true">●</span><span><b><%=locale==='en'?'Customer visited the proforma':'Müşteri proformayı ziyaret etti'%></b><small data-proforma-visit-alert-detail></small></span></button>
    </section>

    <section class="mobile-home-v4__panel">
      <header><div><span>📄</span><h2><%=locale==='en'?'Recent Proformas':'Son Proformalar'%></h2></div><a href="/quotes"><%=locale==='en'?'All':'Tümü'%> →</a></header>
      <div class="mobile-home-v4__list">
        <% if(!recentQuotes.length){ %><p class="mobile-home-v4__empty"><%=locale==='en'?'No proforma records yet.':'Henüz proforma kaydı yok.'%></p><% } %>
        <% recentQuotes.slice(0,6).forEach(q=>{const c=JSON.parse(q.customer_snapshot_json||'{}'),p=JSON.parse(q.profile_snapshot_json||'{}'),displayNo=quoteDisplayNo(q,p); %>
          <a href="/quotes/<%=q.id%>"><span><b><%=c.company_name||'-'%></b><small><%=displayNo%> · <%=statusLabel(q.status)%></small></span><strong><%=Number(q.grand_total||0).toLocaleString(locale==='en'?'en-GB':'tr-TR',{maximumFractionDigits:2})%> <%=q.currency%></strong></a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if(capabilities?.customers){ %>
    <section class="mobile-home-v4__panel">
      <header><div><span>👥</span><h2><%=locale==='en'?'Recently Added Customers':'Son Eklenen Müşteriler'%></h2></div><a href="/customers"><%=locale==='en'?'All':'Tümü'%> →</a></header>
      <div class="mobile-home-v4__list">
        <% if(!recentCustomers.length){ %><p class="mobile-home-v4__empty"><%=locale==='en'?'No customers yet.':'Henüz müşteri yok.'%></p><% } %>
        <% recentCustomers.slice(0,5).forEach(c=>{ %><a href="/customers/<%=c.id%>/edit"><span><b><%=c.company_name||'-'%></b><small><%=c.city||c.contact_name||'-'%></small></span><strong class="mobile-home-v4__go">›</strong></a><% }) %>
      </div>
    </section>
    <% } %>

    <% if(capabilities?.audit){ %>
    <section class="mobile-home-v4__panel">
      <header><div><span>🧾</span><h2><%=locale==='en'?'Recent Activities':'Son İşlemler'%></h2></div><a href="/audit"><%=locale==='en'?'Details':'Detay'%> →</a></header>
      <div class="mobile-home-v4__list mobile-home-v4__list--activity">
        <% if(!audits.length){ %><p class="mobile-home-v4__empty"><%=locale==='en'?'No activity yet.':'Henüz işlem yok.'%></p><% } %>
        <% audits.slice(0,6).forEach(a=>{ %><div><span><b><%=a.title||a.action%></b><small><%=a.detail||''%><%=a.detail?' · ':''%><%=new Date(a.created_at).toLocaleString(locale==='en'?'en-GB':'tr-TR')%></small></span></div><% }) %>
      </div>
    </section>
    <% } %>

    <section class="mobile-home-v4__panel">
      <header><div><span>🔔</span><h2><%=locale==='en'?'Notifications':'Bildirimler'%></h2></div></header>
      <div class="mobile-home-v4__list">
        <% if(!alerts.length){ %><p class="mobile-home-v4__empty"><%=locale==='en'?'No new notifications.':'Yeni bildirim bulunmuyor.'%></p><% } %>
        <% alerts.slice(0,6).forEach(n=>{ %><a href="<%=n.href||'/'%>"><span><b><%=n.title%></b><small><%=n.message||''%></small></span><strong class="mobile-home-v4__go">›</strong></a><% }) %>
      </div>
    </section>
  </div>
</section>
<div class="dashboard-overview-grid dashboard-widget-zone-v63" data-dashboard-zone="overview" data-dashboard-widget-zone="overview">
<% if(capabilities?.quotes){ %><section class="card dashboard-sent-quotes-card dashboard-widget-v63" data-card-key="live-proforma-tracking" data-dashboard-widget="live-proforma-tracking">
  <div class="card-head"><div><h2>📨 <%=locale==='en'?'Live Proforma Tracking':'Canlı Proforma Takibi'%></h2><small><%=locale==='en'?'Open the visit count to see every customer visit grouped by day and time.':'Açılma sayısına tıklayarak müşteri ziyaretlerini gün ve saat bazında görüntüleyin.'%></small></div><div class="row-actions"><a class="btn btn--sm" href="/quotes/sent"><%=locale==='en'?'Tracking Screen':'Takip Ekranı'%></a></div></div>
  <div class="sent-quotes-mini metric-grid metric-grid--compact">
    <a class="metric metric--info" href="/quotes/sent"><span class="metric__icon">📨</span><span class="metric__copy"><small><%=locale==='en'?'Total Sends':'Toplam gönderim'%></small><strong><%=sentStats?.total||0%></strong></span></a>
    <a class="metric metric--success" href="/quotes/sent?filter=all"><span class="metric__icon">✅</span><span class="metric__copy"><small><%=locale==='en'?'Sent':'Gönderildi'%></small><strong><%=sentStats?.sent||0%></strong></span></a>
    <a class="metric metric--success" href="/quotes/sent?filter=read" data-proforma-visit-history><span class="metric__icon">👁</span><span class="metric__copy"><small><%=locale==='en'?'Visits':'Açılma'%></small><strong data-proforma-visit-count><%=sentStats?.visit_count||0%></strong></span></a>
    <a class="metric metric--danger" href="/quotes/sent?filter=unread"><span class="metric__icon">🔴</span><span class="metric__copy"><small>Okunmayan</small><strong><%=sentStats?.unread_count||0%></strong></span></a>
    <a class="metric metric--warning" href="/quotes/sent?filter=failed"><span class="metric__icon">⚠️</span><span class="metric__copy"><small><%=locale==='en'?'Failed':'Başarısız'%></small><strong><%=sentStats?.failed||0%></strong></span></a>
  </div>
  <button type="button" class="dashboard-proforma-visit-alert-v16" data-proforma-visit-alert data-visit-id="<%=currentProformaVisit?.id||''%>" data-visit-company="<%=currentProformaVisit?.company_name||''%>" data-visit-quote="<%=currentProformaVisit?.display_no||''%>" data-visit-date="<%=currentProformaVisit?.date||''%>" data-visit-time="<%=currentProformaVisit?.time||''%>" hidden><span aria-hidden="true">●</span><span><b><%=locale==='en'?'Customer visited the proforma':'Müşteri proformayı ziyaret etti'%></b><small data-proforma-visit-alert-detail></small></span></button>
</section><% } %>
 <% if(capabilities?.quotes){ %><section class="card dashboard-proformas-card dashboard-widget-v63" data-card-key="recent-proformas" data-dashboard-widget="recent-proformas"><div class="card-head"><div><h2>📄 <%=locale==='en'?'Recent Proformas':'Son Proformalar'%></h2><small><%=locale==='en'?'Scrollable from newest to oldest within the card.':'Yeni kayıttan eskiye, kart içinde kaydırılır.'%></small></div><a href="/quotes"><%=locale==='en'?'View All':'Tümünü Gör'%></a></div><div class="dashboard-table-fit"><table class="lined dashboard-recent-table pro-table"><thead><tr><th>No</th><th><%=t('customers')%></th><th><%=t('quote_date')%></th><th><%=t('valid_until')%></th><th><%=t('status')%></th><th><%=t('total')%></th><th class="actions-col--1"><%=locale==='en'?'Actions':'İşlemler'%></th></tr></thead><tbody><% if(!recentQuotes.length){ %><tr><td colspan="7" class="empty"><%=locale==='en'?'No proforma records yet.':'Henüz proforma kaydı yok.'%></td></tr><% } recentQuotes.forEach(q=>{const c=JSON.parse(q.customer_snapshot_json||'{}'),p=JSON.parse(q.profile_snapshot_json||'{}'),displayNo=quoteDisplayNo(q,p),openLabel=locale==='en'?'Open':'Aç'; %><tr class="quote-row <%=statusClass(q.status).replace('tag--','quote-row--')%>"><td><a href="/quotes/<%=q.id%>"><%=displayNo%></a></td><td><%=c.company_name||'-'%></td><td><%=q.quote_date%></td><td><%=q.valid_until||'-'%></td><td><span class="tag <%=statusClass(q.status)%>"><%=statusLabel(q.status)%></span></td><td><b><%=Number(q.grand_total||0).toFixed(2)%></b> <%=q.currency%></td><td class="actions-cell actions-cell--1"><a class="table-action is-open" href="/quotes/<%=q.id%>" data-label="<%=openLabel%>" title="<%=openLabel%>" aria-label="<%=displayNo%> — <%=openLabel%>"><%- include('../partials/table-action-icon',{iconName:'open'}) %></a></td></tr><% }) %></tbody></table></div></section><% } %>
 <% if(capabilities?.customers){ %><section class="card dashboard-customers-card dashboard-widget-v63" data-card-key="recent-customers" data-dashboard-widget="recent-customers"><div class="card-head"><h2>👥 <%=locale==='en'?'Recently Added Customers':'Son Eklenen Müşteriler'%></h2><a href="/customers"><%=t('list')%></a></div><table class="dashboard-mini-table"><tbody><% if(!recentCustomers.length){ %><tr><td class="empty"><%=locale==='en'?'No customers yet.':'Henüz müşteri yok.'%></td></tr><% } recentCustomers.forEach(c=>{ const openLabel=locale==='en'?'Open':'Aç'; %><tr><td><a href="/customers/<%=c.id%>/edit"><b title="<%=c.company_name%>"><%=shortCompany(c.company_name)%></b><small><%=c.city||c.contact_name||'-'%></small></a></td><td class="actions-cell actions-cell--1"><a class="table-action is-open" href="/customers/<%=c.id%>/edit" data-label="<%=openLabel%>" title="<%=openLabel%>" aria-label="<%=c.company_name%> — <%=openLabel%>"><%- include('../partials/table-action-icon',{iconName:'open'}) %></a></td></tr><% }) %></tbody></table></section><% } %>
 <% if(capabilities?.quotes){ %><section class="card activity-card dashboard-workflow-card dashboard-widget-v63" data-card-key="smart-workflow" data-dashboard-widget="smart-workflow"><div class="card-head"><div><h2>🧠 <%=locale==='en'?'Smart Workflow Center':'Akıllı İş Akışı Merkezi'%></h2><small><%=locale==='en'?'Only current and upcoming offers; nearest validity date comes first.':'Yalnızca güncel ve yaklaşan proformalar; en yakın son geçerlilik tarihi önce gelir.'%></small></div><span class="workflow-current-count-v16"><%=workflowTasks?.length||0%> <%=locale==='en'?'current':'güncel'%></span></div><div class="activity-scroll workflow-task-list"><% if(!(workflowTasks||[]).length){ %><p class="empty"><%=locale==='en'?'No current offer follow-up tasks are pending.':'Güncel teklif takip görevi bulunmuyor.'%></p><% } (workflowTasks||[]).forEach(x=>{ %><article class="workflow-task workflow-task--<%=x.priority%>"><span class="workflow-task__dot"></span><div class="workflow-task__copy"><b><%=x.quote_no%> · <%=x.company_name%></b><small><%=x.text%> · <%=locale==='en'?'Last day':'Son gün'%>: <%=x.valid_until%></small><% if(x.task_note){ %><em><%=locale==='en'?'Note':'Not'%>: <%=x.task_note%></em><% } %></div><div class="workflow-task__actions"><a class="table-action is-open" href="/quotes/<%=x.id%>">↗ <%=locale==='en'?'Open':'Aç'%></a><form method="post" action="/dashboard/workflow/<%=x.task_id%>/complete" data-confirm="<%=locale==='en'?'Mark this follow-up task as completed?':'Bu takip görevi tamamlandı olarak işaretlensin mi?'%>"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="table-action is-success" type="submit">✓ <%=locale==='en'?'Complete':'Tamamla'%></button></form><form method="post" action="/dashboard/workflow/<%=x.task_id%>/snooze"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="days" value="1"><button class="table-action is-warning" type="submit"><%=locale==='en'?'+1 Day':'+1 Gün'%></button></form><button class="table-action" type="button" data-workflow-note="<%=x.task_id%>" data-current-note="<%=x.task_note||''%>">✎ <%=locale==='en'?'Note':'Not'%></button></div></article><% }) %></div></section><% } %>
 <% if(capabilities?.audit){ %><section class="card activity-card dashboard-activity-card dashboard-widget-v63" data-card-key="recent-activity" data-dashboard-widget="recent-activity"><div class="card-head"><h2>🧾 <%=locale==='en'?'Recent Activities':'Son İşlemler'%></h2><a href="/audit"><%=locale==='en'?'Details':'Detay'%></a></div><div class="activity-scroll"><% if(!audits.length){ %><p class="empty"><%=locale==='en'?'No activity yet.':'Henüz işlem yok.'%></p><% } audits.forEach(a=>{ %><div><b><%=a.title||a.action%></b><small><%=a.detail||''%><%=a.detail?' · ':''%><%=new Date(a.created_at).toLocaleString(locale==='en'?'en-GB':'tr-TR')%></small></div><% }) %></div></section><% } %>
 <section class="card dashboard-alerts-card dashboard-widget-v63" data-card-key="alerts" data-dashboard-widget="alerts"><div class="card-head"><h2>🔔 <%=locale==='en'?'Notifications':'Bildirimler'%></h2></div><div class="mini-list"><% if(!alerts.length){ %><p class="empty"><%=locale==='en'?'No new notifications.':'Yeni bildirim bulunmuyor.'%></p><% } alerts.forEach(n=>{ %><a href="<%=n.href||'/'%>"><b><%=n.title%></b><small><%=n.message||''%></small></a><% }) %></div></section>
 <% if(capabilities?.live){ %><section class="card dashboard-live-card dashboard-widget-v63" data-card-key="live-support" data-dashboard-widget="live-support"><div class="card-head"><div><h2>🟢 <%=locale==='en'?'Live Support':'Canlı Destek'%></h2><small><%=locale==='en'?'Live visitors and chats from the last '+(chatWindowHours||24)+' hours':'Anlık ziyaretçiler ve son '+(chatWindowHours||24)+' saatteki sohbetler'%></small></div><a href="/live"><%=locale==='en'?'Live Feed':'Canlı Akış'%></a></div><div class="live-dash-summary"><span><i class="online-dot"></i> Online <b data-live-dashboard-online><%=liveStats?.online||0%></b></span><span><%=locale==='en'?'Waiting':'Bekleyen'%> <b data-live-dashboard-waiting><%=liveStats?.waiting||0%></b></span><span><%=locale==='en'?'Open':'Açık'%> <b><%=liveStats?.open||0%></b></span></div><div class="mini-list live-dashboard-list"><% if(!(liveVisitors||[]).length && !(liveChats||[]).length){ %><p class="empty"><%=locale==='en'?'No active visitors or chats from the last '+(chatWindowHours||24)+' hours.':'Aktif ziyaretçi veya son '+(chatWindowHours||24)+' saat içinde mesajlaşılan sohbet yok.'%> <a href="/live/chats"><%=locale==='en'?'Click for full chat history':'Tüm sohbet geçmişi için tıklayın'%></a> <%=locale==='en'?'— old chats are not deleted; they are only removed from this list.':'— eski sohbetler silinmez, yalnızca bu listeden düşer.'%></p><% } (liveChats||[]).forEach(c=>{ %><button type="button" class="mini-chat-btn live-dash-alert" data-live-open="<%=c.id%>"><b><%=c.contact_name||((locale==='en'?'Visitor ':'Ziyaretçi ')+String(c.visitor_token||'').slice(-4))%> <% if(c.unread){ %><em><%=c.unread%> <%=locale==='en'?'new':'yeni'%></em><% } %></b><small><%=c.site_name||'-'%> · <%=c.last_message||(locale==='en'?'Chat available':'Sohbet var')%></small></button><% }) %><% (liveVisitors||[]).forEach(v=>{ %><button type="button" class="mini-chat-btn" <%=v.conversation_id?('data-live-open="'+v.conversation_id+'"'):('data-live-start="'+v.id+'"')%>><b><span class="online-dot"></span><%=v.contact_name||((locale==='en'?'Visitor ':'Ziyaretçi ')+String(v.visitor_token||'').slice(-4))%></b><small><%=v.site_name||'-'%> · <%=v.current_title||v.current_url||'-'%></small></button><% }) %></div></section><% } %>
</div>
