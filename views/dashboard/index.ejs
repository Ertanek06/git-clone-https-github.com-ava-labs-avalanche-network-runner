<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">window.DASHBOARD_LAYOUT_BOOT=<%-JSON.stringify(dashboardLayout||{}).replace(/</g,'\u003c')%>;</script>
<% layout('layout') -%><% const canWrite=Boolean(capabilities?.quoteCreate); const shortCompany=v=>String(v||'-').trim().split(/\s+/).slice(0,2).join(' '); const currentProformaVisit=typeof latestProformaVisit!=='undefined'?latestProformaVisit:null; %>
<header class="page-head dashboard-page-head"><div><span class="eyebrow"><%=locale==='en'?'BUSINESS OVERVIEW':'İŞLETME GENEL BAKIŞ'%></span><h1><%=locale==='en'?'Business Overview':'İşletme Genel Bakış'%></h1><p class="muted"><%=locale==='en'?'Add or remove widgets, then move, resize and lock every card. Your layout is saved to your account.':'Widget ekleyip kaldırın; her kartı taşıyın, boyutlandırın ve kilitleyin. Düzeniniz kullanıcı hesabınıza kalıcı kaydedilir.'%></p></div><div class="dashboard-edit-actions"><button class="btn btn--sm btn--primary" type="button" data-modal-open="dashboardWidgetManager"><%=locale==='en'?'⊞ Add / Arrange Widgets':'⊞ Widget Ekle / Düzenle'%></button><button class="btn btn--sm btn--soft" type="button" data-dashboard-shortcut-add-v62><%=locale==='en'?'＋ Shortcuts':'＋ Kısayollar'%></button></div></header>
<nav class="dashboard-shortcuts unified-shortcuts dashboard-shortcuts-dynamic" data-shortcut-zone aria-label="<%=locale==='en'?'Quick access':'Hızlı erişim'%>"><% if(capabilities?.customers){ %><a href="/customers" data-shortcut-key="customers"><span aria-hidden="true">👥</span><%=locale==='en'?'Customers':'Müşteriler'%></a><% } %><% if(capabilities?.products){ %><a href="/products" data-shortcut-key="products"><span aria-hidden="true">📦</span><%=locale==='en'?'Products':'Ürünler'%></a><% } %><% if(capabilities?.quotes){ %><a href="/quotes" data-shortcut-key="quotes"><span aria-hidden="true">📄</span><%=locale==='en'?'Proformas':'Proformalar'%></a><a href="/quotes/sent" data-shortcut-key="sent"><span aria-hidden="true">📨</span><%=locale==='en'?'Sent Proformas':'Gönderilen Proformalar'%></a><% } %><% if(canWrite){ %><a class="is-primary" href="/quotes/new" data-shortcut-key="quote-new"><span aria-hidden="true">＋</span><%=locale==='en'?'Create Proforma':'Proforma Oluştur'%></a><% } %></nav>
<section class="metric-grid" data-dashboard-zone="metrics"><% const metrics=[]; if(capabilities?.customers)metrics.push(['👥',locale==='en'?'Total Customers':'Toplam Müşteri',stats.customers,'customers','customers']); if(capabilities?.products)metrics.push(['📦',locale==='en'?'Products & Services':'Ürün ve Hizmet',stats.products,'products','products']); if(capabilities?.quotes){metrics.push(['📄',locale==='en'?'Total Proformas':'Toplam Proforma',stats.quotes,'quotes','quotes'],['⏳',locale==='en'?'Expired':'Süresi Dolan',stats.expired,'expired','danger'],['🕒',locale==='en'?'Pending Approval':'Onay Bekleyen',stats.pending,'pending','warning'],['🚚',locale==='en'?'Upcoming Delivery':'Yaklaşan Teslimat',stats.delivery,'delivery','info']);} if(capabilities?.orders)metrics.push(['✅',locale==='en'?'Converted Orders':'Siparişe Dönüşen',stats.orders,'orders','success']); if(capabilities?.financials)metrics.push(['💳',locale==='en'?'Awaiting Payment':'Ödeme Bekleyen',stats.payments,'payments','danger']); metrics.forEach(m=>{ %><button type="button" class="metric metric--<%=m[4]%>" data-stat="<%=m[3]%>"><span class="metric__icon"><%=m[0]%></span><span class="metric__copy"><small><%=m[1]%></small><strong><%=m[2]%></strong></span></button><% }) %><% if(capabilities?.live){ %><a class="metric metric--success metric--live" href="/live"><span class="metric__icon">🟢</span><span class="metric__copy"><small><%=locale==='en'?'Live Visitors':'Anlık Ziyaretçi'%></small><strong data-live-dashboard-online><%=liveStats?.online||0%></strong></span></a><a class="metric metric--warning metric--live" href="/live/chats"><span class="metric__icon">💬</span><span class="metric__copy"><small><%=locale==='en'?'New Messages / Waiting':'Yeni Mesaj / Bekleyen'%></small><strong data-live-dashboard-waiting><%=liveStats?.waiting||0%></strong></span></a><% } %></section>
<% if(capabilities?.financials || capabilities?.quotes){ %><section class="decision-grid decision-grid--pro-v79" data-dashboard-zone="decisions" aria-label="Yönetim karar kartları">
  <% const money=v=>Number(v||0).toLocaleString(locale==='en'?'en-GB':'tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2}); %>
  <% if(capabilities?.financials){ %><article class="decision-card decision-card--quote"><span class="decision-card__icon" aria-hidden="true">💰</span><div><small><%=locale==='en'?'Offers This Month':'Bu Ay Teklif Tutarı'%></small><b><%=money(stats.monthQuoteTry)%> ₺</b><span><%=locale==='en'?'Total proformas created':'Oluşturulan proforma toplamı'%></span></div></article>
  <article class="decision-card decision-card--approved"><span class="decision-card__icon" aria-hidden="true">✅</span><div><small><%=locale==='en'?'Approved This Month':'Bu Ay Onaylanan'%></small><b><%=money(stats.monthApprovedTry)%> ₺</b><span><%=locale==='en'?'Approval / order / delivery total':'Onay / sipariş / teslim toplamı'%></span></div></article>
  <article class="decision-card decision-card--payment"><span class="decision-card__icon" aria-hidden="true">💳</span><div><small><%=locale==='en'?'Outstanding Payment':'Bekleyen Ödeme'%></small><b><%=money(stats.paymentWaitingTry)%> ₺</b><span><%=locale==='en'?'Remaining unpaid amount':'Ödenmemiş kalan tutar'%></span></div></article><% } %>
  <% if(capabilities?.quotes){ %><article class="decision-card decision-card--rate"><span class="decision-card__icon" aria-hidden="true">📈</span><div><small><%=locale==='en'?'Win Rate':'Kazanma Oranı'%></small><b>%<%=stats.winRate||0%></b><span><%=locale==='en'?'Order conversion rate':'Siparişe dönüşüm oranı'%></span></div></article><% } %>
</section><% } %>

<section class="mobile-dashboard-single-panel-v10 mobile-home-v4" aria-label="<%=locale==='en'?'Mobile home':'Mobil ana sayfa'%>">
  <header class="mobile-home-v4__top">
    <div><span class="eyebrow"><%=locale==='en'?'MOBILE DASHBOARD':'MOBİL ANA SAYFA'%></span><h1><%=locale==='en'?'Home':'Ana Sayfa'%></h1></div>
    <% if(canWrite){ %><a class="btn btn--primary btn--sm" href="/quotes/new">＋ <%=locale==='en'?'New Proforma':'Yeni Proforma'%></a><% } %>
  </header>

  <div class="mobile-home-v4__stack">
    <% if(capabilities?.quotes){ %>
    <section class="mobile-home-v4__panel mobile-home-v4__panel--tracking">
      <header><div><span>📨</span><h2><%=locale==='en'?'Live Proforma Tracking':'Canlı Proforma Takibi'%></h2></div><a href="/quotes/sent"><%=locale==='en'?'Open':'Aç'%> →</a></header>
