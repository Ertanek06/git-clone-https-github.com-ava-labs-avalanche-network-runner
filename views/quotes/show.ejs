<% layout('layout') -%>
<%
 const en=String(locale||'tr').toLowerCase()==='en';
 const L=en?{
  eyebrow:'PROFORMA / OFFER',back:'Back',edit:'Edit',preview:'Preview',print:'Print / PDF',email:'Send Email',whatsapp:'Share via WhatsApp',invoice:'Invoice Draft',archive:'Archive',archiveTitle:'Archive proforma',archiveConfirm:'Archive this proforma?',
  customerInfo:'Customer Information',company:'Company',contact:'Contact',phone:'Phone',emailLabel:'Email',tax:'Tax',address:'Address',offerSummary:'Offer Summary',quoteDate:'Offer Date',validity:'Validity',deliveryDate:'Delivery Date',fixedRate:'Fixed Rate',total:'Total',tryEquivalent:'TRY Equivalent',
  revisionComparison:'Revision Comparison',revisionHelp:'Price, quantity and product changes compared with the previous offer.',oldTotal:'Previous Total',newTotal:'New Total',noRevisionChange:'No price, quantity or product change has been recorded in this revision.',changedField:'Changed Field',product:'Product',old:'Previous',new:'New',price:'Price',quantity:'Quantity',
  processTitle:'Process Actions / Approval and Follow-up',processHelp:'Status, payment, follow-up and approval actions are managed in a compact card layout.',approvalFollow:'Approval and Follow-up',approvalStatus:'Approval status',reason:'Reason',followDate:'Follow-up date',followNote:'Follow-up note',save:'Save',approve:'Approve',reject:'Reject',statusOrder:'Status and Order',status:'Status',order:'Order',production:'Production',paymentTrack:'Payment Tracking',payment:'Payment',paidAmount:'Paid amount',remaining:'Remaining amount',paymentNote:'Payment note',savePayment:'Save Payment',quickActions:'Quick Actions',convertTitle:'Convert to order?',convertMessage:'This proforma will be converted to an order and an order number will be generated. Do you confirm?',convertOk:'Yes, Convert to Order',
  itemLines:'Product and Service Lines',line:'line',lines:'lines',image:'Image',code:'Code',productService:'Product / Service',unitPrice:'Unit Price',discount:'Discount',vat:'VAT',brochure:'Download Brochure',ce:'CE Document',manual:'User Manual',termsTitle:'Delivery, Payment and Warranty Terms',showHide:'Show / hide',paymentTerm:'Payment',delivery:'Delivery',shipping:'Shipping',installation:'Installation',warranty:'Warranty',discountTotal:'Discount',grandTotal:'Grand Total',payableTry:'Amount Payable (TRY)'
 }:{
  eyebrow:'PROFORMA / TEKLİF',back:'Geri',edit:'Düzenle',preview:'Ön İzle',print:'Yazdır / PDF',email:'E-posta Gönder',whatsapp:'WhatsApp ile Paylaş',invoice:'Fatura Taslağı',archive:'Arşivle',archiveTitle:'Proformayı arşivle',archiveConfirm:'Bu proforma arşivlensin mi?',
  customerInfo:'Müşteri Bilgileri',company:'Firma',contact:'Yetkili',phone:'Telefon',emailLabel:'E-posta',tax:'Vergi',address:'Adres',offerSummary:'Teklif Özeti',quoteDate:'Teklif Tarihi',validity:'Geçerlilik',deliveryDate:'Teslim Tarihi',fixedRate:'Sabit Kur',total:'Toplam',tryEquivalent:'TL Karşılığı',
  revisionComparison:'Revizyon Karşılaştırması',revisionHelp:'Eski teklif ile bu revizyonda değişen fiyat, adet ve ürün bilgileri.',oldTotal:'Eski Toplam',newTotal:'Yeni Toplam',noRevisionChange:'Bu revizyonda henüz fiyat, adet veya ürün değişikliği kaydedilmedi.',changedField:'Değişen Alan',product:'Ürün',old:'Eski',new:'Yeni',price:'Fiyat',quantity:'Adet',
  processTitle:'Süreç İşlemleri / Onay ve Takip',processHelp:'Durum, ödeme, takip ve onay işlemleri kompakt kart düzeninde yönetilir.',approvalFollow:'Onay ve Takip',approvalStatus:'Onay durumu',reason:'Sebep',followDate:'Takip tarihi',followNote:'Takip notu',save:'Kaydet',approve:'Onayla',reject:'Reddet',statusOrder:'Durum ve Sipariş',status:'Durum',order:'Sipariş',production:'Üretim',paymentTrack:'Ödeme Takibi',payment:'Ödeme',paidAmount:'Ödenen tutar',remaining:'Kalan tutar',paymentNote:'Ödeme notu',savePayment:'Ödemeyi Kaydet',quickActions:'Hızlı İşlemler',convertTitle:'Siparişe dönüştürülsün mü?',convertMessage:'Bu proforma siparişe dönüştürülecek ve sipariş numarası üretilecektir. Onaylıyor musunuz?',convertOk:'Evet, Siparişe Dönüştür',
  itemLines:'Ürün ve Hizmet Satırları',line:'satır',lines:'satır',image:'Görsel',code:'Kod',productService:'Ürün / Hizmet',unitPrice:'Birim Fiyat',discount:'İndirim',vat:'KDV',brochure:'Broşürü İndir',ce:'CE Belgesi',manual:'Kullanma Kılavuzu',termsTitle:'Teslimat, Ödeme ve Garanti Koşulları',showHide:'Göster / kapat',paymentTerm:'Ödeme',delivery:'Teslimat',shipping:'Nakliye',installation:'Kurulum',warranty:'Garanti',discountTotal:'İndirim / İskonto',grandTotal:'Genel Toplam',payableTry:'Ödenecek Tutar (TRY)'
 };
 const showMoney=canSeeFinancials!==false,displayNo=quoteDisplayNo(row,row.profile_snapshot||{}),c=row.customer_snapshot||{},p=row.profile_snapshot||{};
 const customerStreet=[c.delivery_address,c.billing_address,c.address1,c.address2].map(v=>String(v||'').replace(/\uFFFD/g,'').trim()).find(v=>/[\p{L}\p{N}]/u.test(v))||'';
 const hasWhatsappMobile=String(c.mobile||c.phone||'').replace(/\D/g,'').length>=10;
 const tryTotal=Number(row.grand_total||0)*Number(row.fx_rate||1),grossTotal=Number(row.subtotal||0)+Number(row.discount_total||0),showTry=String(row.show_try_total??1)!=='0';
 const vatRates=[...new Set((row.items||[]).map(i=>Number(i.vat_rate||0)).filter(v=>Number.isFinite(v)))],vatLabel=vatRates.length===1?`${L.vat} %${vatRates[0]}`:L.vat;
 const revisionChanges=(()=>{try{return JSON.parse(row.revision_compare_json||'[]')}catch{return []}})();
%>
<header class="page-head quote-detail-head">
 <div><span class="eyebrow"><%=L.eyebrow%></span><h1><%=displayNo%> <% if(row.revision_no){ %><span class="tag">Rev <%=row.revision_no%></span><% } %></h1></div>
 <div class="row-actions quote-page-actions">
  <a class="btn btn--sm" href="/quotes">← <%=L.back%></a>
  <% if(can('quotes','edit')){ %><a class="btn btn--sm" href="/quotes/<%=row.id%>/edit">✎ <%=L.edit%></a><% } %>
  <% if(can('quotes','export')){ %>
   <button class="btn btn--sm" type="button" data-preview-title="<%=displayNo%>" data-preview-url="/quotes/<%=row.id%>/preview" data-preview-open="/quotes/<%=row.id%>/print" data-preview-email="/quotes/<%=row.id%>/email" data-preview-edit="/quotes/<%=row.id%>/edit" <% if(hasWhatsappMobile){ %>data-preview-whatsapp="/quotes/<%=row.id%>/whatsapp"<% } %>>◉ <%=L.preview%></button>
   <a class="btn btn--primary btn--sm" target="_blank" rel="noopener" href="/quotes/<%=row.id%>/print?auto=1">🖨 <%=L.print%></a>
   <a class="btn btn--soft btn--sm" href="/quotes/<%=row.id%>/email">✉ <%=L.email%></a>
   <% if(hasWhatsappMobile){ %><form class="inline-form" method="post" action="/quotes/<%=row.id%>/whatsapp" data-whatsapp-share><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="return_to" value="/quotes/<%=row.id%>"><button class="btn btn--whatsapp btn--sm quote-whatsapp-action" type="submit" title="<%=L.whatsapp%>" aria-label="<%=L.whatsapp%>"><%- include('../partials/whatsapp-icon') %><span class="quote-whatsapp-label"><%=L.whatsapp%></span></button></form><% } %>
  <% } %>
  <% if(can('invoices','create')){ %><form class="inline-form" method="post" action="/invoices/from-quote/<%=row.id%>"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--soft btn--sm" type="submit">🧾 <%=L.invoice%></button></form><% } %>
  <% if(can('quotes','archive')){ %><form class="inline-form" method="post" action="/quotes/<%=row.id%>/delete"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--danger btn--sm" type="submit" title="<%=L.archiveTitle%>" data-confirm='<%=L.archiveConfirm%>'>🗄 <%=L.archive%></button></form><% } %>
 </div>
</header>

<section class="quote-detail-grid quote-detail-grid--pro">
 <article class="card quote-info-card quote-info-card--customer"><div class="card-head"><h2><%=L.customerInfo%></h2><span class="pill"><%=c.short_name||c.company_name||'-'%></span></div><dl class="detail-list detail-list--pro"><dt><%=L.company%></dt><dd><%=c.company_name||'-'%></dd><dt><%=L.contact%></dt><dd><%=c.contact_name||'-'%> <%=c.contact_title?`· ${c.contact_title}`:''%></dd><dt><%=L.phone%></dt><dd><%=c.phone||c.mobile||'-'%></dd><dt><%=L.emailLabel%></dt><dd><%=c.email||'-'%></dd><dt><%=L.tax%></dt><dd><%=[c.tax_office,c.tax_no].filter(Boolean).join(' / ')||'-'%></dd><dt><%=L.address%></dt><dd><%=[customerStreet,c.district,c.city,c.country].filter(Boolean).join(' · ')||'-'%></dd></dl></article>
 <article class="card quote-info-card quote-info-card--summary"><div class="card-head"><h2><%=L.offerSummary%></h2><span class="tag <%=statusClass(row.status)%>"><%=statusLabel(row.status)%></span></div><div class="snapshot-grid quote-summary-cards quote-summary-cards--pro"><div><small><%=L.quoteDate%></small><b><%=row.quote_date||'-'%></b></div><div><small><%=L.validity%></small><b><%=row.valid_until||'-'%></b></div><div><small><%=L.deliveryDate%></small><b><%=row.delivery_date||'-'%></b></div><div><small><%=L.fixedRate%></small><b><%=row.fx_rate||1%> · <%=row.fx_date||'-'%></b></div><% if(showMoney){ %><div><small><%=L.total%></small><b><%=Number(row.grand_total||0).toFixed(2)%> <%=row.currency%></b></div><% if(showTry&&row.currency!=='TRY'){ %><div><small><%=L.tryEquivalent%></small><b><%=tryTotal.toFixed(2)%> TRY</b></div><% } %><% } %></div></article>
</section>

<% if(Number(row.revision_no||0)>0){ %>
<section class="card revision-compare-card"><div class="card-head"><div><h2><%=L.revisionComparison%></h2><small><%=L.revisionHelp%></small></div><span class="tag">REV <%=row.revision_no%></span></div>
 <div class="revision-total-strip"><div><small><%=L.oldTotal%></small><b><%=Number(row.revision_old_total||0).toFixed(2)%> <%=row.currency%></b></div><div><small><%=L.newTotal%></small><b><%=Number(row.revision_new_total||row.grand_total||0).toFixed(2)%> <%=row.currency%></b></div></div>
 <% if(!revisionChanges.length){ %><p class="muted"><%=L.noRevisionChange%></p><% } else { %><div class="table-scroll"><table class="lined revision-compare-table"><thead><tr><th><%=L.changedField%></th><th><%=L.product%></th><th><%=L.old%></th><th><%=L.new%></th></tr></thead><tbody><% revisionChanges.forEach(ch=>{ %><tr><td><span class="tag"><%=ch.type==='PRICE'?L.price:ch.type==='QTY'?L.quantity:L.product%></span></td><td><b><%=ch.label||'-'%></b></td><td><%=ch.old%> <%=ch.currency||ch.unit||''%></td><td><%=ch.new%> <%=ch.currency||ch.unit||''%></td></tr><% }) %></tbody></table></div><% } %>
</section>
<% } %>

<section class="card quote-process-board"><div class="card-head"><div><h2><%=L.processTitle%></h2><small><%=L.processHelp%></small></div></div><div class="quote-process-grid">
 <div class="process-mini-card approval-box"><b><%=L.approvalFollow%></b><p><small><%=L.approvalStatus%></small><span class="tag"><%=row.approval_status||'NOT_REQUIRED'%></span></p><% if(row.approval_reason){ %><p><small><%=L.reason%></small><span><%=row.approval_reason%></span></p><% } %><% if(can('quotes','edit')){ %><form method="post" action="/quotes/<%=row.id%>/follow-up" class="process-inline-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label><%=L.followDate%><input type="date" name="follow_up_date" value="<%=row.follow_up_date||''%>"></label><label><%=L.followNote%><input name="follow_up_note" value="<%=row.follow_up_note||''%>"></label><button class="btn btn--soft"><%=L.save%></button></form><% } %><% if(row.approval_status==='PENDING'&&can('approvals','approve')){ %><form method="post" action="/quotes/<%=row.id%>/approval" class="row-actions"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--success" name="decision" value="APPROVED"><%=L.approve%></button><button class="btn btn--danger" name="decision" value="REJECTED"><%=L.reject%></button></form><% } %></div>
 <% if(can('quotes','edit')){ %><form method="post" action="/quotes/<%=row.id%>/status" class="process-mini-card process-status-form process-status-form--pro" data-process-confirm="1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><b><%=L.statusOrder%></b><div class="process-field-grid"><label><%=L.status%><select name="status"><% ['DRAFT','PREPARING','SENT','WAITING_CUSTOMER','REVISION_REQUESTED','APPROVED','REJECTED','EXPIRED','ORDERED','DELIVERED'].forEach(x=>{ %><option value="<%=x%>" <%=row.status===x?'selected':''%>><%=statusLabel(x)%></option><% }) %></select></label><label><%=L.order%><select name="order_status"><% ['NONE','ORDER_RECEIVED','CONFIRMED','SHIPPED','ORDER_CANCELLED'].forEach(x=>{ %><option value="<%=x%>" <%=row.order_status===x?'selected':''%>><%=statusLabel(x)%></option><% }) %></select></label><label><%=L.production%><select name="production_status"><% ['NOT_STARTED','PLANNED','STARTED','QUALITY_CONTROL','COMPLETED'].forEach(x=>{ %><option value="<%=x%>" <%=row.production_status===x?'selected':''%>><%=statusLabel(x)%></option><% }) %></select></label></div><button class="btn"><%=t('update_status')%></button></form><% } %>
 <% if(can('financials','edit')){ %><form method="post" action="/quotes/<%=row.id%>/status" class="process-mini-card process-payment-card" data-process-confirm="1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="status" value="<%=row.status%>"><input type="hidden" name="order_status" value="<%=row.order_status%>"><input type="hidden" name="production_status" value="<%=row.production_status%>"><b><%=L.paymentTrack%></b><div class="process-field-grid"><label><%=L.payment%><select name="payment_status"><% ['UNPAID','PARTIAL','PAID','CANCELLED'].forEach(x=>{ %><option value="<%=x%>" <%=row.payment_status===x?'selected':''%>><%=statusLabel(x)%></option><% }) %></select></label><label><%=L.paidAmount%><input name="paid_amount" type="number" step="0.01" value="<%=row.paid_amount||0%>"></label><label><%=L.remaining%><input readonly value="<%=Math.max(0,Number(row.grand_total||0)-Number(row.paid_amount||0)).toFixed(2)%> <%=row.currency%>"></label><label class="wide"><%=L.paymentNote%><input name="payment_note" value="<%=row.payment_note||''%>"></label></div><button class="btn"><%=L.savePayment%></button></form><% } %>
 <% if(can('quotes','edit')||can('orders','create')){ %><div class="process-mini-card process-fast-actions"><b><%=L.quickActions%></b><form method="post" action="/quotes/<%=row.id%>/revision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--block"><%=t('create_revision')%></button></form><% if(row.order_status==='NONE'){ %><form method="post" action="/quotes/<%=row.id%>/order" data-confirm-submit="1" data-confirm-title="<%=L.convertTitle%>" data-confirm-message="<%=L.convertMessage%>" data-confirm-ok="<%=L.convertOk%>"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--success btn--block"><%=t('convert_order')%></button></form><% } %></div><% } %>
</div></section>

<section class="card quote-detail-items"><div class="card-head"><h2><%=L.itemLines%></h2><span class="pill"><%=row.items.length%> <%=row.items.length===1?L.line:L.lines%></span></div><div class="table-scroll"><table class="lined quote-summary-table"><thead><tr><th><%=L.image%></th><th><%=L.code%></th><th><%=L.productService%></th><th><%=L.quantity%></th><% if(showMoney){ %><th><%=L.unitPrice%></th><th><%=L.discount%></th><% } %><th><%=L.vat%></th><% if(showMoney){ %><th><%=L.total%></th><% } %></tr></thead><tbody><% row.items.forEach(i=>{const x=i.product_snapshot||{}; %><tr><td><div class="quote-detail-thumb"><% if(i.show_image&&x.image_url){ %><img loading="lazy" src="<%=x.image_url%>" alt="" data-empty-image-on-error><% } %></div></td><td><b><%=x.code||'-'%></b><% if(x.brochure_url){ %><a class="brochure-link block" target="_blank" rel="noopener" href="<%=x.brochure_url%>"><%=L.brochure%></a><% } %><% if(x.ce_certificate_url){ %><a class="brochure-link block" target="_blank" rel="noopener" href="<%=x.ce_certificate_url%>"><%=L.ce%></a><% } %><% if(x.manual_url){ %><a class="brochure-link block" target="_blank" rel="noopener" href="<%=x.manual_url%>"><%=L.manual%></a><% } %></td><td><b><%=x.name||'-'%></b><small class="block"><%=[x.short_description,x.technical_description].filter(Boolean).join('\n')%></small></td><td><%=i.quantity%> <%=i.unit%></td><% if(showMoney){ %><td><%=Number(i.unit_price||0).toFixed(2)%> <%=row.currency%></td><td><%=i.discount_value%> <%=i.discount_type==='PERCENT'?'%':row.currency%></td><% } %><td><%=i.vat_rate%>%</td><% if(showMoney){ %><td><b><%=Number(i.line_net||0).toFixed(2)%> <%=row.currency%></b></td><% } %></tr><% }) %></tbody></table></div></section>

<section class="quote-detail-bottom"><details class="card terms-collapse"><summary><span><%=L.termsTitle%></span><small><%=L.showHide%></small></summary><div class="term-grid"><p><b><%=L.paymentTerm%>:</b> <%=row.payment_terms||'-'%></p><p><b><%=L.delivery%>:</b> <%=row.delivery_terms||'-'%></p><p><b><%=L.shipping%>:</b> <%=row.shipping_terms||'-'%></p><p><b><%=L.installation%>:</b> <%=row.installation_terms||'-'%></p><p><b><%=L.warranty%>:</b> <%=row.warranty_terms||'-'%></p></div></details><% if(showMoney){ %><article class="card totals-card"><div><span><%=L.total%></span><b><%=grossTotal.toFixed(2)%> <%=row.currency%></b></div><% if(Number(row.discount_total||0)>0){ %><div><span><%=L.discountTotal%></span><b>- <%=Number(row.discount_total||0).toFixed(2)%> <%=row.currency%></b></div><% } %><div><span><%=vatLabel%></span><b><%=Number(row.vat_total||0).toFixed(2)%> <%=row.currency%></b></div><div class="grand"><span><%=L.grandTotal%></span><b><%=Number(row.grand_total||0).toFixed(2)%> <%=row.currency%></b></div><% if(showTry&&row.currency!=='TRY'){ %><div><span><%=L.payableTry%></span><b><%=tryTotal.toFixed(2)%> TRY</b></div><% } %></article><% } %></section>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">try{
 const b=document.body,scope=[b?.dataset?.tenantId||'',b?.dataset?.userId||''].map(encodeURIComponent).join(':');
 localStorage.removeItem('crm-quote-draft-new');localStorage.removeItem('crm-quote-draft-<%=row.id%>');
 if(scope){localStorage.removeItem('crm-quote-draft-v2:'+scope+':new');localStorage.removeItem('crm-quote-draft-v2:'+scope+':<%=row.id%>')}
}catch{}</script>
