<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">window.QUOTE_BOOTSTRAP=<%- JSON.stringify({row:row||null,formInstanceId,csrfToken,profiles,templates,today,locale,defaults,termHistories}).replace(/</g,'\u003c') %>;</script>
<header class="page-head quote-pro-head"><div><span class="eyebrow">📄 PROFORMA</span><h1><%=title%></h1><p class="muted">Kurumsal teklif oluşturma ve müşteri bilgileri tek ekranda düzenlenir.</p></div><div class="page-head__actions"><a class="btn js-back" href="/quotes">← <%=t('back')%></a></div></header>
<form id="quoteForm" class="quote-pro-v58" method="post" action="/quotes/save" data-no-confirm data-quote-save-mode="<%=row?'update':'create'%>">
<input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="id" value="<%=row?.id||''%>"><input type="hidden" name="original_quote_id" value="<%=row?.id||''%>"><input type="hidden" name="form_instance_id" value="<%=formInstanceId%>"><input type="hidden" name="record_version" value="<%=row?.updated_at||''%>"><input type="hidden" id="itemsJson" name="items_json">
<% const c=row?.customer_snapshot||{}; %>
<section class="quote-top-grid">
  <section class="card customer-panel quote-customer-card quote-card-aligned"><div class="card-head"><div class="quote-customer-card__head-copy"><h2><%=t('customer_info')%></h2><% if(!row){ %><button class="quote-clear-trigger quote-clear-trigger--mini" type="button" data-modal-open="quoteClearModal" title="<%=locale==='en'?'Clear all entered proforma details':'Girilen tüm proforma bilgilerini temizle'%>"><span class="quote-clear-trigger__emoji" aria-hidden="true">🧹</span><span><%=locale==='en'?'Clear form':'Formu temizle'%></span></button><% } %></div><button class="quote-clear-trigger quote-clear-trigger--mini quote-customer-add-btn" type="button" data-modal-open="customerModal" title="<%=locale==='en'?'Add customer from proforma':'Proforma içinden müşteri ekle'%>"><span class="quote-clear-trigger__emoji" aria-hidden="true">➕</span><span><%=locale==='en'?'Proformadan Müşteri Ekle':'Proforma İçinden Müşteri Ekle'%></span></button></div>
    <div class="lookup"><input id="customerSearch" autocomplete="off" value="<%=c.company_name||''%>" placeholder="<%=t('search_customer_placeholder')%>"><div id="customerResults" class="suggest suggest--preview"></div></div><input type="hidden" id="customerId" name="customer_id" value="<%=row?.customer_id||''%>">
    <div id="customerSnapshot" class="snapshot-grid"></div>
    <details class="customer-edit customer-edit--compact" open data-address-scope><summary><%=locale==='en'?'Show / edit customer fields':'Müşteri kartındaki alanları göster / düzenle'%></summary><div class="form-grid">
      <label><%=t('customer_company')%><input name="customer_company_name" value="<%=c.company_name||''%>"></label><label><%=t('contact_name')%><input name="customer_contact_name" value="<%=c.contact_name||''%>" placeholder="<%=locale==='en'?'Full Name':'Ad Soyad'%>"></label><label><%=t('contact_title')%><input name="customer_contact_title" value="<%=c.contact_title||''%>" placeholder="<%=locale==='en'?'Title':'Unvan'%>"></label><label><%=t('phone')%><input name="customer_phone" value="<%=c.phone||''%>"></label><label><%=t('mobile')%><input name="customer_mobile" value="<%=c.mobile||''%>"></label><label><%=t('email')%><input name="customer_email" value="<%=c.email||''%>"></label><label><%=locale==='en'?'Website':'Web sitesi'%><input name="customer_website" value="<%=c.website||''%>"></label><label><%=t('tax_office')%><input name="customer_tax_office" value="<%=c.tax_office||''%>"></label><label><%=t('tax_no')%><input name="customer_tax_no" value="<%=c.tax_no||''%>"></label><label><%=t('country')%><input name="customer_country" data-tr-country value="<%=c.country||'Türkiye'%>"></label><label><%=t('city')%><input name="customer_city" data-tr-city value="<%=c.city||''%>"></label><label><%=t('district')%><input name="customer_district" data-tr-district value="<%=c.district||''%>"></label><label class="wide"><%=t('billing_address')%><input name="customer_billing_address" value="<%=c.billing_address||[c.address1,c.address2].filter(Boolean).join(' ')%>"></label><label class="wide"><%=t('delivery_address')%><input name="customer_delivery_address" value="<%=c.delivery_address||''%>"></label><input type="hidden" name="customer_note" value="<%=c.note||''%>">
    </div></details>
  </section>
  <aside class="quote-side-stack quote-card-aligned">
    <section class="card quote-side-card quote-info-v82-card">
      <div class="card-head quote-info-v82-head">
        <h2><span class="ui-ico ui-ico--doc" aria-hidden="true">📑</span><span><%=t('quote_info')%></span></h2>
        <span class="pill"><%=row?.quote_no||t('new_record')%></span>
      </div>
      <div class="quote-info-v82-grid">
        <label class="quote-field quote-field--no tf-quote-no"><span class="field-title"><span aria-hidden="true">🔢</span><span>Teklif numarası</span></span><input name="quote_no" maxlength="60" value="<%=row?.quote_no||''%>" placeholder="Otomatik oluşur, gerekirse değiştirilebilir"></label>
        <label class="quote-field tf-date"><span class="field-title"><span aria-hidden="true">📅</span><span><%=t('quote_date')%></span></span><input type="date" name="quote_date" required value="<%=row?.quote_date||today%>"></label>
        <label class="quote-field tf-valid"><span class="field-title"><span aria-hidden="true">⏳</span><span><%=t('valid_until')%></span></span><input type="date" name="valid_until" value="<%=row?.valid_until||defaultValidUntil%>"></label>
        <label class="quote-field tf-delivery"><span class="field-title"><span aria-hidden="true">🚚</span><span><%=t('delivery_date')%></span></span><input type="date" name="delivery_date" value="<%=row?.delivery_date||''%>"></label>
        <label class="quote-field tf-follow-date"><span class="field-title"><span aria-hidden="true">📌</span><span>Takip tarihi</span></span><input type="date" name="follow_up_date" value="<%=row?.follow_up_date||''%>"></label>
        <label class="quote-field quote-field--wide tf-follow-note"><span class="field-title"><span aria-hidden="true">📝</span><span>Takip notu</span></span><input name="follow_up_note" value="<%=row?.follow_up_note||''%>" placeholder="Müşteri aranacak / revize bekleniyor..."></label>
        <label class="quote-field tf-status"><span class="field-title"><span aria-hidden="true">🏷️</span><span><%=t('status')%></span></span><select name="status" disabled title="Durum süreç kartından değiştirilir."><% ['DRAFT','PREPARING','SENT','WAITING_CUSTOMER','REVISION_REQUESTED','APPROVED','REJECTED','EXPIRED','ORDERED','DELIVERED','ARCHIVED'].forEach(x=>{ %><option value="<%=x%>" <%=row?.status===x?'selected':''%>><%=statusLabel(x)%></option><% }) %></select></label>
        <div class="quote-fx-row">
          <label class="quote-field tf-currency"><span class="field-title"><span aria-hidden="true">💱</span><span><%=t('currency')%></span></span><select name="currency" id="quoteCurrency"><% ['TRY','EUR','USD'].forEach(x=>{ %><option <%=row?.currency===x?'selected':''%>><%=x%></option><% }) %></select></label>
          <label class="quote-field tf-rate"><span class="field-title"><span aria-hidden="true">📈</span><span><%=t('fx_rate')%></span></span><div class="fx-rate-tools fx-rate-tools--v82"><input id="quoteFxRate" type="number" min="0" step="0.0001" name="fx_rate" value="<%=row?.fx_rate||1%>"><button class="btn btn--sm btn--primary fx-refresh-btn" id="refreshFxRate" type="button" aria-label="<%=locale==='en'?'Refresh rate':'Kuru yenile'%>" title="<%=locale==='en'?'Refresh current TCMB rate':'Güncel TCMB kurunu yenile'%>"><span aria-hidden="true">🔄</span></button></div><small class="fx-rate-status" id="fxRateStatus"></small></label>
        </div>
        <input id="quoteFxDate" type="hidden" name="fx_date" value="<%=row?.fx_date||today%>">
        <input id="quoteFxSource" type="hidden" name="fx_source" value="<%=String(row?.fx_source||'TCMB').toUpperCase()%>">
        <label class="quote-field tf-try-total"><span class="field-title"><span aria-hidden="true">₺</span><span>TRY ödenecek tutar</span></span><select name="show_try_total" id="showTryTotal"><option value="1" <%=String(row?.show_try_total??1)!=='0'?'selected':''%>>Göster</option><option value="0" <%=String(row?.show_try_total??1)==='0'?'selected':''%>>Gizle</option></select><small class="field-hint">PDF ve ön izlemede yabancı para tekliflerin TL karşılığını aç/kapatır.</small></label>
        <label class="quote-field tf-project-name"><span class="field-title"><span aria-hidden="true">📁</span><span><%=t('project_name')%></span></span><input name="project_name" value="<%=row?.project_name||''%>"></label>
        <label class="quote-field tf-project-code"><span class="field-title"><span aria-hidden="true">#️⃣</span><span><%=t('project_code')%></span></span><input name="project_code" value="<%=row?.project_code||''%>"></label>
        <label class="quote-field quote-field--wide tf-subject"><span class="field-title"><span aria-hidden="true">🎯</span><span><%=t('subject')%></span></span><input name="subject" value="<%=row?.subject||''%>"></label>
        <input type="hidden" name="description" value="<%=row?.description||''%>">
      </div>
    </section>
    <section class="card quote-side-card quote-template-card"><div class="card-head"><h2>🏢 <%=t('company_template')%></h2></div><label>🏢 <%=t('active_company')%><select name="profile_id" id="quoteProfileSelect"><% profiles.forEach(p=>{ %><option value="<%=p.id%>" <%=row?.profile_id===p.id||(!row&&p.is_active)?'selected':''%>><%=p.short_name||p.company_name%></option><% }) %></select></label><label>🎨 <%=t('quote_template')%><select name="template_key" id="quoteTemplateSelect"><% templates.forEach(tpl=>{ %><option value="<%=tpl.template_key%>" data-id="<%=tpl.id%>" data-layout="<%=tpl.layout_key%>" data-primary="<%=tpl.primary_color%>" data-accent="<%=tpl.accent_color%>" data-description="<%=tpl.description||''%>" <%=row?.template_key===tpl.template_key||(!row&&tpl.is_default)?'selected':''%>><%=tpl.name%></option><% }) %></select></label><div class="quote-template-preview-wrap"><div id="quoteTemplateLivePreview" class="template-mini quote-template-live-preview"><header><i></i><b></b></header><aside></aside><main><strong>PROFORMA</strong><small class="mini-product"><%=locale==='en'?'Sample product':'Örnek ürün'%></small><small class="mini-description"><%=locale==='en'?'Sample description':'Örnek açıklama'%></small><span></span><table><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr></table></main><footer></footer></div><small id="quoteTemplatePreviewText" class="muted"></small><button id="quoteTemplateFullPreview" class="btn btn--soft btn--block btn--sm" type="button">👁 <%=locale==='en'?'Preview selected template':'Seçili şablonu ön izle'%></button></div><button id="openQuoteTemplateGallery" class="btn btn--soft btn--block btn--sm" type="button"><%=t('template_gallery')%></button></section>
  </aside>
</section>
<section class="card quote-lines-card quote-lines-card--v90 quote-lines-workspace-v11"><div class="card-head quote-lines-toolbar-v11" id="quoteLinesToolbar"><div class="quote-lines-toolbar-title-v11"><h2><%=t('product_rows')%></h2><div class="quote-lines-live-summary-v11" aria-live="polite"><span><b id="quoteStickyItemCount">0</b> <%=locale==='en'?'products':'ürün'%></span><span><b id="quoteStickyNetTotal">0,00</b> <span id="quoteStickyCurrency"><%=row?.currency||'TRY'%></span></span></div></div><div class="row-actions quote-row-actions"><button class="btn btn--sm btn--soft quote-row-create-btn" type="button" id="addBlank"><span class="quote-action-emoji" aria-hidden="true">➕</span><%=locale==='en'?'Empty Line':'Boş Satır'%></button><button class="btn btn--sm btn--soft quote-row-create-btn" type="button" id="addAlternativeRow"><span class="quote-action-emoji" aria-hidden="true">🔄</span>Muadil Ürün Ekle</button><button class="btn btn--sm btn--soft quote-row-create-btn" type="button" data-modal-open="productModal"><span class="quote-action-emoji" aria-hidden="true">⚡</span><%=locale==='en'?'Quick Add Product':'Hızlı Ürün Ekle'%></button></div></div><div class="table-scroll quote-items-scroll"><table class="quote-items quote-items--v90"><colgroup><col class="col-image"><col class="col-code"><col class="col-main"><col class="col-qty"><col class="col-unit"><col class="col-price"><col class="col-discount"><col class="col-vat"><col class="col-total"><col class="col-actions"></colgroup><thead><tr><th><%=t('image')%></th><th><%=locale==='en'?'Product Code':'Ürün Kodu'%></th><th><%=locale==='en'?'Product Name and Description':'Ürün Adı ve Açıklama'%></th><th><%=t('quantity')%></th><th><%=t('unit')%></th><th><%=t('unit_price')%></th><th><%=t('discount')%></th><th><%=t('vat')%></th><th><%=t('total')%><small class="block muted">(<%=locale==='en'?'excl. VAT':'KDV’siz'%>)</small></th><th class="quote-actions-head"><%=locale==='en'?'Actions':'İşlemler'%></th></tr></thead><tbody id="quoteItems"></tbody></table></div><div class="quote-total"><div><small id="subtotalLabel"><%=t('subtotal')%></small><b id="subtotal">0,00</b></div><div class="quote-total-discount-card"><small><%=t('discount')%></small><b id="discountTotal">0,00</b></div><div><small id="vatTotalLabel"><%=t('vat')%> %20</small><b id="vatTotal">0,00</b></div><div class="grand"><small><%=t('grand_total')%></small><b><span id="grandTotal">0,00</span> <span id="grandCurrency"><%=row?.currency||'TRY'%></span></b><small id="tryEquivalent"></small></div></div><details class="quote-global-discount" id="quoteGlobalDiscountPanel" <%=Number(row?.quote_discount_value||0)>0?'open':''%>><summary><span>🏷️ <%=locale==='en'?'Discount on total amount':'Toplam Tutar Üzerinden İndirim'%></span><small id="quoteGlobalDiscountStatus"><%=Number(row?.quote_discount_value||0)>0?(locale==='en'?'Applied':'Uygulandı'):(locale==='en'?'Optional':'İsteğe bağlı')%></small></summary><div class="quote-global-discount__body"><label><span><%=locale==='en'?'Discount method':'İndirim şekli'%></span><select name="quote_discount_type" id="quoteDiscountType"><option value="PERCENT" <%=String(row?.quote_discount_type||'PERCENT').toUpperCase()!=='AMOUNT'?'selected':''%>>%</option><option value="AMOUNT" <%=String(row?.quote_discount_type||'PERCENT').toUpperCase()==='AMOUNT'?'selected':''%>><%=locale==='en'?'Amount':'Tutar'%></option></select></label><label><span><%=locale==='en'?'Discount value':'İndirim değeri'%></span><input name="quote_discount_value" id="quoteDiscountValue" type="number" min="0" step="0.01" inputmode="decimal" value="<%=Number(row?.quote_discount_value||0)%>" placeholder="0"></label><div class="quote-global-discount__applied"><small><%=locale==='en'?'Applied total discount':'Uygulanan toplam indirim'%></small><b><span id="quoteDiscountApplied">0,00</span> <span id="quoteDiscountCurrency"><%=row?.currency||'TRY'%></span></b></div><button class="btn btn--soft btn--sm" id="clearQuoteDiscount" type="button"><%=locale==='en'?'Clear discount':'İndirimi temizle'%></button></div></details><div class="quote-save-inline"><span id="draftState"><%=t('draft_local')%></span><button class="btn btn--primary btn--lg"><%=t('save_quote')%></button></div></section>
<% const termSelectText=locale==='en'?'Select a saved or previously used text':'Hazır metin veya önceki kayıtlardan seçin'; const termDeleteText=locale==='en'?'Delete suggested text':'Önerilen metni sil'; %>
<details class="card terms-collapse quote-mini-collapse"><summary><span><i aria-hidden="true">▾</i><%=t('terms')%></span><small><%=locale==='en'?'Open / close':'Aç / kapat'%></small></summary><div class="terms-form-grid">
<label class="term-combo"><b><%=t('payment_terms')%></b><select data-fill-next><option value=""><%=termSelectText%></option><% (termHistories.payment_terms||[]).forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><div class="term-suggestion-list" data-term-chips="payment_terms"><% (termHistories.payment_terms||[]).forEach(o=>{ %><span class="term-chip" title="<%=o%>"><button type="button" data-term-use="payment_terms" data-value="<%=o%>"><%=o%></button><button class="term-chip-x" type="button" data-term-delete="payment_terms" data-value="<%=o%>" title="<%=termDeleteText%>" aria-label="<%=termDeleteText%>">×</button></span><% }) %></div><textarea data-auto-grow name="payment_terms" rows="3"><%=row?.payment_terms||defaults.payment_terms_default||''%></textarea></label>
<label class="term-combo"><b><%=t('delivery_terms')%></b><select data-fill-next><option value=""><%=termSelectText%></option><% (termHistories.delivery_terms||[]).forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><div class="term-suggestion-list" data-term-chips="delivery_terms"><% (termHistories.delivery_terms||[]).forEach(o=>{ %><span class="term-chip" title="<%=o%>"><button type="button" data-term-use="delivery_terms" data-value="<%=o%>"><%=o%></button><button class="term-chip-x" type="button" data-term-delete="delivery_terms" data-value="<%=o%>" title="<%=termDeleteText%>" aria-label="<%=termDeleteText%>">×</button></span><% }) %></div><textarea data-auto-grow name="delivery_terms" rows="3"><%=row?.delivery_terms||defaults.delivery_terms_default||''%></textarea></label>
<label class="term-combo"><b><%=locale==='en'?'Shipping / delivery method':'Nakliye / teslim şekli'%></b><select data-fill-next><option value=""><%=termSelectText%></option><% (termHistories.shipping_terms||[]).forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><div class="term-suggestion-list" data-term-chips="shipping_terms"><% (termHistories.shipping_terms||[]).forEach(o=>{ %><span class="term-chip" title="<%=o%>"><button type="button" data-term-use="shipping_terms" data-value="<%=o%>"><%=o%></button><button class="term-chip-x" type="button" data-term-delete="shipping_terms" data-value="<%=o%>" title="<%=termDeleteText%>" aria-label="<%=termDeleteText%>">×</button></span><% }) %></div><textarea data-auto-grow name="shipping_terms" rows="3"><%=row?.shipping_terms||defaults.shipping_terms_default||''%></textarea></label>
<label class="term-combo"><b><%=locale==='en'?'Installation and training':'Kurulum ve eğitim'%></b><select data-fill-next><option value=""><%=termSelectText%></option><% (termHistories.installation_terms||[]).forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><div class="term-suggestion-list" data-term-chips="installation_terms"><% (termHistories.installation_terms||[]).forEach(o=>{ %><span class="term-chip" title="<%=o%>"><button type="button" data-term-use="installation_terms" data-value="<%=o%>"><%=o%></button><button class="term-chip-x" type="button" data-term-delete="installation_terms" data-value="<%=o%>" title="<%=termDeleteText%>" aria-label="<%=termDeleteText%>">×</button></span><% }) %></div><textarea data-auto-grow name="installation_terms" rows="3"><%=row?.installation_terms||defaults.installation_terms_default||''%></textarea></label>
<label class="term-combo"><b><%=t('warranty')%></b><select data-fill-next><option value=""><%=termSelectText%></option><% (termHistories.warranty_terms||[]).forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><div class="term-suggestion-list" data-term-chips="warranty_terms"><% (termHistories.warranty_terms||[]).forEach(o=>{ %><span class="term-chip" title="<%=o%>"><button type="button" data-term-use="warranty_terms" data-value="<%=o%>"><%=o%></button><button class="term-chip-x" type="button" data-term-delete="warranty_terms" data-value="<%=o%>" title="<%=termDeleteText%>" aria-label="<%=termDeleteText%>">×</button></span><% }) %></div><textarea data-auto-grow name="warranty_terms" rows="5"><%=row?.warranty_terms||defaults.warranty_terms_default||''%></textarea></label>
<label class="term-combo"><b><%=t('legal_note')%></b><select data-fill-next><option value=""><%=termSelectText%></option><% (termHistories.legal_terms||[]).forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><div class="term-suggestion-list" data-term-chips="legal_terms"><% (termHistories.legal_terms||[]).forEach(o=>{ %><span class="term-chip" title="<%=o%>"><button type="button" data-term-use="legal_terms" data-value="<%=o%>"><%=o%></button><button class="term-chip-x" type="button" data-term-delete="legal_terms" data-value="<%=o%>" title="<%=termDeleteText%>" aria-label="<%=termDeleteText%>">×</button></span><% }) %></div><textarea data-auto-grow name="legal_note" rows="5"><%=row?.legal_note||defaults.legal_terms_default||''%></textarea></label>
<label class="term-combo wide"><b><%=t('extra_note')%></b><textarea data-auto-grow name="extra_note" rows="4"><%=row?.extra_note||''%></textarea></label></div></details><% const fp=row?.profile_snapshot||profiles.find(p=>p.id===row?.profile_id)||profiles.find(p=>p.is_active)||{}; %><details class="card quote-footer-config-preview quote-mini-collapse quote-footer-v82"><summary><span><i aria-hidden="true">▾</i><span class="footer-color-ico">🧾</span>PDF Sabit Alt Bilgi</span><small><%=locale==='en'?'Open / close':'Aç / kapat'%></small></summary><p class="muted"><%=locale==='en'?'The active company profile is filled automatically. You can override the values for this proforma only.':'Aktif firma profilindeki bilgiler otomatik gelir. Bu proformaya özel olarak aşağıdaki alanları elle değiştirebilirsiniz.'%></p><div class="form-grid quote-footer-edit-grid"><label class="wide"><span class="field-title"><span class="footer-color-ico footer-color-ico--addr">📍</span><span><%=locale==='en'?'Footer address':'Alt bilgi adresi'%></span></span><input name="footer_address" value="<%=fp.footer_address||fp.address||''%>" placeholder="Adres"></label><label><span class="field-title"><span class="footer-color-ico footer-color-ico--mail">✉️</span><span><%=locale==='en'?'Footer e-mail':'Alt bilgi e-posta'%></span></span><input name="footer_email" value="<%=fp.footer_email||fp.email||''%>" placeholder="E-posta"></label><label><span class="field-title"><span class="footer-color-ico footer-color-ico--phone">☎️</span><span><%=locale==='en'?'Footer phone':'Alt bilgi telefon'%></span></span><input name="footer_phone" value="<%=fp.footer_phone||fp.phone||fp.mobile||''%>" placeholder="Telefon"></label></div><div class="quote-footer-preview-line quote-footer-preview-v82"><span id="footerPreviewAddress"><b>📍</b></span><span id="footerPreviewEmail"><b>✉️</b></span><span id="footerPreviewPhone"><b>☎️</b></span></div></details><aside class="quote-check-assistant" id="quoteCheckAssistant" aria-live="polite"><div class="quote-check-assistant__head"><div><span>🛡️</span><div><b>Teklif Kontrol Asistanı</b><small>Kaydetmeden önce kritik alanları kontrol eder.</small></div></div><button type="button" class="btn btn--soft btn--sm" id="runQuoteCheck">Kontrol Et</button></div><div class="quote-check-assistant__body" id="quoteCheckResults"><p class="muted">Müşteri, ürün, fiyat, KDV, para birimi, teslimat, ödeme ve geçerlilik alanları denetlenecek.</p></div></aside></form>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">document.querySelectorAll('[data-fill-next]').forEach(s=>s.addEventListener('change',()=>{if(s.value){const ta=s.closest('.term-combo')?.querySelector('textarea');if(ta){ta.value=s.value;ta.dispatchEvent(new Event('input',{bubbles:true}))}}}));</script>

<% if(!row){ %><div class="modal quote-clear-modal" id="quoteClearModal" aria-hidden="true"><div class="modal-card quote-clear-modal__card"><button type="button" class="modal-close" data-modal-close aria-label="<%=locale==='en'?'Close':'Kapat'%>">×</button><div class="quote-clear-modal__icon" aria-hidden="true">🧹✨</div><h2><%=locale==='en'?'Clear proforma form?':'Proforma Bilgilerini Temizle'%></h2><p><%=locale==='en'?'Customer details, quotation fields, product rows, notes and the locally auto-saved draft will be cleared. Company defaults will remain available.':'Müşteri bilgileri, proforma alanları, ürün satırları, notlar ve otomatik kaydedilen yerel taslak temizlenecektir. Firma varsayılanları korunacaktır.'%></p><div class="form-actions quote-clear-modal__actions"><button class="btn" type="button" data-modal-close><%=locale==='en'?'Cancel':'Vazgeç'%></button><button class="btn btn--danger" id="confirmClearQuoteForm" type="button"><span aria-hidden="true">✨</span><%=locale==='en'?'Yes, clear the form':'Evet, Formu Temizle'%></button></div></div></div><% } %>
<div class="modal" id="customerModal"><div class="modal-card"><button type="button" class="modal-close" data-modal-close>×</button><h2><%=t('quick_customer')%></h2><p><%=t('quick_customer_note')%></p><form id="quickCustomer" class="form-grid" data-address-scope><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label><%=t('customer_company')%><input required name="company_name"></label><label><%=t('contact_name')%><input name="contact_name" placeholder="<%=locale==='en'?'Full Name':'Ad Soyad'%>"></label><label><%=t('contact_title')%><input name="contact_title" placeholder="<%=locale==='en'?'Title':'Unvan'%>"></label><label><%=t('phone')%><input name="phone"></label><label><%=t('mobile')%><input name="mobile"></label><label><%=t('email')%><input name="email"></label><label><%=t('tax_office')%><input name="tax_office"></label><label><%=t('tax_no')%><input name="tax_no"></label><label><%=t('country')%><input name="country" data-tr-country value="Türkiye"></label><label><%=t('city')%><input name="city" data-tr-city></label><label><%=t('district')%><input name="district" data-tr-district></label><label class="wide"><%=t('billing_address')%><input name="billing_address"></label><label class="wide"><%=t('delivery_address')%><input name="delivery_address"></label><label class="wide"><%=t('note')%><textarea data-auto-grow name="note"></textarea></label><div class="wide form-actions"><button class="btn btn--primary"><%=t('save_transfer')%></button></div></form></div></div>
<div class="modal quick-product-modal-v16" id="productModal" role="dialog" aria-modal="true" aria-labelledby="quickProductModalTitle" aria-hidden="true">
 <div class="modal-card quick-product-modal-card quick-product-modal-card-v16">
  <header class="quick-product-head-v16">
   <div class="quick-product-head-icon-v16" aria-hidden="true">⚡</div>
   <div><span class="eyebrow"><%=locale==='en'?'PRODUCT LIBRARY':'ÜRÜN KÜTÜPHANESİ'%></span><h2 id="quickProductModalTitle"><%=t('quick_product')%></h2><p><%=locale==='en'?'Create a complete product card and transfer it directly to the current proforma line.':'Eksiksiz bir ürün kartı oluşturun ve doğrudan mevcut proforma satırına aktarın.'%></p></div>
   <button type="button" class="modal-close" data-modal-close aria-label="<%=locale==='en'?'Close':'Kapat'%>">×</button>
  </header>
  <form id="quickProduct" class="quick-product-form-v16" enctype="multipart/form-data">
   <input type="hidden" name="_csrf" value="<%=csrfToken%>">
   <section class="quick-product-media-v16">
    <label class="quick-product-image-field quick-product-image-field-v16"><span class="field-title">🖼️ <%=t('product_image')%></span><input id="quickProductImage" name="image" type="file" accept="image/jpeg,image/png,image/webp"><span class="quick-product-image-preview"><img id="quickProductImagePreview" alt="" hidden><span id="quickProductImageEmpty"><%=locale==='en'?'The selected image will appear here live.':'Seçilen görsel burada canlı olarak gösterilir.'%></span></span><small>JPG, PNG veya WEBP</small></label>
    <div class="quick-product-documents-v16">
     <label><span>📎 <%=t('brochure_pdf')%></span><input name="brochure" type="file" accept="application/pdf"></label>
     <label><span>📄 <%=locale==='en'?'CE Certificate PDF':'CE Belgesi PDF'%></span><input name="ce_certificate" type="file" accept="application/pdf"></label>
     <label><span>📘 <%=locale==='en'?'User Manual PDF':'Kullanma Kılavuzu PDF'%></span><input name="user_manual" type="file" accept="application/pdf"></label>
    </div>
   </section>
   <section class="quick-product-fields-v16">
    <div class="quick-product-section-title-v16"><span>01</span><div><b><%=locale==='en'?'Product identity':'Ürün kimliği'%></b><small><%=locale==='en'?'Code, name and customs information':'Kod, ad ve gümrük bilgileri'%></small></div></div>
    <div class="quick-product-grid-v16">
     <label><span>🔢 <%=locale==='en'?'Product code':'Ürün kodu'%></span><input required name="code" autocomplete="off"></label>
     <label class="span-2"><span>📦 <%=locale==='en'?'Product name':'Ürün adı'%></span><input required name="name" autocomplete="off"></label>
     <label><span>🏷️ <%=locale==='en'?'GTIP number':'GTİP numarası'%></span><input name="gtip_no" placeholder="8419.89.98.90.19"></label>
     <label><span>🌍 <%=locale==='en'?'Country of origin':'Menşei'%></span><input name="origin_country" placeholder="<%=locale==='en'?'Country':'Ülke'%>"></label>
    </div>
    <div class="quick-product-section-title-v16"><span>02</span><div><b><%=locale==='en'?'Commercial information':'Ticari bilgiler'%></b><small><%=locale==='en'?'Price, currency, unit and VAT':'Fiyat, para birimi, birim ve KDV'%></small></div></div>
    <div class="quick-product-grid-v16 quick-product-commercial-v16">
     <label><span>💰 <%=locale==='en'?'Sale price':'Satış fiyatı'%></span><input name="sale_price" type="number" min="0" step="0.01" inputmode="decimal"></label>
     <label><span>💱 <%=t('currency')%></span><select name="currency"><option>TRY</option><option>EUR</option><option>USD</option></select></label>
     <label><span>📏 <%=t('unit')%></span><input name="unit" value="ADET"></label>
     <label><span>% <%=t('vat')%></span><input name="vat_rate" value="20" type="number" min="0" step="0.01"></label>
    </div>
    <label class="quick-product-description-v16"><span>📝 <%=locale==='en'?'Product description':'Ürün açıklaması'%></span><textarea name="description_combined" rows="5" data-auto-grow placeholder="<%=locale==='en'?'Technical features, scope and important notes':'Teknik özellikler, kapsam ve önemli notlar'%>"></textarea></label>
   </section>
   <footer class="quick-product-footer-v16"><p><%=locale==='en'?'Unsaved entries remain in this window until the page is closed.':'Kaydetmeden pencereyi kapatırsanız yarım kalan bilgiler sayfa kapanana kadar korunur.'%></p><div><button class="btn btn--soft" type="button" data-modal-close><%=locale==='en'?'Continue later':'Sonra devam et'%></button><button class="btn btn--primary" type="submit">💾 <%=t('save_line')%></button></div></footer>
  </form>
 </div>
</div>

<div class="modal" id="lineEditModal"><div class="modal-card line-edit-modal"><button type="button" class="modal-close" data-modal-close>×</button><h2><%=locale==='en'?'Edit quotation line':'Proforma Satırını Düzenle'%></h2><p class="muted"><%=locale==='en'?'When a saved product is edited here, the master product record is updated. Direct edits made in the quotation row remain quotation-specific.':'Kayıtlı ürün burada düzenlenirse ana ürün kaydı da güncellenir. Satır üzerinde doğrudan yapılan değişiklikler yalnızca bu proformaya özel kalır.'%></p><form id="lineEditForm" class="form-grid"><input type="hidden" id="lineEditIndex"><label class="line-edit-preview-label"><%=t('product_image')%><span class="line-edit-preview"><img id="lineEditImagePreview" alt=""><span id="lineEditImageEmpty"><%=locale==='en'?'No image':'Görsel yok'%></span></span></label><label><%=locale==='en'?'Select a new image':'Yeni görsel seç'%><input id="lineEditImage" type="file" accept="image/jpeg,image/png,image/webp"></label><label class="wide"><%=locale==='en'?'Image URL':'Görsel URL'%><input id="lineEditImageUrl" type="text" placeholder="/public/uploads/products/... veya https://..."></label><label><%=locale==='en'?'Product code':'Ürün kodu'%><input id="lineEditCode" required></label><label>GTİP numarası<input id="lineEditGtip"></label><label>Menşei<input id="lineEditOrigin"></label><label><%=locale==='en'?'Product name':'Ürün adı'%><input id="lineEditName" required></label><label><%=locale==='en'?'Sale price':'Satış fiyatı'%><input id="lineEditPrice" type="number" min="0" step="0.01"></label><label class="tf-currency">💱 <%=t('currency')%><select id="lineEditCurrency"><option>TRY</option><option>EUR</option><option>USD</option></select></label><label><%=t('unit')%><input id="lineEditUnit" value="ADET"></label><label><%=t('vat')%><input id="lineEditVat" type="number" min="0" step="0.01" value="20"></label><label class="wide"><%=locale==='en'?'Product description':'Ürün açıklaması'%><textarea id="lineEditDescription" rows="3" data-auto-grow></textarea></label><label><%=t('brochure_pdf')%><input id="lineEditBrochure" type="file" accept="application/pdf"></label><label><%=t('brochure_pdf')%> URL<input id="lineEditBrochureUrl" type="text" placeholder="/public/uploads/products/...pdf veya https://..."></label><label>CE Belgesi PDF<input id="lineEditCeCertificate" type="file" accept="application/pdf"></label><label>CE Belgesi URL<input id="lineEditCeCertificateUrl" type="text" placeholder="/public/uploads/products/...pdf veya https://..."></label><label>Kullanma Kılavuzu PDF<input id="lineEditUserManual" type="file" accept="application/pdf"></label><label>Kullanma Kılavuzu URL<input id="lineEditManualUrl" type="text" placeholder="/public/uploads/products/...pdf veya https://..."></label><div class="wide form-actions"><button type="button" class="btn" data-modal-close><%=locale==='en'?'Cancel':'Vazgeç'%></button><button class="btn btn--primary"><%=locale==='en'?'Save line changes':'Satır Değişikliklerini Kaydet'%></button></div></form></div></div>

<div class="modal quote-template-gallery-modal" id="quoteTemplateGalleryModal" aria-hidden="true"><div class="modal-card quote-template-gallery-card"><button type="button" class="modal-close" data-modal-close>×</button><div class="quote-template-gallery-head"><div><h2><%=locale==='en'?'Select Proforma Template':'Proforma Şablonu Seç'%></h2><p><%=locale==='en'?'Review the current quotation with each template and approve your choice.':'Mevcut proforma bilgileriyle şablonu inceleyin ve seçiminizi onaylayın.'%></p></div><button class="btn btn--primary btn--sm" type="button" id="acceptQuoteTemplate">✓ <%=locale==='en'?'Accept template':'Tasarımı Kabul Et'%></button></div><div class="quote-template-gallery-grid"><aside class="quote-template-choice-list"><% templates.forEach(tpl=>{ %><button type="button" class="quote-template-choice" data-template-choice="<%=tpl.template_key%>"><span class="template-mini layout-<%=tpl.layout_key%>" data-csp-style="--p:<%=tpl.primary_color%>;--a:<%=tpl.accent_color%>"><header><i></i><b></b></header><aside></aside><main><strong>PROFORMA</strong><small class="mini-product"><%=locale==='en'?'Sample product':'Örnek ürün'%></small><small class="mini-description"><%=locale==='en'?'Sample description':'Örnek açıklama'%></small><span></span><table><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr></table></main><footer></footer></span><span><b><%=tpl.name%></b><small><%=tpl.description||''%></small></span></button><% }) %></aside><section class="quote-template-applied-preview"><div class="card-head"><h2><%=locale==='en'?'Live A4 Preview':'Canlı A4 Ön İzleme'%></h2><small id="quoteTemplateGalleryStatus"><%=locale==='en'?'Preparing preview…':'Ön izleme hazırlanıyor…'%></small></div><iframe id="quoteTemplateAppliedFrame" title="Proforma şablon ön izlemesi"></iframe></section></div></div></div>
