<article id="print-source" class="a4 print-source" aria-hidden="true">
<header class="document-title"><h1><%=t('proforma_offer')%></h1></header>
<section class="print-top-grid">
 <div class="company-card"><% if(p.logo_url){ %><div class="company-logo-zone-v21"><% if(typeof templateStudioPreview!=='undefined'&&templateStudioPreview){ const logoPositionLabel={left:'SOL',center:'ORTA',right:'SAĞ',floating:'METİN YANINDA'}[templateSettings?.logo_position]||'SOL'; %><span class="template-draft-logo-label-v21">LOGO · <%=logoPositionLabel%></span><% } %><img class="company-logo" src="<%=p.logo_url%>" alt="Firma logosu" data-empty-image-on-error></div><% } %><dl><dt><%=t('company_name')%></dt><dd><%=p.company_name||'-'%></dd><dt><%=t('phone')%></dt><dd><%=p.phone||p.mobile||'-'%></dd><dt><%=t('email')%></dt><dd><%=p.email||'-'%></dd><dt><%=t('tax_office_no')%></dt><dd><%=[p.tax_office,p.tax_no].filter(Boolean).join(' / ')||'-'%></dd><dt><%=locale==='en'?'Address':'Adres'%></dt><dd><%=profileAddress||'-'%></dd></dl></div>
 <div class="meta-card"><div class="serial"><span><%=t('serial_no')%>:</span><b><%=displayNo%></b></div><dl><dt><%=t('subject')%></dt><dd><%=row.subject||'-'%></dd><dt><%=t('prepared_by')%></dt><dd><%=p.authorized_person||'-'%></dd><dt><%=t('issue_date')%></dt><dd><%=row.quote_date||'-'%></dd><dt><%=t('validity')%></dt><dd><%=row.valid_until||'-'%></dd><dt><%=t('currency')%></dt><dd><%=row.currency%><% if(Number(row.fx_rate)!==1){ %> · <%=t('fx_rate')%>: 1 = <%=row.fx_rate%> ₺<% } %></dd></dl></div>
</section>
<section class="customer-card"><header><h2><%=t('requesting_company')%></h2><div><b><%=t('project_name')%>:</b> <%=row.project_name||'—'%><br><b><%=t('project_code')%>:</b> <%=row.project_code||'—'%></div></header><dl><dt><%=locale==='en'?'Title':'Ünvan'%></dt><dd><%=c.company_name||'-'%></dd><dt><%=t('contact_name')%></dt><dd><%=c.contact_name||'-'%></dd><dt><%=t('tax_no')%></dt><dd><%=c.tax_no||'-'%></dd><dt><%=locale==='en'?'Address':'Adres'%></dt><dd><%=customerAddress||'-'%></dd><dt><%=t('phone')%></dt><dd><%=c.phone||c.mobile||'-'%></dd><dt><%=t('email')%></dt><dd><%=c.email||'-'%></dd></dl></section>
<section class="items-section"><table class="print-items"><thead><tr><th><%=t('image')%></th><th><%=locale==='en'?'Product Code':'Ürün Kodu'%></th><th><%=t('product_name_desc')%></th><th><%=t('quantity')%></th><th><%=t('unit')%></th><th><%=t('unit_price')%></th><th class="print-discount-col" <%=hasLineDiscount?'':'hidden'%>><%=t('discount')%></th><th><%=t('tax')%></th><th><%=t('total_ex_vat')%></th></tr></thead><tbody><% row.items.forEach((i,n)=>{const x=i.product_snapshot||{}; %><tr><td class="print-image"><% if(i.show_image&&x.image_url){ %><img src="<%=x.image_url%>" alt="" data-empty-image-on-error><% } %><% if(x.origin_country){ %><small class="print-origin"><%=locale==='en'?'Origin':'Menşei'%>: <%=x.origin_country%></small><% } %></td><td class="print-code"><b><%=x.code||'-'%></b><% if(x.gtip_no){ %><small class="print-gtip">GTİP: <%=x.gtip_no%></small><% } %><% if(x.brochure_url){ %><a href="<%=publicDocumentHref(x.brochure_url)%>" target="_blank" rel="noopener"><%=t('download_brochure')%></a><% } %><% if(x.ce_certificate_url){ %><a href="<%=publicDocumentHref(x.ce_certificate_url)%>" target="_blank" rel="noopener">CE Belgesi</a><% } %><% if(x.manual_url){ %><a href="<%=publicDocumentHref(x.manual_url)%>" target="_blank" rel="noopener">Kullanma Kılavuzu</a><% } %></td><td class="print-description"><% if(Number(i.is_alternative||0)===1&&templateSettings?.show_alternative_badge!==false){ %><span class="quote-alternative-print-badge-v370"><%=locale==='en'?'ALTERNATIVE PRODUCT':'MUADİL ÜRÜN'%></span><% } %><b><%=String(x.name||'-').toLocaleUpperCase(locale==='en'?'en-GB':'tr-TR')%></b><% const fullDescription=[x.short_description,x.technical_description].filter(Boolean).join('\n'); if(fullDescription){ %><small><%=String(fullDescription).toLocaleUpperCase(locale==='en'?'en-GB':'tr-TR')%></small><% } %><% if(Number(i.is_alternative||0)===1){ %><span class="quote-alternative-detail-v370"><b><%=locale==='en'?'Alternative to':'Muadili olduğu ürün'%>:</b> <%=i.alternative_to_name||'-'%><% if(i.alternative_note){ %><br><%=i.alternative_note%><% } %></span><% if(Number(i.include_total??1)!==1){ %><span class="quote-optional-v370"><%=locale==='en'?'Not included in total':'Genel toplama dahil değildir'%></span><% } %><% } %></td><td><%=formatPrintQuantity(i.quantity)%></td><td><%=i.unit||'-'%></td><td class="print-money-cell-v3819"><span class="print-money-v3819"><span><%=formatPrintAmount(i.unit_price)%></span><small><%=row.currency%></small></span></td><td class="print-discount-col <%=Number(i.discount_value||0)>0?'print-discount has-discount print-money-cell-v3819':''%>" <%=hasLineDiscount?'':'hidden'%>><% if(Number(i.discount_value||0)>0){ %><span class="print-money-v3819"><span><%=formatPrintAmount(i.discount_value)%></span><small><%=i.discount_type==='PERCENT'?'%':row.currency%></small></span><% }else{ %>—<% } %></td><td><%=i.vat_rate%>%</td><td class="print-money-cell-v3819"><span class="print-money-v3819"><span><%=formatPrintAmount(i.line_net)%></span><small><%=row.currency%></small></span></td></tr><% }) %></tbody></table></section>
<section class="totals totals--reference"><div><span>Toplam</span><b class="print-money-v3819"><span><%=formatPrintAmount(grossTotal)%></span><small><%=row.currency%></small></b></div><% if(Number(row.discount_total||0)>0){ %><div class="discount-total"><span>İndirim / İskonto</span><b class="print-money-v3819"><span>- <%=formatPrintAmount(row.discount_total)%></span><small><%=row.currency%></small></b></div><% } %><div><span><%=vatLabel%></span><b class="print-money-v3819"><span><%=formatPrintAmount(row.vat_total)%></span><small><%=row.currency%></small></b></div><div class="grand"><span>Genel Toplam</span><b class="print-money-v3819"><span><%=formatPrintAmount(row.grand_total)%></span><small><%=row.currency%></small></b></div><% if(showTry&&row.currency!=='TRY'&&Number(row.fx_rate)>0){ %><div class="payable"><span><%=t('payable_try')%></span><b class="print-money-v3819"><span><%=formatPrintAmount(tryTotal)%></span><small>₺</small></b></div><% } %></section>
<section class="final-page-block"><section class="terms-card"><header><h2><%=t('terms_title')%></h2><span><%=t('serial_no')%>: <b><%=displayNo%></b></span></header><div><p><b><%=t('payment')%>:</b> <%=row.payment_terms||'-'%></p><p><b><%=t('installation')%>:</b> <%=row.installation_terms||'-'%></p><p><b><%=t('shipping')%>:</b> <%=row.shipping_terms||'-'%></p><p><b><%=locale==='en'?'Delivery time':'Teslim süresi'%>:</b> <%=row.delivery_terms||'-'%></p><p><b><%=t('warranty')%>:</b> <%=row.warranty_terms||'-'%></p><% if(row.legal_note){ %><p class="legal-note"><%=row.legal_note%></p><% } %></div></section>
