<% layout('layout') -%>
<% const actionTr={CUSTOMER_CREATE:'Müşteri oluşturuldu',CUSTOMER_UPDATE:'Müşteri güncellendi',CUSTOMER_BULK_ARCHIVE:'Müşteri arşivlendi',QUOTE_CREATE:'Proforma oluşturuldu',QUOTE_UPDATE:'Proforma güncellendi',QUOTE_TO_ORDER:'Siparişe dönüştürüldü',QUOTE_STATUS:'Durum güncellendi',USER_CREATE:'Kullanıcı oluşturuldu',USER_UPDATE:'Kullanıcı güncellendi',USER_ROLE_CHANGE:'Rol değişti',PERMISSION_MATRIX_UPDATE:'Yetki matrisi güncellendi',BACKUP_CREATE:'Yedek alındı',RESTORE_REQUEST_CREATE:'Geri yükleme talebi'}; const moduleTr={CUSTOMERS:'Müşteriler',PRODUCTS:'Ürünler',QUOTES:'Proformalar',USERS:'Kullanıcılar',BACKUPS:'Yedekler',AUDIT:'İşlem Kayıtları',INTEGRATIONS:'Entegrasyonlar',INVOICES:'Faturalar'}; %>
<header class="page-head pro-headline"><div><span class="eyebrow">🧾 DENETİM</span><h1>İşlem Kayıtları</h1><p>Panelde son işlemler gösterilir. Ana proforma, müşteri, ürün, fatura ve revizyon kayıtları silinmez.</p></div></header>
<section class="audit-summary-grid">
 <article class="mini-stat-card"><small>📌 Son Kayıt</small><b><%=summary.total%></b><span>Listelenen işlem</span></article>
 <article class="mini-stat-card"><small>✅ Başarılı</small><b><%=summary.success%></b><span>OK sonucu</span></article>
 <article class="mini-stat-card"><small>👤 Kullanıcı</small><b><%=summary.users%></b><span>İşlem yapan</span></article>
 <article class="mini-stat-card"><small>📊 En Yoğun Modül</small><b><%=moduleTr[summary.topModule[0]]||summary.topModule[0]%></b><span><%=summary.topModule[1]%> işlem</span></article>
</section>
<details class="card collapse-card audit-card" open>
 <summary><span>🧾 İşlem Özeti</span><small>Eski/yeni farkını görmek için detay alanını açın.</small></summary>
 <div class="audit-actions"><span class="tag tag--success">🔒 Değiştirilemez denetim kaydı</span><small>İşlem geçmişi kalıcıdır; panelden silme kapatılmıştır.</small></div>
  <div class="table-scroll list-table-card"><table class="lined pro-table compact-table"><thead><tr><th>Tarih</th><th>Kullanıcı</th><th>Modül</th><th>Yapılan İşlem</th><th>IP</th><th>Sonuç</th><th>Detay</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="7" class="empty">Henüz işlem kaydı yok.</td></tr><% } rows.forEach(x=>{ let old={},nw={}; try{old=JSON.parse(x.old_json||'{}')}catch{} try{nw=JSON.parse(x.new_json||'{}')}catch{} const keys=[...new Set([...Object.keys(old||{}),...Object.keys(nw||{})])].filter(k=>JSON.stringify(old[k])!==JSON.stringify(nw[k])).slice(0,20); %><tr><td><%=new Date(x.created_at).toLocaleString('tr-TR')%></td><td><%=x.user_label||'-'%></td><td><%=moduleTr[x.module]||x.module%></td><td><b><%=actionTr[x.action]||x.action%></b></td><td><%=x.ip||'-'%></td><td><span class="tag <%=x.result==='OK'?'tag--success':''%>"><%=x.result||'OK'%></span></td><td><details class="audit-detail"><summary>Detay <%=keys.length?`(${keys.length} fark)`:''%></summary><div class="audit-diff-list"><% if(!keys.length){ %><div><small>Bu işlem için alan farkı kaydedilmemiş.</small></div><% } keys.forEach(k=>{ %><div><b><%=k%></b><small>Eski: <%=typeof old[k]==='object'?JSON.stringify(old[k]):(old[k]??'-')%></small><small>Yeni: <%=typeof nw[k]==='object'?JSON.stringify(nw[k]):(nw[k]??'-')%></small></div><% }) %></div></details></td></tr><% }) %></tbody></table></div>
</details>
