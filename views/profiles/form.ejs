<% layout('layout') -%>
<header class="page-head"><div><h1><%=title%></h1></div><a class="btn btn--soft" href="/profiles">← Listeye Dön</a></header>
<form class="card entity-form entity-form--compact profile-form" data-address-scope method="post" action="/profiles/save?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="id" value="<%=row.id||''%>">
<section class="form-section form-section--compact"><div class="form-section__head"><h2>🏢 Kurumsal Bilgiler</h2></div><div class="form-grid compact-field-grid"><label>Firma unvanı<input required name="company_name" value="<%=row.company_name||''%>"></label><label>Kısa firma adı<input name="short_name" value="<%=row.short_name||''%>" placeholder="Kısa unvan"></label><label>Çıktı seri no ön eki<input name="quote_prefix" value="<%=row.quote_prefix||''%>" placeholder="Boşsa müşteri kısa unvanı kullanılır"></label><label>Yetkili kişi<input name="authorized_person" value="<%=row.authorized_person||''%>" placeholder="Ad Soyad / Unvan"></label><label>Vergi dairesi<input name="tax_office" value="<%=row.tax_office||''%>"></label><label>Vergi numarası<input name="tax_no" value="<%=row.tax_no||''%>"></label><label>Telefon<input name="phone" value="<%=row.phone||''%>"></label><label>Cep telefonu<input name="mobile" value="<%=row.mobile||''%>"></label><label>E-posta<input type="email" name="email" value="<%=row.email||''%>"></label><label>Web sitesi<input name="website" value="<%=row.website||''%>"></label><label>Ülke<input data-tr-country name="country" value="<%=row.country||'Türkiye'%>"></label><label>Şehir<input data-tr-city name="city" value="<%=row.city||''%>"></label><label>İlçe<input data-tr-district name="district" value="<%=row.district||''%>"></label><label class="wide">Fatura Adresi<textarea data-auto-grow name="billing_address"><%=row.billing_address||row.address||''%></textarea></label><label class="wide">Teslimat Adresi<textarea data-auto-grow name="delivery_address"><%=row.delivery_address||''%></textarea></label></div></section>
<section class="form-section form-section--compact"><div class="form-section__head"><h2>🖼 Logo, Kaşe ve Banka</h2></div><div class="form-grid compact-field-grid"><label class="asset-upload">Logo <small>JPG/PNG/WEBP/GIF/AVIF</small><input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,.jpg,.jpeg,.jfif,.png,.webp,.gif,.avif" name="logo" data-preview-file="logoPreview"><span class="asset-preview"><% if(row.logo_url){ %><img id="logoPreview" src="<%=row.logo_url%>" alt="Logo"><% }else{ %><img id="logoPreview" alt="Logo" hidden><em>Yüklü görsel yok</em><% } %></span><% if(row.id&&row.logo_url){ %><button class="btn btn--sm btn--danger asset-remove-btn" type="submit" formaction="/profiles/<%=row.id%>/remove-asset" formmethod="post" formenctype="application/x-www-form-urlencoded" formnovalidate name="asset" value="logo">✕ Logoyu Kaldır</button><% } %></label><label class="asset-upload">Kaşe / İmza <small>JPG/PNG/WEBP/GIF/AVIF</small><input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,.jpg,.jpeg,.jfif,.png,.webp,.gif,.avif" name="stamp" data-preview-file="stampPreview"><span class="asset-preview"><% const combinedStamp=row.stamp_url||row.signature_url; if(combinedStamp){ %><img id="stampPreview" src="<%=combinedStamp%>" alt="Kaşe / İmza"><% }else{ %><img id="stampPreview" alt="Kaşe / İmza" hidden><em>Yüklü görsel yok</em><% } %></span><% if(row.id&&combinedStamp){ %><button class="btn btn--sm btn--danger asset-remove-btn" type="submit" formaction="/profiles/<%=row.id%>/remove-asset" formmethod="post" formenctype="application/x-www-form-urlencoded" formnovalidate name="asset" value="stamp">✕ Kaşe / İmzayı Kaldır</button><% } %></label><label>Banka adı<input name="bank_name" value="<%=row.bank_name||''%>"></label><label>TL IBAN<input name="iban_try" value="<%=row.iban_try||''%>"></label><label>EUR IBAN<input name="iban_eur" value="<%=row.iban_eur||''%>"></label><label>USD IBAN<input name="iban_usd" value="<%=row.iban_usd||''%>"></label><label>SWIFT / BIC<input name="swift_bic" value="<%=row.swift_bic||''%>"></label></div></section>
<details class="form-section form-section--compact collapsible-form-section"><summary>📄 PDF Sabit Alt Bilgi <small>İhtiyaç halinde aç</small></summary><div class="form-grid compact-field-grid"><label class="wide">Alt bilgi adresi<input name="footer_address" value="<%=row.footer_address||''%>"></label><label>Alt bilgi telefonu<input name="footer_phone" value="<%=row.footer_phone||''%>"></label><label>Alt bilgi e-postası<input name="footer_email" value="<%=row.footer_email||''%>"></label><label class="wide">Açıklama<textarea data-auto-grow name="note"><%=row.note||''%></textarea></label></div></details>

<details class="form-section form-section--compact collapsible-form-section live-profile-box" open><summary>🟢 Canlı Ziyaretçi Takibi ve Sohbet <small>Web sitenize bağlanacak canlı destek kodu</small></summary><div class="form-grid compact-field-grid"><label>Canlı destek aktif <select name="live_enabled"><option value="1" <%=!liveSite||liveSite.is_active?'selected':''%>>Aktif</option><option value="" <%=liveSite&& !liveSite.is_active?'selected':''%>>Pasif</option></select></label><label>Site adı<input name="live_site_name" value="<%=liveSite?.site_name||row.short_name||row.company_name||''%>" placeholder="ArtLab Market"></label><label class="wide">Web site adresi<input name="live_site_url" value="<%=liveSite?.site_url||row.website||''%>" placeholder="https://www.siteadiniz.com"></label><label>Widget başlığı<input name="live_widget_title" value="<%=liveSite?.widget_title||'Canlı Destek'%>"></label><label>Widget rengi<input name="live_widget_color" value="<%=liveSite?.widget_color||'#245ba7'%>"></label><label class="wide">Karşılama mesajı<textarea data-auto-grow name="live_welcome_message"><%=liveSite?.welcome_message||'Merhaba, size nasıl yardımcı olabiliriz?'%></textarea></label><label class="wide">Offline mesajı<textarea data-auto-grow name="live_offline_message"><%=liveSite?.offline_message||'Şu anda çevrimdışıyız. Mesajınızı bırakın, size dönüş yapalım.'%></textarea></label></div><div class="live-embed-code"><div><b>Siteye eklenecek kod</b><small>Kaydet sonrası oluşan kodu sitenizin footer/head alanına ekleyin.</small></div><code><% if(liveSite?.site_key){ %>&lt;script async src="<%=publicBaseUrl%>/live/embed.js?site=<%=liveSite.site_key%>&amp;v=<%=appVersion%>"&gt;&lt;/script&gt;<% }else{ %>Önce firmayı kaydedin; site anahtarı otomatik oluşturulacak.<% } %></code><div class="row-actions"><% if(liveSite?.site_key){ %><a class="btn btn--sm" href="/live/settings">Canlı destek ayarlarına git</a><a class="btn btn--sm btn--primary" href="/live">Canlı akış</a><% } %></div></div></details>

<div class="form-actions"><button class="btn btn--primary" type="submit">💾 Kaydet</button></div></form>
