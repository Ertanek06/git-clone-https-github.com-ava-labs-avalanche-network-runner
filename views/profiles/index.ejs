<% layout('layout') -%><% const canAdmin=can('settings','admin'); const active=rows.find(p=>p.is_active); %>
<header class="page-head"><div><h1>Firma Profilleri</h1></div><% if(canAdmin){ %><a class="btn btn--primary page-head__primary-action btn--alive" href="/profiles/new"><span class="btn__icon btn__icon--live" aria-hidden="true">＋</span> Yeni Firma</a><% } %></header>
<% if(active){ %><section class="card active-profile-summary"><div class="profile-logo profile-logo--summary"><% if(active.logo_url){ %><img src="<%=active.logo_url%>" alt="Aktif firma logosu"><% }else{ %>FİRMA<% } %></div><div class="active-profile-summary__copy"><h2><%=active.company_name%></h2><div class="active-profile-summary__meta"><span><b>Vergi Dairesi:</b> <%=active.tax_office||'-'%></span><span><b>Vergi No:</b> <%=active.tax_no||'-'%></span><span><b>Adres:</b> <%=active.delivery_address||active.billing_address||active.address||'-'%></span><span><b>İletişim:</b> <%=active.email||'-'%> · <%=active.mobile||active.phone||'-'%></span></div></div><div class="profile-actions"><span class="tag tag--success">● AKTİF FİRMA</span><% if(canAdmin){ %><a class="btn btn--sm" href="/profiles/<%=active.id%>/edit">✎ Düzenle</a><% } %></div></section><% } %>
<section class="card profile-catalog-card"><div class="card-head"><h2>Firma Profilleri</h2></div><div class="profile-grid profile-grid--cards"><% rows.forEach(p=>{ %><article class="profile-card profile-card--tile <%=p.is_active?'is-active':''%>"><div class="profile-card__main"><div class="profile-logo"><% if(p.logo_url){ %><img src="<%=p.logo_url%>" alt=""><% }else{ %>FİRMA<% } %></div><div><h2><%=p.company_name%></h2><p><b>VD:</b> <%=p.tax_office||'-'%> · <b>V.No:</b> <%=p.tax_no||'-'%></p><p><%=p.delivery_address||p.billing_address||p.address||'-'%></p><p><%=p.email||'-'%> · <%=p.mobile||p.phone||'-'%></p></div></div><div class="profile-card__footer"><% if(p.is_active){ %><span class="tag tag--success">● Aktif</span><% }else if(canAdmin){ %><form method="post" action="/profiles/<%=p.id%>/activate"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--sm">○ Aktif Yap</button></form><% } %><div class="profile-actions"><% if(canAdmin){ %><a class="btn btn--sm" href="/profiles/<%=p.id%>/edit">✎ Düzenle</a><% if(!p.is_active){ %><form method="post" action="/profiles/<%=p.id%>/delete" data-confirm='Bu firma profili arşivlensin mi?'><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--sm btn--danger">🗄 Arşivle</button></form><% } %><% } %></div></div></article><% }) %></div></section>
