<% layout('layout') -%>
<header class="page-head"><div><span class="eyebrow">HESAP GÜVENLİĞİ</span><h1>Şifre Değiştir</h1><p class="muted"><%=forced?'Hesabınızı kullanmaya devam etmek için geçici şifrenizi değiştirmeniz gerekir.':'Şifrenizi yenileyerek diğer açık oturumları kapatabilirsiniz.'%></p></div></header>
<form class="card form-grid" method="post" action="/change-password" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%=csrfToken%>">
  <label class="wide">Mevcut şifre<input required type="password" name="current_password" autocomplete="current-password"></label>
  <label>Yeni şifre<input required minlength="12" type="password" name="new_password" autocomplete="new-password" aria-describedby="passwordHelp"></label>
  <label>Yeni şifre tekrar<input required minlength="12" type="password" name="confirm_password" autocomplete="new-password"></label>
  <p id="passwordHelp" class="wide muted">En az 12 karakter, en az bir harf ve bir rakam kullanın.</p>
  <div class="wide form-actions"><button class="btn btn--primary" type="submit">Şifreyi Güvenli Biçimde Değiştir</button><% if(!forced){ %><a class="btn" href="/">Vazgeç</a><% } %></div>
</form>
