<%
const tableActionIcon = [
  'preview',
  'edit',
  'open',
  'print',
  'whatsapp',
  'archive',
  'delete',
  'restore',
  'success',
  'warning',
  'note'
].includes(String(iconName || '')) ? String(iconName) : 'open';
%>
<span class="table-action__icon table-action__icon--<%=tableActionIcon%>" aria-hidden="true">
  <% if(tableActionIcon === 'preview'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="3"/></svg>
  <% }else if(tableActionIcon === 'edit' || tableActionIcon === 'note'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="m4 16.5-.8 4.3 4.3-.8L18.7 8.8l-3.5-3.5L4 16.5Z"/><path d="m13.8 6.7 3.5 3.5"/></svg>
  <% }else if(tableActionIcon === 'open'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M14 5h5v5"/><path d="m19 5-9 9"/><path d="M19 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"/></svg>
  <% }else if(tableActionIcon === 'print'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v5h4"/><path d="M9.5 13h6M9.5 16h6"/></svg>
  <% }else if(tableActionIcon === 'whatsapp'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M20.7 11.7a8.7 8.7 0 0 1-12.9 7.6L3 20.7l1.4-4.6a8.7 8.7 0 1 1 16.3-4.4Z"/><path d="M8.2 7.2c.4-.4 1-.3 1.3.1l1.2 1.8c.2.3.1.8-.1 1.1l-.7.7c.7 1.4 1.8 2.5 3.2 3.2l.7-.7c.3-.3.8-.3 1.1-.1l1.8 1.2c.4.3.5.9.1 1.3l-.7.7c-.8.8-2 .9-3 .5a11.2 11.2 0 0 1-6.3-6.3c-.4-1-.2-2.2.5-3l.9-.5Z"/></svg>
  <% }else if(tableActionIcon === 'archive'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 8h16v12H4V8Z"/><path d="M3 4h18v4H3V4ZM9 12h6"/></svg>
  <% }else if(tableActionIcon === 'delete'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"/></svg>
  <% }else if(tableActionIcon === 'restore'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 8V3m0 0h5M4 3l4 4"/><path d="M5.5 16.5A8 8 0 1 0 6 7"/></svg>
  <% }else if(tableActionIcon === 'success'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><path d="m5 12 4 4L19 6"/></svg>
  <% }else if(tableActionIcon === 'warning'){ %>
    <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></svg>
  <% } %>
</span>
