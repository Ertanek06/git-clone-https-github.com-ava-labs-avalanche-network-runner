<% layout('layout') -%>
<header class="page-head"><div><h1>⚙️ <%=locale==='en'?'General Settings':'Genel Ayarlar'%></h1><p><%=locale==='en'?'Manage only system-wide operational defaults.':'Sistem genelinde kullanılan numaralandırma, döviz ve proforma varsayılanlarını sade bir ekrandan yönetin.'%></p></div><a class="btn" href="/settings"><%=t('back')%></a></header>
<form class="card general-settings-form" method="post"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="section" value="<%=section%>">
 <section class="settings-section"><h2>⚙️ <%=locale==='en'?'Numbering and currency':'Numaralandırma ve Döviz'%></h2><div class="form-grid"><label><%=locale==='en'?'Offer number format':'Teklif numara formatı'%><input name="quote_number_format" value="<%=values.quote_number_format||'TEK{YY}{0000}'%>"></label><label><%=locale==='en'?'Order number format':'Sipariş numara formatı'%><input name="order_number_format" value="<%=values.order_number_format||'{YYYY}-{0000}'%>"></label><label><%=t('fx_source')%><select name="currency_source"><option <%=String(values.currency_source||'TCMB').toUpperCase()==='TCMB'?'selected':''%>>TCMB</option><option value="MANUAL" <%=String(values.currency_source||'').toUpperCase()==='MANUAL'?'selected':''%>><%=locale==='en'?'Manual':'Manuel'%></option></select></label></div></section>
 <% const groups=[['payment_terms','💳','Ödeme koşulları','PEŞİN ÖDEME'],['delivery_terms','📦','Teslim süresi','SİPARİŞİ MÜTEAKİBEN 2-3 HAFTA'],['shipping_terms','🚚','Nakliye / teslim şekli','NAKLİYE ALICI FİRMAYA AİTTİR.'],['installation_terms','🛠️','Kurulum ve eğitim','KURULUM VE EĞİTİM FİYATIMIZA DAHİLDİR.'],['warranty_terms','🛡️','Garanti','CİHAZLAR İMALAT HATALARINA KARŞI 2 YIL SÜRE İLE GARANTİLİDİR.'],['legal_terms','⚖️','Yasal açıklama','']]; %>
 <section class="settings-section"><h2>📄 Proforma Varsayılan Koşulları</h2><p class="muted">Kaydedilen metinler yeni proforma ekranında otomatik gelir. Daha önce kullandığınız metinler seçim listesinde korunur. Alanları elle de düzenleyebilirsiniz.</p><div class="terms-default-grid"><% groups.forEach(g=>{ const key=g[0],value=values[key+'_default']||g[3],opts=histories[key]||[]; %><label class="term-default-card"><b><%=g[1]%> <%=g[2]%></b><select data-fill-next><option value="">Hazır metin veya önceki kayıtlardan seçin</option><% opts.forEach(o=>{ %><option value="<%=o%>"><%=o%></option><% }) %></select><textarea name="<%=key%>_default" rows="<%=key==='warranty_terms'||key==='legal_terms'?5:3%>"><%=value%></textarea></label><% }) %></div></section>

 <section class="settings-section"><h2>🧠 Akıllı Teklif Takibi ve Otomatik Hatırlatma</h2><p class="muted">Teklifin son geçerlilik tarihinden 3 gün önce hatırlatma, süresi dolduğunda ise yeni talep oluşturma mesajı gönderilir. Metinleri istediğiniz zaman değiştirebilirsiniz.</p><div class="form-grid"><label>Hatırlatma günü<input name="quote_reminder_days_before" type="number" min="1" max="30" value="<%=values.quote_reminder_days_before||3%>"></label><label class="switch"><input type="checkbox" name="quote_reminder_enabled" value="1" <%=String(values.quote_reminder_enabled??'1')==='1'?'checked':''%>><span>Otomatik e-posta hatırlatmaları aktif</span></label><label class="wide">Son geçerlilik tarihinden 3 gün önce gönderilecek e-posta konusu<input name="quote_reminder_subject" value="<%=values.quote_reminder_subject||'Fiyat teklifimizin geçerlilik süresi hakkında'%>"></label><label class="wide">3 gün kala gönderilecek e-posta metni<textarea name="quote_reminder_body" rows="6"><%=values.quote_reminder_body||`Sn. Yetkili,

Tarafınıza iletmiş olduğumuz {{TEKLIF_NO}} numaralı fiyat teklifimizin geçerlilik süresi {{SON_GUN}} tarihinde sona erecektir. Teklifimizle ilgili değerlendirmenizi ve varsa revizyon taleplerinizi bizimle paylaşmanızı rica ederiz.

Teklif bağlantısı: {{TEKLIF_LINKI}}

İyi çalışmalar dileriz.
Saygılarımızla.`%></textarea></label><label class="wide">Süre dolduğunda gönderilecek e-posta konusu<input name="quote_expired_subject" value="<%=values.quote_expired_subject||'Fiyat teklifimizin geçerlilik süresi sona erdi'%>"></label><label class="wide">Teklifin son günü bittiğinde gönderilecek e-posta metni<textarea name="quote_expired_body" rows="7"><%=values.quote_expired_body||`Sn. Yetkili,

{{TEKLIF_NO}} numaralı fiyat teklifimizin geçerlilik süresi sona ermiştir. Güncel fiyat, termin ve koşulların yeniden değerlendirilmesi için yeni talep oluşturmanızı veya bizimle iletişime geçmenizi rica ederiz.

Yeni talep / teklif bağlantısı: {{TEKLIF_LINKI}}

İyi çalışmalar dileriz.
Saygılarımızla.`%></textarea></label><div class="wide muted">Kullanılabilir değişkenler: <code>{{TEKLIF_NO}}</code>, <code>{{MUSTERI}}</code>, <code>{{SON_GUN}}</code>, <code>{{TEKLIF_LINKI}}</code></div></div></section>
 <div class="form-actions"><button class="btn btn--primary">💾 <%=t('save')%></button></div>
</form>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">document.querySelectorAll('[data-fill-next]').forEach(s=>s.addEventListener('change',()=>{if(s.value){s.nextElementSibling.value=s.value;s.nextElementSibling.dispatchEvent(new Event('input',{bubbles:true}))}}));</script>
