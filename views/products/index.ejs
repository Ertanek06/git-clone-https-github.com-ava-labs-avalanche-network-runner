<% layout('layout') -%>
<%
 const canCreate=can('products','create'),canEdit=can('products','edit'),canArchive=can('products','archive'),canExport=can('products','export'),canImport=canCreate||canEdit,canPriceEdit=canEdit&&can('financials','edit');
 const productActionCount=1+(canEdit?1:0);
 const showMoney=canSeeFinancials!==false;
 const en=locale==='en';
 const L=en?{
  title:'Products & Services List',newProduct:'New Product',tools:'Product list tools',searchTitle:'Search products',searchAria:'Search products',searchPlaceholder:'Search: product name, code, brand or description',search:'Search',clearTitle:'Clear search and filters',clear:'Clear',sortTitle:'Sort',sortAria:'Product sorting',recent:'Recently Added',alpha:'Alphabetical A–Z',limitTitle:'Records per page',limitAria:'Records per page',totalTitle:'Total number of products',total:'Total',selectAll:'Select All',selected:'Selected',archiveConfirm:'Archive selected products?',archive:'Archive',priceSetting:'Price Adjustment',percentAria:'Price update percentage',update:'Update',importProforma:'Import from Proforma',importWeb:'Import from Website',exportExcel:'Export Excel',exportTitle:'Download products in the same Excel format as the upload template',importExcel:'Import Excel',excelHelp:'Modern .xlsx, XML-based .xls and Excel-compatible CSV files are accepted.',uploadFile:'Upload File',downloadTemplate:'Download Template',templateTitle:'Download a blank sample Excel template for bulk upload',allProducts:'Select all products',image:'Image',code:'Product Code',name:'Product Name',description:'Description',brand:'Brand',model:'Model',unit:'Unit',price:'Price',actions:'Actions',empty:'No products matched your search.',preview:'Preview',edit:'Edit',previewRow:'Open product preview by clicking the row',productPreview:'Product Preview',selectProduct:'Select product'
 }:{
  title:'Ürün ve Hizmet Listesi',newProduct:'Yeni Ürün',tools:'Ürün listesi araçları',searchTitle:'Ürün ara',searchAria:'Ürün ara',searchPlaceholder:'Ara: Ürün adı, kod, marka, açıklama',search:'Ara',clearTitle:'Arama ve filtreleri temizle',clear:'Temizle',sortTitle:'Sıralama',sortAria:'Ürün sıralaması',recent:'Son Eklenen',alpha:'Alfabetik A–Z',limitTitle:'Sayfa başına kayıt',limitAria:'Sayfa başına kayıt',totalTitle:'Toplam ürün sayısı',total:'Toplam',selectAll:'Tümünü Seç',selected:'Seçili',archiveConfirm:'Seçili ürünler arşivlensin mi?',archive:'Arşivle',priceSetting:'Fiyat Ayarı',percentAria:'Fiyat güncelleme yüzdesi',update:'Güncelle',importProforma:'Proformadan Ürün Aktar',importWeb:'Web Sitesinden Ürün Aktar',exportExcel:'Excel Dışa Aktar',exportTitle:'Ürünleri yükleme şablonuyla aynı Excel formatında indir',importExcel:'Excel İçe Aktar',excelHelp:'Modern .xlsx, XML tabanlı .xls ve Excel uyumlu CSV kabul edilir.',uploadFile:'Dosyayı Yükle',downloadTemplate:'Şablon İndir',templateTitle:'Toplu yükleme için boş örnek Excel şablonunu indir',allProducts:'Tüm ürünleri seç',image:'Görsel',code:'Ürün Kodu',name:'Ürün Adı',description:'Açıklama',brand:'Marka',model:'Model',unit:'Birim',price:'Fiyat',actions:'İşlemler',empty:'Arama ölçütlerine uygun ürün bulunamadı.',preview:'Ön İzleme',edit:'Düzenle',previewRow:'Satıra tıklayarak ürün ön izlemesini aç',productPreview:'Ürün Ön İzleme',selectProduct:'Ürünü seç'
 };
%>
<header class="page-head list-page-head"><div><h1><%=L.title%></h1></div><% if(canCreate){ %><a class="btn btn--primary page-head__primary-action btn--alive" href="/products/new"><span class="btn__icon btn__icon--live" aria-hidden="true">＋</span> <%=L.newProduct%></a><% } %></header>
<section class="card workspace-toolbar workspace-toolbar--products" aria-label="<%=L.tools%>">
 <div class="workspace-toolbar__row workspace-toolbar__row--main">
  <form class="toolbar-search-form" method="get" action="/products">
   <span class="toolbar-search-pair"><label class="toolbar-input toolbar-input--search" title="<%=L.searchTitle%>"><span class="toolbar-input__icon list-live-icon" aria-hidden="true">⌕</span><input name="q" value="<%=q%>" aria-label="<%=L.searchAria%>" placeholder="<%=L.searchPlaceholder%>"></label><button class="btn btn--primary toolbar-btn toolbar-btn--search" type="submit" title="<%=L.search%>"><%=L.search%></button></span>
   <a class="btn toolbar-btn btn--ghost" href="/products" title="<%=L.clearTitle%>"><span aria-hidden="true">×</span> <%=L.clear%></a>
   <label class="toolbar-input toolbar-input--sort" title="<%=L.sortTitle%>"><span class="toolbar-input__icon list-live-icon" aria-hidden="true">⇅</span><select name="sort" aria-label="<%=L.sortAria%>" data-list-sort-autosubmit><option value="recent" <%=sort==='recent'?'selected':''%>><%=L.recent%></option><option value="alpha" <%=sort==='alpha'?'selected':''%>><%=L.alpha%></option></select></label>
   <label class="toolbar-input toolbar-input--limit" title="<%=L.limitTitle%>"><span class="toolbar-input__icon" aria-hidden="true">☷</span><select name="limit" aria-label="<%=L.limitAria%>" data-list-sort-autosubmit><% [10,30,50,100].forEach(x=>{ %><option value="<%=x%>" <%=x===limit?'selected':''%>><%=x%></option><% }) %></select></label>
  </form>
  <span class="toolbar-total" title="<%=L.totalTitle%>"><%=L.total%> <b><%=total%></b></span>
 </div>
 <div class="workspace-toolbar__row workspace-toolbar__row--secondary">
  <div class="toolbar-bulk-group">
   <label class="toolbar-select-all"><input type="checkbox" data-check-all data-target-form="productBulkForm"><span><%=L.selectAll%></span></label>
   <span class="toolbar-selected"><%=L.selected%>: <b data-selection-count="productBulkForm">0</b></span>
   <% if(canArchive){ %><button class="btn btn--danger toolbar-btn toolbar-btn--compact" type="submit" form="productBulkForm" formaction="/products/bulk-delete" data-requires-selection="productBulkForm" data-confirm=<%-JSON.stringify(L.archiveConfirm)%>><span aria-hidden="true">🗑</span> <%=L.archive%></button><% } %>
  </div>
  <% if(canPriceEdit||canImport||canExport){ %>
  <% if(canPriceEdit){ %>
  <div class="toolbar-price"><b><%=L.priceSetting%></b><span class="toolbar-price__symbol">%</span><input form="productBulkForm" name="percent" type="number" step="0.01" aria-label="<%=L.percentAria%>" placeholder="0.0"><button class="btn toolbar-btn toolbar-btn--compact btn--soft" type="submit" form="productBulkForm" formaction="/products/bulk-price" data-requires-selection="productBulkForm"><span aria-hidden="true">％</span> <%=L.update%></button></div>
  <% } %>
  <div class="toolbar-spacer" aria-hidden="true"></div>
  <% if(canImport){ %><a class="btn toolbar-btn btn--primary btn--alive proforma-import-direct-action" href="/products/import-proforma"><span class="btn__icon btn__icon--live" aria-hidden="true">⌁</span> <%=L.importProforma%></a><a class="btn toolbar-btn btn--soft" href="/products/import-web"><span class="btn__icon" aria-hidden="true">🌐</span> <%=L.importWeb%></a><% } %>
  <% if(canExport||canImport){ %><div class="excel-action-cluster" aria-label="Excel">
   <div class="excel-action-stack">
    <% if(canExport){ %><a class="btn toolbar-btn btn--soft excel-action-btn" href="/products/export.xls" title="<%=L.exportTitle%>"><span aria-hidden="true">↓</span> <%=L.exportExcel%></a><% } %>
    <% if(canImport){ %><details class="import-pop toolbar-import excel-import-pop"><summary class="btn toolbar-btn btn--soft excel-action-btn btn--alive"><span class="btn__icon btn__icon--live" aria-hidden="true">↑</span> <%=L.importExcel%></summary><div class="import-pop__body"><form method="post" action="/products/import-excel?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><small><%=L.excelHelp%></small><input required type="file" name="excel" accept=".xlsx,.xls,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv"><button class="btn btn--primary" type="submit"><%=L.uploadFile%></button></form></div></details><% } %>
   </div>
   <% if(canExport){ %><a class="btn toolbar-btn btn--soft excel-template-action" href="/products/import-template.xls" title="<%=L.templateTitle%>"><span aria-hidden="true">↓</span> <%=L.downloadTemplate%></a><% } %>
  </div><% } %>
  <% } %>
 </div>
</section>
<% if(typeof showAll!=='undefined'&&showAll){ %><div class="product-progressive-all-v110" data-product-all-loader data-offset="<%=rows.length%>" data-total="<%=total%>" data-q="<%=q||''%>" data-sort="<%=sort||''%>" data-batch="<%=allBatch||120%>"><span class="product-progressive-all-v110__spinner" aria-hidden="true"></span><b data-product-all-status><%=rows.length%> / <%=total%> ürün hazır</b><button class="btn btn--sm btn--soft" type="button" data-product-all-retry hidden>Tekrar Dene</button></div><% } %>
<form id="productBulkForm" class="products-list-form" method="post"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><section class="card table-scroll list-table-card products-table-card"><table class="lined product-table pro-table" data-table-preferences="products" data-mobile-cards><colgroup><col class="col-check"><col class="col-image"><col class="col-code"><col class="col-name"><col class="col-desc"><col class="col-brand"><col class="col-model"><col class="col-unit"><% if(showMoney){ %><col class="col-price"><% } %><col class="col-actions actions-col--<%=productActionCount%>"></colgroup><thead><tr><th><input type="checkbox" data-check-all data-target-form="productBulkForm" aria-label="<%=L.allProducts%>"></th><th><%=L.image%></th><th><%=L.code%></th><th><%=L.name%></th><th><%=L.description%></th><th><%=L.brand%></th><th><%=L.model%></th><th><%=L.unit%></th><% if(showMoney){ %><th><%=L.price%></th><% } %><th class="actions-col actions-col--<%=productActionCount%>"><%=L.actions%></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="<%=showMoney?10:9%>" class="empty"><%=L.empty%></td></tr><% } %><% rows.forEach(p=>{ %><tr class="previewable-list-row" tabindex="0" role="button" aria-label="<%=p.name%> — <%=L.preview%>" title="<%=L.previewRow%>" data-preview-title="<%=L.productPreview%>" data-preview-url="/products/<%=p.id%>/preview"<% if(canEdit){ %> data-preview-edit="/products/<%=p.id%>/edit"<% } %>><td><input type="checkbox" name="ids" value="<%=p.id%>" aria-label="<%=p.name%> — <%=L.selectProduct%>"></td><td><div class="thumb"><% if(p.image_url){ %><img loading="lazy" src="<%=p.image_url%>" alt=""><% } %></div></td><td><%=p.code%></td><td title="<%=p.name%>"><b><%=p.name%></b></td><td><span class="clamp" title="<%=[p.short_description,p.technical_description].filter(Boolean).join(' ' )%>"><%=[p.short_description,p.technical_description].filter(Boolean).join(' ' )||'-'%></span></td><td><%=p.brand||'-'%></td><td><%=p.model||'-'%></td><td><%=p.unit%></td><% if(showMoney){ %><td><b><%=Number(p.sale_price||0).toFixed(2)%></b> <%=p.currency%></td><% } %><td class="actions-cell actions-cell--<%=productActionCount%>"><div class="table-action-list"><button class="table-action is-preview" type="button" data-preview-title="<%=L.productPreview%>" data-preview-url="/products/<%=p.id%>/preview"<% if(canEdit){ %> data-preview-edit="/products/<%=p.id%>/edit"<% } %> data-label="<%=L.preview%>" title="<%=L.preview%>" aria-label="<%=L.preview%>"><%- include('../partials/table-action-icon',{iconName:'preview'}) %></button><% if(canEdit){ %><a class="table-action is-edit" href="/products/<%=p.id%>/edit" data-label="<%=L.edit%>" title="<%=L.edit%>" aria-label="<%=L.edit%>"><%- include('../partials/table-action-icon',{iconName:'edit'}) %></a><% } %><% if(canArchive){ %><button class="table-action is-mobile-delete mobile-list-only" type="submit" name="ids" value="<%=p.id%>" formaction="/products/bulk-delete" formmethod="post" data-no-row-preview data-label="<%=en?'Delete':'Sil'%>" title="<%=en?'Delete (archive)':'Sil (arşivle)'%>" aria-label="<%=p.name%> — <%=en?'delete':'sil'%>" data-confirm=<%-JSON.stringify(en?'Archive this product?':'Bu ürün arşivlensin mi?')%>><%- include('../partials/table-action-icon',{iconName:'delete'}) %></button><% } %></div></td></tr><% }) %></tbody></table></section></form><%- include('../partials/pager',{q,page,limit,total,sort,showAll:typeof showAll!=='undefined'&&showAll}) %>
