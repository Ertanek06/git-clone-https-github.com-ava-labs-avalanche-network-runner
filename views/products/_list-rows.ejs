<% const L=en?{preview:'Preview',edit:'Edit',archive:'Archive',productPreview:'Product Preview',selectProduct:'Select product'}:{preview:'Ön İzleme',edit:'Düzenle',archive:'Arşivle',productPreview:'Ürün Ön İzleme',selectProduct:'Ürünü seç'}; const actionCount=1+(canEdit?1:0)+(canArchive?1:0); %>
<% rows.forEach(p=>{ const description=[p.short_description,p.technical_description].filter(Boolean).join(' ')||'-'; %>
<tr class="previewable-list-row" tabindex="0" role="button" aria-label="<%=p.name%> — <%=L.preview%>" title="<%=L.preview%>" data-preview-title="<%=L.productPreview%>" data-preview-url="/products/<%=p.id%>/preview">
 <td><input type="checkbox" name="ids" value="<%=p.id%>" aria-label="<%=p.name%> — <%=L.selectProduct%>"></td>
 <td><div class="thumb"><% if(p.image_url){ %><img loading="lazy" src="<%=p.image_url%>" alt=""><% } else { %><span class="media-fallback-v19"><span aria-hidden="true">＋</span><small>Görsel ekle</small></span><% } %></div></td>
 <td><%=p.code%></td><td title="<%=p.name%>"><b><%=p.name%></b></td><td><span class="clamp" title="<%=description%>"><%=description%></span></td><td><%=p.brand||'-'%></td><td><%=p.model||'-'%></td><td><%=p.unit%></td>
 <% if(showMoney){ %><td><b><%=Number(p.sale_price||0).toFixed(2)%></b> <%=p.currency%></td><% } %>
 <td class="actions-cell actions-cell--<%=actionCount%>"><div class="table-action-list"><button class="table-action is-preview" type="button" data-preview-title="<%=L.productPreview%>" data-preview-url="/products/<%=p.id%>/preview" data-label="<%=L.preview%>" title="<%=L.preview%>" aria-label="<%=L.preview%>"><%- include('../partials/table-action-icon',{iconName:'preview'}) %></button><% if(canEdit){ %><a class="table-action is-edit" href="/products/<%=p.id%>/edit" data-label="<%=L.edit%>" title="<%=L.edit%>" aria-label="<%=L.edit%>"><%- include('../partials/table-action-icon',{iconName:'edit'}) %></a><% } %><% if(canArchive){ %><button class="table-action is-mobile-delete mobile-list-only" type="submit" name="ids" value="<%=p.id%>" formaction="/products/bulk-delete" formmethod="post" data-no-row-preview data-label="<%=L.archive%>" title="<%=L.archive%>" aria-label="<%=L.archive%>"><%- include('../partials/table-action-icon',{iconName:'delete'}) %></button><% } %></div></td>
</tr>
<% }) %>
