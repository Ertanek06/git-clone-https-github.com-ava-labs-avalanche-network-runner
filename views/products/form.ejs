<% layout('layout') -%>
<header class="page-head"><div><h1><%=title%></h1></div><a class="btn btn--soft" href="/products">← Listeye Dön</a></header>
<form class="card entity-form entity-form--compact product-form-modern pro-entity-v58" data-product-save-form method="post" action="/products/save?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="id" value="<%=row.id||''%>">
 <section class="form-section form-section--compact"><div class="form-section__head"><h2>📦 Temel Ürün Bilgileri</h2></div><div class="form-grid compact-field-grid">
  <label>Ürün kodu<input required name="code" value="<%=row.code||''%>"></label><label>GTİP numarası<input name="gtip_no" value="<%=row.gtip_no||''%>" placeholder="Örn. 8419.89.98.90.19"></label><label>Menşei<input name="origin_country" value="<%=row.origin_country||''%>" placeholder="Ülke"></label>
  <label class="wide">Ürün adı<input required name="name" value="<%=row.name||''%>"></label><label>Marka<input name="brand" value="<%=row.brand||''%>"></label><label>Model<input name="model" value="<%=row.model||''%>"></label><label>Kategori<input name="category" value="<%=row.category||''%>"></label><label>Birim<input name="unit" value="<%=row.unit||'ADET'%>"></label>
 </div></section>
 <section class="form-section form-section--compact"><div class="form-section__head"><h2>💳 Fiyat ve Stok</h2></div><div class="form-grid compact-field-grid">
  <label>KDV %<input type="number" step="0.01" name="vat_rate" value="<%=row.vat_rate??20%>"></label><label>Satış fiyatı<input type="number" step="0.01" name="sale_price" value="<%=row.sale_price??0%>"></label><label>Para birimi<select name="currency"><% ['TRY','EUR','USD'].forEach(x=>{ %><option <%=row.currency===x?'selected':''%>><%=x%></option><% }) %></select></label><label>Stok bilgisi<input type="number" step="0.01" name="stock_qty" value="<%=row.stock_qty??0%>"></label><% if(canFinancials){ %><label>Alış fiyatı<input type="number" step="0.01" name="purchase_price" value="<%=row.purchase_price??0%>" <%=canEditFinancials?'':'disabled'%>></label><label>Minimum stok<input type="number" step="0.01" name="min_stock_qty" value="<%=row.min_stock_qty??0%>" <%=canEditFinancials?'':'disabled'%>></label><label>Kâr oranı %<input type="number" step="0.01" name="profit_rate" value="<%=row.profit_rate??0%>" <%=canEditFinancials?'':'disabled'%>></label><label>Tedarikçi<input name="supplier_name" value="<%=row.supplier_name||''%>" <%=canEditFinancials?'':'disabled'%>></label><% } %><label>Durum<select name="status"><option>ACTIVE</option><option <%=row.status==='PASSIVE'?'selected':''%>>PASSIVE</option></select></label>
 </div></section>
 <section class="form-section form-section--compact"><div class="form-section__head"><h2>🖼 Dosyalar ve Açıklama</h2></div><div class="form-grid compact-field-grid">
  <label class="asset-upload">Görsel<input type="file" accept="image/*" name="image" data-preview-file="productImagePreview"><span class="asset-preview"><% if(row.image_url){ %><img id="productImagePreview" src="<%=row.image_url%>" alt=""><% }else{ %><img id="productImagePreview" alt="" hidden><em>Yüklü görsel yok</em><% } %></span></label><label>PDF broşür<input type="file" accept="application/pdf" name="brochure"><% if(row.brochure_url){ %><a class="brochure-link" target="_blank" href="<%=row.brochure_url%>">Kayıtlı broşürü aç</a><% } %></label><label>CE Belgesi PDF<input type="file" accept="application/pdf" name="ce_certificate"><% if(row.ce_certificate_url){ %><a class="brochure-link" target="_blank" href="<%=row.ce_certificate_url%>">Kayıtlı CE belgesini aç</a><% } %></label><label>Kullanma Kılavuzu PDF<input type="file" accept="application/pdf" name="user_manual"><% if(row.manual_url){ %><a class="brochure-link" target="_blank" href="<%=row.manual_url%>">Kayıtlı kılavuzu aç</a><% } %></label><label class="wide">Ürün linki<input name="product_url" value="<%=row.product_url||''%>"></label><label class="wide">Ürün açıklaması<textarea rows="4" name="description_combined" data-auto-grow><%=[row.short_description,row.technical_description].filter(Boolean).join('\n')%></textarea></label>
 </div></section>
 <div class="form-actions"><span class="product-save-status-v132" data-product-save-status aria-live="polite"></span><button class="btn btn--primary" type="submit">💾 Kaydet</button><% if(row.id){ %><button class="btn btn--soft" type="button" data-preview-title="Ürün Ön İzleme" data-preview-url="/products/<%=row.id%>/preview">👁 Ön İzle</button><% } %></div>
</form>
<% if(row.id){ %>
<section class="card product-alternatives-card-v370">
 <div class="card-head"><div><h2>🔄 Ürün Alternatifi ve Muadil Sistemi</h2><small>Bu ürün için yerli, ekonomik, premium, teknik eş değer veya stoktaki alternatifleri tanımlayın.</small></div><span class="pill"><%=alternatives.length%> muadil</span></div>
 <form class="product-alternative-add-v370" method="post" action="/products/<%=row.id%>/alternatives" data-confirm-submit="1" data-confirm-title="Muadil ürün kaydedilsin mi?" data-confirm-message="Seçilen ürün bu ana ürüne alternatif olarak bağlanacaktır." data-confirm-ok="Evet, Kaydet">
  <input type="hidden" name="_csrf" value="<%=csrfToken%>">
  <label><span>Muadil ürün</span><select name="alternative_product_id" required><option value="">Ürün seçin</option><% candidates.forEach(p=>{ %><option value="<%=p.id%>"><%=p.code%> · <%=p.name%> · <%=Number(p.sale_price||0).toLocaleString('tr-TR')%> <%=p.currency%></option><% }) %></select></label>
  <label><span>Muadil türü</span><select name="alternative_type"><option value="LOCAL">Yerli üretim muadil</option><option value="ECONOMIC">Ekonomik alternatif</option><option value="PREMIUM">Üst / premium model</option><option value="EQUIVALENT" selected>Teknik olarak eş değer</option><option value="IN_STOCK">Stokta bulunan alternatif</option></select></label>
  <label class="wide"><span>Muadil notu</span><input name="note" placeholder="Örn. Teknik özellikleri eş değer, teslim süresi daha kısa"></label>
  <button class="btn btn--primary" type="submit">＋ Muadil Ürün Ekle</button>
 </form>
 <div class="product-alternative-list-v370">
  <% if(!alternatives.length){ %><p class="empty">Bu ürüne henüz muadil tanımlanmamış.</p><% } %>
  <% alternatives.forEach(a=>{const label={LOCAL:'Yerli üretim',ECONOMIC:'Ekonomik',PREMIUM:'Üst model',EQUIVALENT:'Teknik eş değer',IN_STOCK:'Stokta'}[a.alternative_type]||'Muadil'; %>
   <article class="product-alternative-row-v370"><span class="product-alternative-thumb-v370"><% if(a.image_url){ %><img src="<%=a.image_url%>" alt=""><% }else{ %>📦<% } %></span><div><b><%=a.code%> · <%=a.name%></b><small><span class="tag tag--warning">MUADİL · <%=label%></span> <%=a.note||''%></small><em><%=Number(a.sale_price||0).toLocaleString('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2})%> <%=a.currency%></em></div><form method="post" action="/products/<%=row.id%>/alternatives/<%=a.id%>/delete" data-confirm-submit="1" data-confirm-title="Muadil bağlantısı kaldırılsın mı?" data-confirm-message="Ürün kaydı silinmez; yalnızca muadil bağlantısı kaldırılır." data-confirm-ok="Evet, Kaldır"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--danger btn--sm" type="submit">× Kaldır</button></form></article>
  <% }) %>
 </div>
</section>
<% } %>
