<% layout('layout') -%>
<%
 const running=['QUEUED','RUNNING','IMPORTING'].includes(job.status);
 const cancellable=['QUEUED','RUNNING'].includes(job.status);
 const retryable=['ERROR','CANCELLED'].includes(job.status);
 const fmt=(v)=>v?new Date(Number(v)).toLocaleString('tr-TR'):'-';
%>
<header class="page-head pro-headline">
  <div><span class="eyebrow">🌐 WEB SİTESİ ÜRÜN TARAMASI</span><h1><%=job.source?.name||'Web sitesi taraması'%></h1><p><%=job.source?.base_url||''%></p></div>
  <div class="row-actions"><a class="btn btn--sm" href="/products/import-web">← Tarama Merkezi</a><a class="btn btn--sm btn--soft" href="/products/import-web/history">Tarama Geçmişi</a></div>
</header>
<section class="card web-scan-progress" id="webScanProgress" data-job-id="<%=job.id%>" data-status="<%=job.status%>">
  <div class="web-progress-head">
    <div><h2 id="webScanStage"><%=job.status==='IMPORTING'?'Seçili ürünler CRM’e aktarılıyor…':job.stage==='analyze'?'Ürün bilgileri analiz ediliyor…':job.status==='READY'?'Kontrol tablosu hazır':job.status==='IMPORTED'?'Aktarım tamamlandı':'Ürün sayfaları aranıyor…'%></h2><p id="webScanMessage"><%=job.message||'Sitemap, ana sayfa ve kategori bağlantıları gerçek zamanlı taranıyor.'%></p></div>
    <b id="webScanPercent"><%=job.progress==null?(running?'CANLI':'-'):`${Number(job.progress||0)}%`%></b>
  </div>
  <div class="web-progress-track <%=job.progress==null&&running?'is-indeterminate':''%>" id="webScanTrack"><span id="webScanBar" data-progress="<%=job.progress==null?'':Number(job.progress||0)%>" style="<%=job.progress==null?'':`width:${Number(job.progress||0)}%`%>"></span></div>

  <div class="web-progress-stats">
    <div><small>Bulunan gerçek ürün</small><b id="webFound"><%=Number(job.discovered||0)%></b></div>
    <div><small>Analiz edilen</small><b id="webAnalyzed"><%=Number(job.analyzed||0)%></b></div>
    <div><small>Uyarı</small><b id="webWarnings"><%=Number(job.warnings||0)%></b></div>
    <div><small>Durum</small><b id="webStatus"><%=job.status%></b></div>
  </div>

  <div class="web-scan-meta">
    <div><small>Sitemap taraması</small><b id="webSitemaps"><%=Number(job.discoverySitemaps||job.discovery?.sitemap_count||0)%></b></div>
    <div><small>Sayfa / bağlantı</small><b id="webPages"><%=Number(job.discoveryPages||job.discovery?.page_count||0)%></b></div>
    <div><small>Başlangıç</small><b id="webStarted"><%=fmt(job.startedAt||job.createdAt)%></b></div>
    <div><small>Son hareket</small><b id="webUpdated"><%=fmt(job.updatedAt)%></b></div>
  </div>

  <section class="web-live-products" aria-live="polite">
    <div class="web-live-head"><div><span class="web-live-dot"></span><div><h3>Canlı bulunan ürünler</h3><p>Ürün sayfası analiz edildikçe gerçek ürün adı, kodu ve görseli burada görünür.</p></div></div><div class="web-live-controls"><button type="button" class="btn btn--sm" id="webLivePrev" aria-label="Önceki ürün">‹</button><button type="button" class="btn btn--sm" id="webLiveNext" aria-label="Sonraki ürün">›</button></div></div>
    <div class="web-live-stage" id="webLiveStage">
      <article class="web-live-current" id="webLiveCurrent" hidden></article>
      <div class="web-live-empty" id="webLiveEmpty"><span>🔎</span><b>Henüz analiz edilmiş ürün yok</b><small>İlk gerçek ürün sayfası işlendiğinde kartlar otomatik olarak burada gösterilecek.</small></div>
      <div class="web-live-track" id="webLiveTrack"></div>
    </div>
  </section>

  <div class="web-progress-error" id="webScanError" <%=job.error?'':'hidden'%>><%=job.error||''%></div>
  <div class="web-progress-ready" id="webScanReady" <%=job.status==='READY'?'':'hidden'%>><div><b>✓ Kontrol tablosu hazır</b><span>Tarama tamamlandı. Ürünleri CRM'e kaydetmeden önce tablo halinde kontrol edebilirsiniz.</span></div><a class="btn btn--primary" href="/products/import-web/scan/<%=job.id%>/preview">Kontrol Tablosunu Aç</a></div>
  <div class="web-progress-foot"><span>Bu sayfadan çıkabilirsiniz. Tarama arka planda devam eder ve <b>Tarama Geçmişi</b> ekranından tekrar açılabilir.</span><div class="row-actions"><% if(cancellable){ %><form id="webScanCancelForm" method="post" action="/products/import-web/scan/<%=job.id%>/cancel"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--danger btn--sm" type="submit" data-confirm="Bu tarama durdurulsun mu?">Taramayı Durdur</button></form><% } %><form id="webScanRetryForm" method="post" action="/products/import-web/scan/<%=job.id%>/retry" <%=retryable?'':'hidden'%>><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--primary btn--sm" type="submit">Kaldığı Yerden Devam Et</button></form><a class="btn btn--soft" href="/products/import-web/history">Geçmişe Dön</a></div></div>
</section>
<script nonce="<%=cspNonce%>" defer src="/public/js/web-import-v45.js"></script>
<style nonce="<%=cspNonce%>">
.web-scan-progress{max-width:1320px;margin:0 auto;display:grid;gap:16px;padding:20px}.web-progress-head{display:flex;justify-content:space-between;gap:18px;align-items:center}.web-progress-head h2{margin:0 0 5px}.web-progress-head p{margin:0;color:var(--muted)}#webScanPercent{font-size:24px;color:var(--primary)}.web-progress-track{height:12px;border-radius:999px;background:var(--soft);overflow:hidden;border:1px solid var(--line);position:relative}.web-progress-track span{display:block;height:100%;background:var(--primary);transition:width .25s ease}.web-progress-track.is-indeterminate span{width:34%!important;position:absolute;left:-34%;animation:webScanMove 1.25s linear infinite}.web-progress-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.web-progress-stats>div,.web-scan-meta>div{border:1px solid var(--line);border-radius:12px;padding:10px 12px;display:grid;gap:3px}.web-progress-stats small,.web-scan-meta small{color:var(--muted)}.web-progress-stats b{font-size:20px}.web-scan-meta{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.web-scan-meta b{font-size:12px}.web-live-products{border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,#fbfdff,#fff);padding:13px;min-height:190px}.web-live-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.web-live-head>div:first-child{display:flex;align-items:center;gap:10px}.web-live-head h3{margin:0;font-size:15px}.web-live-head p{margin:2px 0 0;color:var(--muted);font-size:11px}.web-live-dot{width:10px;height:10px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,.45);animation:webLivePulse 1.4s infinite}.web-live-controls{display:flex;gap:5px}.web-live-stage{overflow:hidden;display:grid;gap:10px}.web-live-current{display:grid;grid-template-columns:150px 1fr;gap:16px;align-items:center;border:2px solid #9dc2ea;border-radius:16px;padding:14px;background:#f7fbff;min-height:170px}.web-live-current[hidden]{display:none!important}.web-live-current img,.web-live-current .web-live-noimg{width:150px;height:145px;object-fit:contain;border-radius:12px;border:1px solid var(--line);background:#fff;display:grid;place-items:center;font-size:30px}.web-live-current b{font-size:18px;line-height:1.25;display:block}.web-live-current small{display:block;color:var(--muted);margin-top:7px}.web-live-current strong{display:block;color:#0b5eaa;margin-top:8px;font-size:17px}.web-live-current a{display:inline-flex;margin-top:9px;color:var(--primary);font-weight:900;text-decoration:none}.web-live-current em{display:block;color:#b45309;font-style:normal;margin-top:7px;font-size:11px}.web-live-track{display:flex;gap:10px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;padding:2px}.web-live-track::-webkit-scrollbar{display:none}.web-live-product{flex:0 0 240px;display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;border:1px solid var(--line);border-radius:13px;padding:9px;background:#fff;min-height:98px}.web-live-product.is-new{animation:webCardIn .35s ease both}.web-live-product img,.web-live-product .web-live-noimg{width:76px;height:76px;object-fit:contain;border-radius:10px;border:1px solid var(--line);background:#fff;display:grid;place-items:center;font-size:19px}.web-live-product b{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:12px;line-height:1.28}.web-live-product small{display:block;color:var(--muted);margin-top:5px;font-size:10px}.web-live-product em{display:block;color:#b45309;font-style:normal;font-size:9px;margin-top:3px}.web-live-empty{min-height:116px;display:grid;place-items:center;align-content:center;gap:4px;text-align:center;color:var(--muted)}.web-live-empty>span{font-size:25px}.web-live-empty b{color:var(--text)}.web-live-empty small{max-width:520px}.web-progress-error{padding:12px;border:1px solid #fecaca;background:#fff1f2;color:#991b1b;border-radius:12px}.web-progress-ready[hidden],.web-progress-error[hidden],#webScanCancelForm[hidden],#webScanRetryForm[hidden]{display:none!important}.web-progress-ready{display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid #86efac;background:#f0fdf4;border-radius:12px;padding:12px}.web-progress-ready>div{display:grid;gap:3px}.web-progress-ready span{color:#166534;font-size:12px}.web-progress-foot{display:flex;justify-content:space-between;gap:12px;align-items:center;color:var(--muted);font-size:12px}.web-progress-foot form{margin:0}.web-progress-foot .row-actions .btn{max-width:none!important;overflow:visible!important;text-overflow:clip!important}@keyframes webScanMove{0%{left:-34%}100%{left:100%}}@keyframes webLivePulse{70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}@keyframes webCardIn{from{opacity:.2;transform:translateY(5px)}to{opacity:1;transform:none}}@media(max-width:780px){.web-live-current{grid-template-columns:1fr}.web-live-current img,.web-live-current .web-live-noimg{width:100%;height:180px}.web-progress-stats,.web-scan-meta{grid-template-columns:1fr 1fr}.web-progress-head,.web-progress-foot,.web-progress-ready{align-items:flex-start;flex-direction:column}.web-live-product{flex-basis:210px}}
.web-import-center-toast{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) scale(.96);z-index:9999;min-width:min(520px,calc(100vw - 32px));max-width:700px;padding:22px 26px;border-radius:18px;border:1px solid #86efac;background:#f0fdf4;color:#14532d;box-shadow:0 22px 80px rgba(15,23,42,.28);display:grid;gap:7px;text-align:center;opacity:0;transition:.22s ease}.web-import-center-toast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}.web-import-center-toast b{font-size:19px}.web-import-center-toast small{color:#367151}.web-import-center-toast.error{border-color:#fecaca;background:#fff1f2;color:#991b1b}
</style>
