<% layout('layout') -%>
<header class="page-head"><div><span class="eyebrow">📚 PROFORMADAN ÜRÜN AKTAR</span><h1>İçe Aktarma Geçmişi</h1><p>Eklenen, güncellenen ve atlanan ürünlerin ayrıntılı işlem kaydı.</p></div><div class="row-actions"><a class="btn" href="/products/import-proforma">Yeni Aktarım</a><a class="btn btn--primary" href="/products/import-proforma/history.xls">Excel Raporu</a></div></header><section class="card"><div class="table-scroll"><table class="lined"><thead><tr><th>Tarih</th><th>Dosya</th><th>Durum</th><th>Bulunan</th><th>Seçilen</th><th>Yeni</th><th>Güncellenen</th><th>Atlanan</th><th>Uyarı</th><th>Süre</th></tr></thead><tbody><% history.forEach(x=>{ %><tr><td><%=new Date(x.created_at).toLocaleString('tr-TR')%></td><td><b><%=x.source_name||'-'%></b></td><td><span class="tag"><%=x.status%></span></td><td><%=x.detected_count%></td><td><%=x.selected_count%></td><td><%=x.added_count%></td><td><%=x.updated_count%></td><td><%=x.skipped_count%></td><td><%=x.warning_count%></td><td><%=(x.duration_ms/1000).toFixed(2)%> sn</td></tr><% }) %><% if(!history.length){ %><tr><td colspan="10" class="muted">Henüz aktarım kaydı yok.</td></tr><% } %></tbody></table></div></section>
