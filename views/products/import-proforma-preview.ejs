<% layout('layout') -%>
<%
 const en=locale==='en';
 const L=en?{title:'Scan Preview',back:'Product List',review:'Review warnings',source:'Source file',found:'Detected products',method:'Save method',methodValue:'Update matching code, otherwise add',manual:'Manual editing',manualValue:'Every field is editable',rows:'Product Lines',help:'Only real product rows are shown. Review every field before saving.',add:'Add Blank Row',select:'Select',preview:'Preview',image:'Image',code:'Product Code',nameDesc:'Product Name and Description',qty:'Quantity',unit:'Unit',price:'Unit Price',currency:'Currency',vat:'VAT',duplicate:'Matching Code',check:'Review',save:'Save Selected Products',cancel:'Cancel Without Saving'}:{title:'Tarama Ön İzlemesi',back:'Ürün Listesi',review:'Kontrol gerektiren noktalar',source:'Kaynak dosya',found:'Bulunan ürün',method:'Kayıt yöntemi',methodValue:'Kod varsa güncelle, yoksa ekle',manual:'Manuel düzenleme',manualValue:'Her alan düzenlenebilir',rows:'Ürün Satırları',help:'Yalnızca gerçek ürün satırları gösterilir. Kaydetmeden önce tüm alanları kontrol edin.',add:'Boş Satır Ekle',select:'Seç',preview:'Ön İzle',image:'Görsel',code:'Ürün Kodu',nameDesc:'Ürün Adı ve Açıklama',qty:'Miktar',unit:'Birim',price:'Birim Fiyat',currency:'Para',vat:'KDV',duplicate:'Aynı Kod',check:'Kontrol',save:'Seçili Ürünleri Kaydet',cancel:'Vazgeç ve Kayıt Oluşturma'};
 const money=v=>{const n=Number(v||0);return Number.isFinite(n)?String(Number(n.toFixed(4))):'0'};
%>
<header class="page-head pro-headline product-import-head"><div><span class="eyebrow">✨ PROFORMADAN ÜRÜN AKTAR</span><h1><%=L.title%></h1><p><b><%=source?.name||'-'%></b> · <%=source?.type||'-'%> · <%=Math.max(0,Number(source?.size||0)/1024/1024).toFixed(2)%> MB</p></div><div class="row-actions"><a class="btn btn--sm" href="/products">← <%=L.back%></a></div></header>
<% if(warnings.length){ %><section class="card import-warning-card"><div class="card-head"><h2>⚠️ <%=L.review%></h2></div><ul><% warnings.forEach(w=>{ %><li><%=w%></li><% }) %></ul></section><% } %>
<section class="card proforma-import-summary"><div><span>📄</span><small><%=L.source%></small><b><%=source?.name||'-'%></b></div><div><span>📦</span><small><%=L.found%></small><b data-import-row-count><%=rows.length%></b></div><div><span>🛡️</span><small><%=L.method%></small><b><%=L.methodValue%></b></div><div><span>✍️</span><small><%=L.manual%></small><b><%=L.manualValue%></b></div></section>
<section class="card import-tools-card"><div class="card-head"><div><h2>🧭 Alan Eşleştirme ve Toplu Düzenleme</h2><small>Seçili ürünlere ortak birim, para birimi ve KDV uygulayın; dilerseniz tedarikçi şablonu olarak kaydedin.</small></div></div><div class="import-tool-grid"><label>Kayıtlı şablon<select data-import-template-select><option value="">Şablon seçin</option><% (templates||[]).forEach(t=>{ %><option value="<%=t.id%>" data-defaults='<%-JSON.stringify(t.defaults||{})%>'><%=t.name%></option><% }) %></select></label><label>Şablon adı<input form="proformaProductImportForm" name="template_name" placeholder="Örn. ABC Tedarikçi"></label><label class="check-line"><input form="proformaProductImportForm" type="checkbox" name="remember_template" value="1"> Eşleştirmeyi hatırla</label><label>Birim<input form="proformaProductImportForm" name="bulk_unit" data-bulk-source="unit" placeholder="ADET"></label><label>Para<select form="proformaProductImportForm" name="bulk_currency" data-bulk-source="currency"><option value="">Değiştirme</option><option>TRY</option><option>EUR</option><option>USD</option></select></label><label>KDV %<input form="proformaProductImportForm" name="bulk_vat" data-bulk-source="vat_rate" type="number" step="0.01" placeholder="20"></label><button type="button" class="btn btn--soft" data-apply-bulk>Seçili Satırlara Uygula</button></div></section>
<form id="proformaProductImportForm" method="post" action="/products/import-proforma/<%=token%>/save?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data" data-confirm="Seçili ürünler kaydedilsin mi?"><input type="hidden" name="_csrf" value="<%=csrfToken%>">
<section class="card import-preview-card import-preview-card-v367"><div class="card-head"><div><h2><%=L.rows%></h2><small><%=L.help%></small></div><button class="btn btn--sm btn--soft" type="button" data-import-add-row>＋ <%=L.add%></button></div>
<div class="table-scroll import-products-fit"><table class="lined import-products-table import-products-table-v367"><colgroup><col class="c-select"><col class="c-preview"><col class="c-image"><col class="c-code"><col class="c-main"><col class="c-qty"><col class="c-unit"><col class="c-price"><col class="c-currency"><col class="c-vat"><col class="c-duplicate"><col class="c-check"></colgroup><thead><tr><th><%=L.select%></th><th><%=L.preview%></th><th><%=L.image%></th><th><%=L.code%></th><th><%=L.nameDesc%></th><th><%=L.qty%></th><th><%=L.unit%></th><th><%=L.price%></th><th><%=L.currency%></th><th><%=L.vat%></th><th><%=L.duplicate%></th><th><%=L.check%></th></tr></thead><tbody data-import-rows>
<% rows.forEach((row,index)=>{ const duplicate=existingCodes.has(String(row.code||'').toLocaleUpperCase('tr-TR')); %><tr data-import-row data-row-index="<%=index%>" class="<%=row.warning?'has-warning':''%>" data-existing-code="<%=duplicate?'1':'0'%>">
<td><input type="hidden" name="rows[<%=index%>][selected]" value="0"><input type="checkbox" name="rows[<%=index%>][selected]" value="1" <%=row.selected!==false?'checked':''%>></td>
<td class="actions-cell actions-cell--1"><button type="button" class="table-action is-preview" data-import-preview data-label="<%=L.preview%>" title="<%=L.preview%>" aria-label="<%=L.preview%>"><%- include('../partials/table-action-icon',{iconName:'preview'}) %></button></td>
<td><label class="import-product-image-cell import-product-image-cell-v371"><span class="import-product-image-box"><% if(row.image_url){ %><img src="<%=row.image_url%>" alt=""><% }else{ %><span>Görsel</span><% } %></span><input type="file" name="rows[<%=index%>][image_file]" accept="image/jpeg,image/png,image/webp" data-field="image_file" class="import-image-file-v371"><small data-image-file-name><%=en?'Choose image':'Görsel seç'%></small></label><input type="hidden" name="rows[<%=index%>][image_url]" value="<%=row.image_url||''%>" data-field="image_url"></td>
<td><input required name="rows[<%=index%>][code]" value="<%=row.code||''%>" data-field="code"></td>
<td><div class="import-name-description"><textarea required rows="2" name="rows[<%=index%>][name]" data-field="name" placeholder="Ürün adı"><%=row.name||''%></textarea><textarea rows="3" name="rows[<%=index%>][description]" data-field="description" placeholder="Açıklama"><%=row.description||''%></textarea></div></td>
<td><input type="number" min="0.0001" step="0.0001" name="rows[<%=index%>][qty]" value="<%=money(row.qty||1)%>" data-field="qty"></td>
<td><input name="rows[<%=index%>][unit]" value="<%=row.unit||'ADET'%>" data-field="unit"></td>
<td><input type="number" min="0" step="0.01" inputmode="decimal" name="rows[<%=index%>][price]" value="<%=money(row.price||0)%>" data-field="price"></td>
<td><select name="rows[<%=index%>][currency]" data-field="currency"><% ['TRY','EUR','USD'].forEach(c=>{ %><option value="<%=c%>" <%=row.currency===c?'selected':''%>><%=c%></option><% }) %></select></td>
<td><input type="number" min="0" step="0.01" name="rows[<%=index%>][vat_rate]" value="<%=money(row.vat_rate??20)%>" data-field="vat_rate"></td>
<td><select name="rows[<%=index%>][duplicate_action]" data-field="duplicate_action"><option value="update"><%=duplicate?'Güncelle':'Yeni ekle'%></option><option value="new">Yeni kodla oluştur</option><option value="skip">Atla</option></select></td>
<td><span class="import-warning"><%=row.warning?'⚠️ '+row.warning:'✓ Uygun'%></span></td>
</tr><% }) %></tbody></table></div></section>
</form>
<div class="import-action-dock-v14" role="region" aria-label="<%=en?'Import actions':'Aktarım işlemleri'%>">
 <div class="import-action-dock-copy-v14"><b><%=en?'Review and finish':'Kontrol et ve tamamla'%></b><span><%=en?'Only selected rows will be saved.':'Yalnızca seçili ürün satırları kaydedilir.'%></span></div>
 <div class="import-action-dock-buttons-v14">
  <button class="btn btn--primary" type="submit" form="proformaProductImportForm">💾 <%=L.save%></button>
  <form method="post" action="/products/import-proforma/<%=token%>/cancel" class="import-cancel-form" data-confirm-kind="cancel" data-confirm-title="<%=en?'Cancel import':'Aktarımdan Vazgeçme Onayı'%>" data-confirm-message="<%=en?'All edits in this preview will be discarded and no product will be saved. Continue?':'Bu ön izlemedeki tüm düzenlemeler kaydedilmeden silinecek ve hiçbir ürün oluşturulmayacaktır. Vazgeçilsin mi?'%>" data-confirm-ok="<%=en?'Yes, discard':'Evet, Vazgeç'%>" data-confirm-danger="1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="btn btn--danger" type="submit">× <%=L.cancel%></button></form>
 </div>
</div>
<div class="modal import-product-preview-modal" id="importProductPreviewModal" aria-hidden="true"><div class="modal-card import-product-preview-card"><button type="button" class="modal-close" data-import-preview-close>×</button><div data-import-preview-content></div></div></div>
