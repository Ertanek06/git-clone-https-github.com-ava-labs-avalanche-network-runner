<!doctype html>
<html lang="<%=String(locale||'tr').startsWith('en')?'en':'tr'%>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%=row.name%> — Katalog Çıktısı Yazdır</title>
<style nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">
@page{size:A4 portrait;margin:0}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#eef2f7;color:#172338;font-family:Arial,Helvetica,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}body{padding:18px}.catalog-sheet-v133{width:210mm;min-height:297mm;margin:0 auto;background:#fff;box-shadow:0 10px 35px rgba(20,40,70,.12);position:relative;padding:15mm 14mm 24mm;overflow:visible}.catalog-head-v133{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px;padding-bottom:10mm;border-bottom:2px solid #213a5f;break-inside:avoid-page;page-break-inside:avoid}.catalog-brand-v133{display:flex;align-items:center;gap:14px;min-width:0}.catalog-brand-v133 img{display:block;width:46mm;height:24mm;object-fit:contain;object-position:left center}.catalog-brand-v133 h1{margin:0;font-size:17px;line-height:1.25}.catalog-brand-v133 p{margin:4px 0 0;color:#607087;font-size:10px}.catalog-tag-v133{padding:7px 12px;border:1px solid #c5d4e6;border-radius:999px;font-size:10px;font-weight:800;color:#31577f;background:#f5f9ff}.catalog-product-v133{display:grid;grid-template-columns:72mm minmax(0,1fr);gap:12mm;padding:12mm 0 8mm;break-inside:avoid-page;page-break-inside:avoid}.catalog-image-v133{display:flex;align-items:center;justify-content:center;width:72mm;height:92mm;border:1px solid #d5dfeb;border-radius:8px;background:#fff;overflow:hidden;break-inside:avoid-page;page-break-inside:avoid}.catalog-image-v133 img{display:block;max-width:100%;max-height:100%;width:auto!important;height:auto!important;object-fit:contain!important;object-position:center center!important}.catalog-image-empty-v133{font-size:12px;color:#8a97a8;text-align:center;padding:10px}.catalog-title-v133{margin:0 0 4mm;font-size:24px;line-height:1.15;color:#142d4f}.catalog-code-v133{display:inline-flex;padding:5px 9px;border-radius:999px;background:#edf4fc;color:#2c5f94;font-size:10px;font-weight:800}.catalog-meta-v133{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;margin-top:7mm}.catalog-meta-v133 div{padding:7px 8px;border:1px solid #d9e3ee;border-radius:6px;background:#fbfdff}.catalog-meta-v133 small{display:block;color:#74849a;font-size:8px;font-weight:700}.catalog-meta-v133 b{display:block;margin-top:2px;font-size:10px;overflow-wrap:anywhere}.catalog-description-v133{margin-top:5mm;padding-top:7mm;border-top:1px solid #d7e1ec}.catalog-description-v133 h2{margin:0 0 4mm;font-size:14px;color:#1b4775;break-after:avoid}.catalog-description-v133 div{white-space:pre-wrap;overflow-wrap:anywhere;font-size:10.3px;line-height:1.48;color:#26394e}.catalog-footer-v133{position:absolute;left:14mm;right:14mm;bottom:9mm;display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;padding-top:4mm;border-top:1px solid #cbd7e4;color:#4f6279;font-size:8.5px}.catalog-footer-v133 span{overflow-wrap:anywhere}.catalog-no-price-v133{font-size:8px;color:#8b98a8;text-align:right}
@media print{html,body{width:210mm;background:#fff}body{padding:0}.catalog-sheet-v133{width:210mm;min-height:297mm;margin:0;box-shadow:none;overflow:visible}.catalog-head-v133,.catalog-product-v133,.catalog-image-v133{break-inside:avoid-page!important;page-break-inside:avoid!important}.catalog-image-v133 img{max-width:100%!important;max-height:100%!important;width:auto!important;height:auto!important;object-fit:contain!important}.catalog-no-price-v133{display:none}}
@media(max-width:800px){body{padding:0}.catalog-sheet-v133{width:100%;min-height:100vh;padding:20px 18px 70px}.catalog-product-v133{grid-template-columns:1fr}.catalog-image-v133{width:100%;height:280px}.catalog-head-v133{grid-template-columns:1fr}.catalog-brand-v133 img{width:150px;height:70px}.catalog-footer-v133{left:18px;right:18px;bottom:18px;grid-template-columns:1fr}}
</style>
</head>
<body>
<%
 const en=String(locale||'tr').startsWith('en');
 const profile=typeof activeProfile!=='undefined'?activeProfile:{};
 const desc=[row.short_description,row.technical_description,row.description_combined,row.description].map(v=>String(v||'').trim()).filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join('\n');
 const firmAddress=profile.footer_address||profile.billing_address||profile.address||[profile.district,profile.city,profile.country].filter(Boolean).join(' · ');
 const catalogImage=String(row.image_url||row.image_path||'').trim();
 const catalogImageFallback=String(row.image_path||'').trim()&&String(row.image_path||'').trim()!==catalogImage?String(row.image_path||'').trim():'';
%>
<article class="catalog-sheet-v133">
 <header class="catalog-head-v133">
  <div class="catalog-brand-v133"><% if(profile.logo_url){ %><img src="<%=profile.logo_url%>" alt="<%=profile.company_name||''%>" data-catalog-image><% } %><div><h1><%=profile.company_name||profile.short_name||'ARTEVA'%></h1><p><%=[profile.phone,profile.email,profile.website].filter(Boolean).join(' · ')%></p></div></div>
  <span class="catalog-tag-v133"><%=en?'PRODUCT CATALOG':'ÜRÜN KATALOĞU'%></span>
 </header>
 <section class="catalog-product-v133">
  <div class="catalog-image-v133"><% if(catalogImage){ %><img src="<%=catalogImage%>" alt="<%=row.name%>" data-catalog-image data-catalog-image-fallback="<%=catalogImageFallback%>"><% } %><span class="catalog-image-empty-v133" data-catalog-image-empty <%=catalogImage?'hidden':''%>><%=en?'Product image unavailable':'Ürün görseli bulunamadı'%></span></div>
  <div><h2 class="catalog-title-v133"><%=row.name%></h2><span class="catalog-code-v133"><%=en?'Code':'Ürün Kodu'%>: <%=row.code||'-'%></span><div class="catalog-meta-v133"><div><small><%=en?'Brand / Model':'Marka / Model'%></small><b><%=[row.brand,row.model].filter(Boolean).join(' / ')||'-'%></b></div><div><small><%=en?'Category':'Kategori'%></small><b><%=row.category||'-'%></b></div><div><small>GTİP</small><b><%=row.gtip_no||'-'%></b></div><div><small><%=en?'Origin':'Menşei'%></small><b><%=row.origin_country||'-'%></b></div></div><p class="catalog-no-price-v133"><%=en?'Price is intentionally excluded from catalog output.':'Katalog çıktısında fiyat bilgisi gösterilmez.'%></p></div>
 </section>
 <section class="catalog-description-v133"><h2><%=en?'Product Description':'Ürün Açıklaması'%></h2><div><%=desc||(en?'No product description.':'Ürün açıklaması bulunmuyor.')%></div></section>
 <footer class="catalog-footer-v133"><span><%=firmAddress||''%></span><span><%=profile.email||profile.footer_email||''%></span><span><%=profile.phone||profile.footer_phone||''%></span></footer>
</article>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">
(()=>{const images=[...document.querySelectorAll('[data-catalog-image]')];const guard=img=>new Promise(resolve=>{const done=async ok=>{if(!ok){const fallback=String(img.dataset.catalogImageFallback||'').trim();if(fallback&&img.dataset.catalogFallbackTried!=='1'){img.dataset.catalogFallbackTried='1';img.src=fallback;return}img.hidden=true;const empty=img.closest('.catalog-image-v133')?.querySelector('[data-catalog-image-empty]');if(empty)empty.hidden=false}try{if(ok&&img.decode)await img.decode()}catch{}resolve()};if(img.complete&&img.naturalWidth)return done(true);img.addEventListener('load',()=>done(true),{once:true});img.addEventListener('error',()=>done(false))});const ready=Promise.all(images.map(guard));if(<%=autoPrint?'true':'false'%>){Promise.race([ready,new Promise(r=>setTimeout(r,8000))]).then(()=>requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(()=>window.print(),180))))}})();
</script>
</body></html>
