<!doctype html>
<html lang="<%=String(locale||'tr').startsWith('en')?'en':'tr'%>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="csrf-token" content="<%=csrfToken%>"><meta name="crm-build" content="crmv1.45">
  <title><%=row.name%> — Ürün Ön İzleme</title>
  <link rel="stylesheet" href="<%=(typeof assetBundle!=='undefined'&&assetBundle?.styles)||'/public/css/app.css'%>"><link rel="stylesheet" href="/settings/theme.css?v=<%=(typeof ui!=='undefined'&&ui?.updated_at)||'preview'%>&amp;b=crmv1.45">
  <style nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>" id="crmv133-product-preview-inline-edit">
    html,body.product-preview-v20-page{height:auto!important;min-height:100%!important;max-height:none!important;overflow-x:hidden!important;overflow-y:auto!important}
    body.product-preview-v20-page{display:flex!important;align-items:flex-start!important;justify-content:center!important;padding:10px!important}
    .product-preview-studio-v20{width:100%!important;height:auto!important;min-height:0!important;max-height:none!important;overflow:visible!important}
    .product-preview-studio-v20__head{padding:10px 12px!important;gap:9px!important}.product-preview-studio-v20__heading{min-width:0;flex:1}.product-preview-studio-v20__heading h1{font-size:18px!important;line-height:1.18!important;margin:2px 0 5px!important}.product-preview-studio-v20__body{grid-template-columns:210px minmax(0,1fr)!important;gap:10px!important;padding:10px!important}.product-preview-studio-v20__image{height:190px!important;min-height:0!important}.product-preview-studio-v20__content{gap:8px!important}.product-preview-studio-v20__facts{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important}.product-preview-studio-v20__facts>div{padding:7px 8px!important;min-height:50px!important}.product-preview-studio-v20__description{padding:9px 10px!important}.product-preview-studio-v20__description-text,[data-product-display-description]{max-height:none!important;overflow:visible!important}.product-preview-studio-v20__content,.product-preview-studio-v20__description{height:auto!important;min-height:0!important;-webkit-line-clamp:unset!important;text-overflow:clip!important}.product-preview-studio-v20__description-text,[data-product-display-description]{display:block!important;white-space:pre-wrap!important;overflow-wrap:anywhere!important;line-height:1.55!important}
    .product-preview-studio-v20__price,.product-preview-price-v16{border:1px solid #cbd9ea!important;background:#fff!important;color:#132238!important;box-shadow:0 8px 20px rgba(15,35,65,.08)!important}.product-preview-price-v16 small,.product-preview-price-v16 span,.product-preview-price-v16 em{color:#52677f!important}.product-preview-price-v16 [data-product-display-price],.product-preview-price-pill-v21{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:max-content!important;max-width:100%!important;padding:8px 14px!important;border:1px solid #6f9fd5!important;border-radius:999px!important;background:#dcecff!important;background-image:none!important;color:#083b73!important;-webkit-text-fill-color:#083b73!important;text-shadow:none!important;box-shadow:0 5px 14px rgba(23,91,166,.14)!important;font-size:21px!important;font-weight:900!important;line-height:1.08!important;white-space:nowrap!important;visibility:visible!important;opacity:1!important}
    .product-preview-studio-v20__image{position:relative!important;overflow:hidden!important}.product-preview-studio-v20__image>[data-product-image-empty][hidden],.product-preview-studio-v20__image>img[hidden]{display:none!important}.product-preview-image-upload-v27{position:absolute!important;left:50%!important;bottom:10px!important;z-index:6!important;transform:translateX(-50%)!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;min-height:34px!important;max-width:calc(100% - 20px)!important;padding:7px 12px!important;border:1px solid rgba(255,255,255,.92)!important;border-radius:999px!important;background:rgba(14,64,121,.92)!important;color:#fff!important;-webkit-text-fill-color:#fff!important;box-shadow:0 6px 18px rgba(12,42,78,.28)!important;font-size:12px!important;font-weight:800!important;line-height:1!important;white-space:nowrap!important;cursor:pointer!important;backdrop-filter:blur(6px)!important}.product-preview-image-upload-v27:hover{background:#0d5faa!important}.product-preview-image-upload-v27[disabled]{opacity:.68!important;cursor:wait!important}
    [data-inline-edit-only][hidden],[data-product-edit-action][hidden]{display:none!important}.product-inline-control-v133{width:100%!important;min-width:0!important;min-height:34px!important;padding:7px 9px!important;border:1px solid #8fb2db!important;border-radius:9px!important;background:#fff!important;color:#10243d!important;font:700 13px/1.25 inherit!important;box-shadow:0 0 0 2px rgba(45,118,198,.06)!important}.product-inline-control-v133:focus{outline:2px solid rgba(45,118,198,.22)!important;border-color:#2f76c4!important}.product-inline-title-v133{font-size:18px!important;font-weight:900!important}.product-inline-pair-v133{display:grid!important;grid-template-columns:1fr 1fr!important;gap:6px!important}.product-inline-price-editor-v133{display:grid!important;grid-template-columns:1fr 92px!important;gap:6px!important;align-items:end!important}.product-inline-price-editor-v133 label{display:grid;gap:3px;font-size:11px;font-weight:800;color:#52677f}.product-inline-price-editor-v133 .vat{grid-column:1/-1}.product-inline-description-v133{width:100%!important;min-height:210px!important;resize:vertical!important;white-space:pre-wrap!important;line-height:1.5!important}.product-preview-studio-v20__head-actions{flex-wrap:wrap!important;justify-content:flex-end!important}.product-inline-save-v133{background:#168a54!important;color:#fff!important}.product-inline-delete-v133{background:#fff1f1!important;color:#b42318!important;border-color:#f0b5b5!important}.is-inline-edit-v133 [data-product-price-adjust]{display:none!important}.is-inline-edit-v133 .product-preview-studio-v20__facts>div,.is-inline-edit-v133 .product-preview-studio-v20__description,.is-inline-edit-v133 .product-preview-studio-v20__price{border-color:#8fb2db!important;background:#f9fcff!important}.is-inline-edit-v133 .product-preview-studio-v20__head{box-shadow:inset 0 -2px 0 #2f76c4}.product-inline-edit-note-v133{display:none;margin:0 0 8px;padding:7px 9px;border-radius:9px;background:#eaf4ff;color:#245b98;font-size:11px;font-weight:800}.is-inline-edit-v133 .product-inline-edit-note-v133{display:block}
    .product-preview-studio-v20__documents{display:grid!important;gap:8px!important}.product-document-edit-row-v133{display:grid;gap:6px;padding:9px;border:1px solid #9dbbdd;border-radius:11px;background:#f9fcff}.product-document-edit-row-v133__top{display:flex;align-items:center;justify-content:space-between;gap:8px}.product-document-edit-row-v133__top b{font-size:12px}.product-document-edit-row-v133__top small{min-width:0;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#52677f}.product-document-edit-row-v133 input[type=file]{width:100%;font-size:11px}.product-document-remove-v133{display:flex!important;align-items:center;gap:6px!important;font-size:11px!important;color:#9c2f2f!important;font-weight:800!important}.product-document-remove-v133 input{width:auto!important}.product-document-empty-v133{padding:10px;border:1px dashed #b8c9dc;border-radius:10px;color:#6a7c91;font-size:11px;text-align:center}.product-preview-link-edit-v133{margin-top:10px}
    .product-price-adjust-v16{display:grid!important;gap:7px!important;margin-top:8px!important;padding:9px!important;border:1px solid #cbd9ea!important;border-radius:11px!important;background:#fff!important;box-shadow:0 6px 18px rgba(15,35,65,.06)!important}.product-price-adjust-v16>label{display:grid!important;gap:3px!important;font-size:11px!important;font-weight:800!important;color:#52677f!important}.product-price-adjust-v16>div{display:flex!important;gap:6px!important;flex-wrap:wrap!important}.product-price-adjust-v16 small{min-height:14px!important;color:#52677f!important}
    @media(max-width:760px){body.product-preview-v20-page{padding:6px!important}.product-preview-studio-v20__head{padding:9px 10px!important}.product-preview-studio-v20__body{grid-template-columns:1fr!important;padding:8px!important}.product-preview-studio-v20__image{height:190px!important}.product-preview-studio-v20__facts{grid-template-columns:repeat(2,minmax(0,1fr))!important}.product-preview-studio-v20__head-actions{width:100%!important;justify-content:flex-start!important}.product-preview-studio-v20__logo{margin-left:auto}.product-inline-pair-v133{grid-template-columns:1fr!important}}
  </style>
</head>
<body class="preview-document product-preview-v20-page">
<%
 const en=String(locale||'tr').startsWith('en');
 const profile=typeof activeProfile!=='undefined'?activeProfile:{};
 const desc=[row.short_description,row.technical_description,row.description_combined,row.description,row.product_description,row.details].map(v=>String(v||'').replace(/\r\n?/g,'\n').split('\n').map(line=>line.trim()).filter(Boolean).join('\n')).filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join('\n');
 const productUrl=row.product_url||row.url||'';
 const previewImage=String(row.image_url||row.image_path||'').trim();
 const previewImageFallback=String(row.image_path||'').trim()&&String(row.image_path||'').trim()!==previewImage?String(row.image_path||'').trim():'';
 const money=Number(row.sale_price||0).toLocaleString(en?'en-GB':'tr-TR',{minimumFractionDigits:0,maximumFractionDigits:2});
 const moneyCurrency=String(row.currency||'TRY').trim().toUpperCase()||'TRY';
 const docName=(url)=>{try{const raw=decodeURIComponent(String(url||'').split('?')[0]);return raw.split('/').filter(Boolean).pop()||''}catch{return String(url||'')}};
 const documentDefs=[
  {key:'brochure',label:en?'Brochure':'Broşür',icon:'📎',url:row.brochure_url||'',previewUrl:`/products/${encodeURIComponent(row.id)}/document/brochure/preview`,field:'brochure',remove:'remove_brochure'},
  {key:'ce',label:en?'CE Certificate':'CE Belgesi',icon:'📄',url:row.ce_certificate_url||'',previewUrl:`/products/${encodeURIComponent(row.id)}/document/ce/preview`,field:'ce_certificate',remove:'remove_ce_certificate'},
  {key:'manual',label:en?'User Manual':'Kullanma Kılavuzu',icon:'📘',url:row.manual_url||'',previewUrl:`/products/${encodeURIComponent(row.id)}/document/manual/preview`,field:'user_manual',remove:'remove_user_manual'}
 ];
 const documents=documentDefs.filter(d=>d.url);
%>
<article class="product-preview-studio-v20 product-card-preview-v16" data-product-preview-studio>
  <header class="product-preview-studio-v20__head">
    <div class="product-preview-studio-v20__heading">
      <span class="eyebrow"><%=en?'PRODUCT / SERVICE PREVIEW':'ÜRÜN / HİZMET ÖN İZLEME'%></span>
      <h1 data-inline-display data-product-display-name><%=row.name%></h1>
      <% if(canEdit){ %><input class="product-inline-control-v133 product-inline-title-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="name" required value="<%=row.name||''%>" hidden><% } %>
      <div class="product-preview-studio-v20__chips" data-inline-display>
        <span><b><%=en?'Code':'Kod'%>:</b> <i data-product-display-code><%=row.code||'-'%></i></span>
        <% if(row.brand){ %><span><%=row.brand%></span><% } %><% if(row.model){ %><span><%=row.model%></span><% } %><% if(row.category){ %><span><%=row.category%></span><% } %>
      </div>
    </div>
    <div class="product-preview-studio-v20__head-actions">
      <button class="product-preview-back-v3" type="button" data-history-back data-history-fallback="/products" aria-label="<%=en?'Back':'Geri'%>" title="<%=en?'Back':'Geri'%>">←</button>
      <% if(profile?.logo_url){ %><img class="product-preview-studio-v20__logo" src="<%=profile.logo_url%>" alt=""><% } %>
      <% if(productUrl){ %><a class="btn btn--soft btn--sm product-preview-studio-v20__link" data-inline-display href="<%=productUrl%>" target="_blank" rel="noopener noreferrer">↗ <%=en?'Open Product Link':'Ürün Linkini Aç'%></a><% } %>
      <% if(canEdit){ %>
       <button class="btn btn--primary btn--sm" type="button" data-product-edit-toggle>✎ <%=en?'Edit on Card':'Kart Üzerinde Düzenle'%></button>
       <button class="btn btn--sm product-inline-save-v133" type="submit" form="productInlineEditFormV133" data-product-edit-action hidden>💾 <%=en?'Save':'Kaydet'%></button>
       <button class="btn btn--soft btn--sm" type="button" data-product-edit-cancel data-product-edit-action hidden>↶ <%=en?'Cancel':'Vazgeç'%></button>
       <% if(typeof canArchive!=='undefined'&&canArchive){ %><button class="btn btn--danger btn--sm product-inline-delete-v133" type="button" data-product-preview-delete data-product-edit-action hidden>🗑 <%=en?'Delete':'Sil'%></button><% } %>
      <% } %>
    </div>
  </header>
  <% if(canEdit){ %><form id="productInlineEditFormV133" data-product-edit-form enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="id" value="<%=row.id%>"></form><% } %>

  <div class="product-preview-studio-v20__body">
    <aside class="product-preview-studio-v20__media">
      <div class="product-preview-studio-v20__image" data-product-image-box>
        <% if(previewImage){ %><img src="<%=previewImage%>" alt="<%=row.name%>" data-product-display-image data-product-image-fallback="<%=previewImageFallback%>"><% } %><span data-product-image-empty <%=previewImage?'hidden':''%>>＋<small><%=row.image_url?(en?'Image unavailable — upload again':'Görsel bulunamadı — yeniden yükle'):(en?'Add product image':'Ürün görseli ekle')%></small></span>
        <% if(canEdit){ %><button class="product-preview-image-upload-v27" type="button" data-product-image-upload>📷 <span><%=previewImage?(en?'Change Image':'Görseli Değiştir'):(en?'Add Image':'Görsel Ekle')%></span></button><input type="file" accept="image/jpeg,image/png,image/webp" data-product-image-quick-input hidden><% } %>
      </div>
      <div class="product-preview-studio-v20__price product-preview-price-v16" data-product-price-card>
        <small><%=en?'Sale price':'Satış fiyatı'%></small>
        <div data-inline-display><b class="product-preview-price-pill-v21" data-product-display-price><%=money%> <%=moneyCurrency%></b><span><%=row.unit||'ADET'%> · <%=en?'VAT':'KDV'%> %<%=row.vat_rate??20%></span><% if(lastPriceHistory){ %><em><%=en?'Previous price':'Eski fiyat'%>: <%=Number(lastPriceHistory.old_price||0).toLocaleString(en?'en-GB':'tr-TR',{maximumFractionDigits:2})%> <%=lastPriceHistory.currency||moneyCurrency%></em><% } %></div>
        <% if(canEditFinancials){ %><div class="product-inline-price-editor-v133" data-inline-edit-only hidden><label><span><%=en?'Sale price':'Satış fiyatı'%></span><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="sale_price" type="number" min="0" step="0.01" value="<%=row.sale_price||0%>"></label><label><span><%=en?'Currency':'Para birimi'%></span><select class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="currency"><% ['TRY','EUR','USD'].forEach(x=>{ %><option value="<%=x%>" <%=String(row.currency||'TRY').toUpperCase()===x?'selected':''%>><%=x%></option><% }) %></select></label><label class="vat"><span><%=en?'VAT':'KDV'%> %</span><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="vat_rate" type="number" min="0" step="0.01" value="<%=row.vat_rate??20%>"></label></div><% } %>
      </div>
      <% if(canEditFinancials){ %><form class="product-price-adjust-v16" data-product-price-adjust><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label><span><%=en?'Update type':'Güncelleme türü'%></span><select name="mode"><option value="PERCENT">%</option><option value="AMOUNT"><%=en?'Amount':'Tutar'%></option></select></label><label><span><%=en?'Value':'Değer'%></span><input name="value" type="number" min="0.01" step="0.01" required></label><div><button class="btn btn--sm btn--success" type="submit" name="direction" value="INCREASE">＋ <%=en?'Increase':'Artır'%></button><button class="btn btn--sm btn--danger" type="submit" name="direction" value="DECREASE">− <%=en?'Decrease':'Azalt'%></button></div><button class="btn btn--sm btn--soft" type="button" data-product-price-revert <%=lastPriceHistory?'':'disabled'%>>↶ <%=en?'Return to previous price':'Eski fiyata dön'%></button><small data-product-price-status></small></form><% } %>
      <section class="product-quote-usage-v16"><button type="button" data-product-usage-toggle><b><%=usageCount||0%></b><span><%=en?'proformas use this product':'proformaya eklendi'%></span><i>⌄</i></button><div data-product-usage-list hidden><% (quoteUsage||[]).forEach(quote=>{ %><a href="/quotes/<%=quote.id%>" target="_top"><b><%=quote.quote_no%><%=Number(quote.revision_no||0)?` Rev ${quote.revision_no}`:''%></b><span><%=quote.customer_name%> · <%=quote.quote_date||'-'%></span></a><% }) %><% if(!(quoteUsage||[]).length){ %><p><%=en?'Not used in a saved proforma yet.':'Henüz kayıtlı bir proformada kullanılmadı.'%></p><% } %></div></section>
      <% if(documents.length||canEdit){ %><div class="product-preview-studio-v20__documents"><b><%=en?'Documents':'Belgeler'%></b>
        <% documents.forEach(doc=>{ %><button type="button" data-inline-display data-document-preview="<%=doc.previewUrl%>" data-document-title="<%=doc.label%>"><span><%=doc.icon%></span><b><%=doc.label%></b><small><%=en?'Live preview':'Canlı ön izle'%></small></button><% }) %>
        <% if(!documents.length){ %><div class="product-document-empty-v133" data-inline-display><%=en?'No documents saved.':'Kayıtlı belge yok.'%></div><% } %>
        <% if(canEdit){ documentDefs.forEach(doc=>{ %><div class="product-document-edit-row-v133" data-inline-edit-only hidden><div class="product-document-edit-row-v133__top"><b><%=doc.icon%> <%=doc.label%></b><small data-document-selected-name><%=doc.url?docName(doc.url):(en?'No saved file':'Kayıtlı dosya yok')%></small></div><input data-document-file-input data-inline-edit-control form="productInlineEditFormV133" name="<%=doc.field%>" type="file" accept="application/pdf"><label class="product-document-remove-v133"><input data-document-remove data-inline-edit-control form="productInlineEditFormV133" name="<%=doc.remove%>" type="checkbox" value="1" <%=doc.url?'':'disabled'%>> <%=en?'Remove saved document':'Kayıtlı belgeyi kaldır'%></label></div><% }) } %>
      </div><% } %>
    </aside>

    <main class="product-preview-studio-v20__content">
      <p class="product-inline-edit-note-v133"><%=en?'Edit the existing fields in place. No separate editor is opened.':'Mevcut alanları doğrudan yerinde düzenliyorsunuz; ayrı bir düzenleme kartı açılmaz.'%></p>
      <section class="product-preview-studio-v20__facts">
        <div><small><%=en?'Product Code':'Ürün Kodu'%></small><b data-inline-display><%=row.code||'-'%></b><% if(canEdit){ %><input class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="code" required value="<%=row.code||''%>" hidden><% } %></div>
        <div><small><%=en?'Brand / Model':'Marka / Model'%></small><b data-inline-display><%=[row.brand,row.model].filter(Boolean).join(' / ')||'-'%></b><% if(canEdit){ %><div class="product-inline-pair-v133" data-inline-edit-only hidden><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="brand" value="<%=row.brand||''%>" placeholder="<%=en?'Brand':'Marka'%>"><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="model" value="<%=row.model||''%>" placeholder="Model"></div><% } %></div>
        <div><small><%=en?'Category':'Kategori'%></small><b data-inline-display><%=row.category||'-'%></b><% if(canEdit){ %><input class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="category" value="<%=row.category||''%>" hidden><% } %></div>
        <div><small><%=en?'Unit':'Birim'%></small><b data-inline-display><%=row.unit||'-'%></b><% if(canEdit){ %><input class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="unit" value="<%=row.unit||'ADET'%>" hidden><% } %></div>
        <div><small>GTİP No</small><b data-inline-display><%=row.gtip_no||'-'%></b><% if(canEdit){ %><input class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="gtip_no" value="<%=row.gtip_no||''%>" hidden><% } %></div>
        <div><small><%=en?'Origin':'Menşei'%></small><b data-inline-display><%=row.origin_country||'-'%></b><% if(canEdit){ %><input class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="origin_country" value="<%=row.origin_country||''%>" hidden><% } %></div>
        <% if(showMoney){ %><div><small><%=en?'Stock / Minimum':'Stok / Minimum'%></small><b data-inline-display><%=row.stock_qty??0%> / <%=row.min_stock_qty??0%></b><% if(canEditFinancials){ %><div class="product-inline-pair-v133" data-inline-edit-only hidden><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="stock_qty" type="number" step="0.01" value="<%=row.stock_qty??0%>"><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="min_stock_qty" type="number" step="0.01" value="<%=row.min_stock_qty??0%>"></div><% } %></div><div><small><%=en?'Supplier':'Tedarikçi'%></small><b data-inline-display><%=row.supplier_name||'-'%></b><% if(canEditFinancials){ %><input class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="supplier_name" value="<%=row.supplier_name||''%>" hidden><% } %></div><% } %>
        <div><small><%=en?'Status':'Durum'%></small><b data-inline-display><%=row.status||'-'%></b><% if(canEdit){ %><select class="product-inline-control-v133" data-inline-edit-only data-inline-edit-control form="productInlineEditFormV133" name="status" hidden><% ['ACTIVE','PASSIVE'].forEach(x=>{ %><option value="<%=x%>" <%=String(row.status||'ACTIVE')===x?'selected':''%>><%=x%></option><% }) %></select><% } %></div>
      </section>
      <section class="product-preview-studio-v20__description">
        <div class="product-preview-studio-v20__section-title"><span>🧾</span><div><b><%=en?'Product Description':'Ürün Açıklaması'%></b><small><%=en?'Technical and short description':'Teknik ve kısa açıklama'%></small></div></div>
        <% if(desc){ %><div class="product-preview-studio-v20__description-text" data-inline-display data-product-display-description><%=desc%></div><% } else { %><p class="muted" data-inline-display data-product-display-description><%=en?'No description has been entered for this product.':'Bu ürün için açıklama girilmemiş.'%></p><% } %>
        <% if(canEdit){ %><textarea class="product-inline-control-v133 product-inline-description-v133" data-inline-edit-only data-inline-edit-control data-resizable-description form="productInlineEditFormV133" name="description_combined" hidden><%=desc%></textarea><% } %>
      </section>
      <% if(canEdit){ %><label class="product-preview-link-edit-v133" data-inline-edit-only hidden><small><%=en?'Product link':'Ürün linki'%></small><input class="product-inline-control-v133" data-inline-edit-control form="productInlineEditFormV133" name="product_url" value="<%=productUrl%>" placeholder="https://..."></label><% } %>
    </main>
  </div>

  <section class="product-document-preview-v20" data-document-panel hidden>
    <header><div><span class="eyebrow"><%=en?'DOCUMENT LIVE PREVIEW':'BELGE CANLI ÖN İZLEMESİ'%></span><h2 data-document-panel-title></h2></div><button type="button" class="btn btn--soft btn--sm" data-document-close><%=en?'Close':'Kapat'%></button></header>
    <iframe title="Belge canlı ön izlemesi" data-document-frame></iframe>
  </section>
</article>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">(()=>{try{if(window.parent!==window)window.parent.postMessage({type:'crm:preview-dom-ready-v132'},location.origin)}catch{}})();</script>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>">
(()=>{
 const studio=document.querySelector('[data-product-preview-studio]'),form=document.querySelector('[data-product-edit-form]'),description=document.querySelector('[data-resizable-description]');
 const toast=(message,error=false)=>{let node=document.querySelector('[data-product-inline-toast]');if(!node){node=document.createElement('div');node.dataset.productInlineToast='';node.className='product-inline-toast-v110';document.body.append(node)}node.textContent=message;node.classList.toggle('is-error',error);node.classList.add('is-visible');setTimeout(()=>node.classList.remove('is-visible'),2400)};
 const fitDescription=()=>{if(!description)return;description.style.height='auto';description.style.height=Math.max(210,Math.min(900,description.scrollHeight+8))+'px'};
 const toggleEdit=open=>{if(!form)return;document.body.classList.toggle('is-inline-edit-v133',open);document.querySelectorAll('[data-inline-display]').forEach(el=>el.hidden=open);document.querySelectorAll('[data-inline-edit-only]').forEach(el=>el.hidden=!open);document.querySelectorAll('[data-product-edit-action]').forEach(el=>el.hidden=!open);const trigger=document.querySelector('[data-product-edit-toggle]');if(trigger){trigger.hidden=open;trigger.setAttribute('aria-pressed',String(open))}if(open){requestAnimationFrame(()=>{fitDescription();document.querySelector('[data-inline-edit-control][name="name"]')?.focus()})}};
 document.querySelector('[data-product-edit-toggle]')?.addEventListener('click',()=>toggleEdit(true));
 document.querySelector('[data-product-edit-cancel]')?.addEventListener('click',()=>{form?.reset();document.querySelectorAll('[data-document-selected-name]').forEach((node,i)=>{const originals=<%-JSON.stringify(documentDefs.map(d=>d.url?docName(d.url):(en?'No saved file':'Kayıtlı dosya yok')))%>;node.textContent=originals[i]||''});toggleEdit(false)});
 description?.addEventListener('input',fitDescription);
 document.querySelector('[data-product-usage-toggle]')?.addEventListener('click',event=>{const list=document.querySelector('[data-product-usage-list]');if(!list)return;list.hidden=!list.hidden;event.currentTarget.setAttribute('aria-expanded',String(!list.hidden))});
 const priceForm=document.querySelector('[data-product-price-adjust]'),priceStatus=document.querySelector('[data-product-price-status]');
 const updatePrice=async payload=>{if(!priceForm)return;const buttons=[...priceForm.querySelectorAll('button')];buttons.forEach(button=>button.disabled=true);if(priceStatus)priceStatus.textContent='<%=en?'Updating…':'Güncelleniyor…'%>';try{const body=new URLSearchParams(payload);body.set('_csrf','<%=csrfToken%>');const response=await fetch('/products/<%=row.id%>/price-adjust',{method:'POST',body,headers:{Accept:'application/json','X-CSRF-Token':'<%=csrfToken%>','Content-Type':'application/x-www-form-urlencoded'},credentials:'same-origin'}),data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.message||'<%=en?'Price could not be updated.':'Fiyat güncellenemedi.'%>');toast('<%=en?'Price updated successfully.':'Fiyat başarıyla güncellendi.'%>');setTimeout(()=>location.reload(),350)}catch(error){buttons.forEach(button=>button.disabled=false);if(priceStatus)priceStatus.textContent=error.message;toast(error.message,true)}};
 priceForm?.addEventListener('submit',event=>{event.preventDefault();updatePrice({action:'ADJUST',mode:priceForm.elements.mode.value,value:priceForm.elements.value.value,direction:event.submitter?.value||'INCREASE'})});
 document.querySelector('[data-product-price-revert]')?.addEventListener('click',()=>{if(confirm('<%=en?'Return to the previous sale price?':'Bir önceki satış fiyatına dönülsün mü?'%>'))updatePrice({action:'REVERT'})});
 const imageBox=document.querySelector('[data-product-image-box]');
 const imageEmpty=()=>imageBox?.querySelector('[data-product-image-empty]');
 const markImageMissing=()=>{if(!imageBox)return;const img=imageBox.querySelector('[data-product-display-image]');if(img){img.hidden=true;img.removeAttribute('src')}const empty=imageEmpty();if(empty){empty.hidden=false;const small=empty.querySelector('small');if(small)small.textContent='<%=en?'Image unavailable — upload again':'Görsel bulunamadı — yeniden yükle'%>'}const label=document.querySelector('[data-product-image-upload] span');if(label)label.textContent='<%=en?'Add Image':'Görsel Ekle'%>'};
 const bindImageGuard=img=>{if(!img)return;const fail=()=>{const fallback=String(img.dataset.productImageFallback||'').trim();if(fallback&&img.dataset.productFallbackTried!=='1'){img.dataset.productFallbackTried='1';img.src=fallback;return}markImageMissing()};img.addEventListener('error',fail);if(img.complete&&!img.naturalWidth)fail()};
 bindImageGuard(imageBox?.querySelector('[data-product-display-image]'));
 const setPreviewImage=url=>{if(!imageBox||!url)return;imageBox.querySelector('[data-product-display-image]')?.remove();const empty=imageEmpty();if(empty)empty.hidden=true;const img=document.createElement('img');img.dataset.productDisplayImage='';img.alt=<%-JSON.stringify(row.name||'')%>;img.src=url;bindImageGuard(img);imageBox.insertBefore(img,imageBox.querySelector('[data-product-image-upload]')||imageBox.firstChild)};
 const quickImageButton=document.querySelector('[data-product-image-upload]'),quickImageInput=document.querySelector('[data-product-image-quick-input]');quickImageButton?.addEventListener('click',()=>quickImageInput?.click());quickImageInput?.addEventListener('change',async event=>{const file=event.target.files?.[0];if(!file)return;const label=quickImageButton?.querySelector('span'),before=label?.textContent||'';quickImageButton.disabled=true;if(label)label.textContent='<%=en?'Uploading…':'Yükleniyor…'%>';try{const fd=new FormData();fd.append('_csrf','<%=csrfToken%>');fd.append('image',file);const response=await fetch('/products/<%=row.id%>/image',{method:'POST',body:fd,headers:{Accept:'application/json','X-CSRF-Token':'<%=csrfToken%>'},credentials:'same-origin'}),data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.message||'<%=en?'Image could not be uploaded.':'Görsel yüklenemedi.'%>');setPreviewImage(data.image_url||URL.createObjectURL(file));if(label)label.textContent='<%=en?'Change Image':'Görseli Değiştir'%>';toast('<%=en?'Product image saved.':'Ürün görseli kaydedildi.'%>')}catch(error){if(label)label.textContent=before;toast(error.message,true)}finally{quickImageButton.disabled=false;event.target.value=''}});
 document.querySelectorAll('[data-document-file-input]').forEach(input=>input.addEventListener('change',()=>{const row=input.closest('.product-document-edit-row-v133'),name=row?.querySelector('[data-document-selected-name]'),remove=row?.querySelector('[data-document-remove]');if(input.files?.[0]){if(name)name.textContent=input.files[0].name;if(remove){remove.checked=false;remove.disabled=false}}}));
 document.querySelectorAll('[data-document-remove]').forEach(input=>input.addEventListener('change',()=>{if(input.checked){const file=input.closest('.product-document-edit-row-v133')?.querySelector('[data-document-file-input]');if(file)file.value=''}}));
 form?.addEventListener('submit',async event=>{event.preventDefault();const save=document.querySelector('[data-product-edit-action][type="submit"]');if(save)save.disabled=true;toast('<%=en?'Saving changes…':'Değişiklikler kaydediliyor…'%>');try{const response=await fetch('/products/save',{method:'POST',body:new FormData(form),headers:{Accept:'application/json','X-CSRF-Token':'<%=csrfToken%>'},credentials:'same-origin'}),data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.message||'<%=en?'Product could not be saved.':'Ürün kaydedilemedi.'%>');toast('<%=en?'Product updated successfully.':'Ürün başarıyla güncellendi.'%>');setTimeout(()=>location.reload(),400)}catch(error){if(save)save.disabled=false;toast(error.message,true)}});
 document.querySelector('[data-product-preview-delete]')?.addEventListener('click',async event=>{if(!confirm('<%=en?'Archive this product?':'Bu ürün silinerek arşivlensin mi?'%>'))return;const button=event.currentTarget;button.disabled=true;try{const response=await fetch('/products/preview-archive/<%=row.id%>',{method:'POST',headers:{Accept:'application/json','X-CSRF-Token':'<%=csrfToken%>','Content-Type':'application/x-www-form-urlencoded'},body:'_csrf='+encodeURIComponent('<%=csrfToken%>'),credentials:'same-origin'}),data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.message||'İşlem başarısız.');toast(data.message||'<%=en?'Product archived.':'Ürün arşivlendi.'%>');setTimeout(()=>{if(window.parent&&window.parent!==window)window.parent.location.reload();else location.href='/products'},650)}catch(error){button.disabled=false;toast(error.message,true)}});
 const panel=document.querySelector('[data-document-panel]'),frame=document.querySelector('[data-document-frame]'),title=document.querySelector('[data-document-panel-title]');document.querySelectorAll('[data-document-preview]').forEach(button=>button.addEventListener('click',()=>{if(!panel||!frame)return;title.textContent=button.dataset.documentTitle||'';frame.src=button.dataset.documentPreview;panel.hidden=false;panel.scrollIntoView({behavior:'smooth',block:'start'})}));document.querySelector('[data-document-close]')?.addEventListener('click',()=>{panel.hidden=true;if(frame)frame.src='about:blank'});
})();
</script>
<script nonce="<%=typeof cspNonce!=='undefined'?cspNonce:''%>" src="<%=(typeof assetBundle!=='undefined'&&assetBundle?.js)||'/public/js/app.js'%>"></script>
</body>
